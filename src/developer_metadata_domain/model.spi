open predicate_lex.model

inl different (a : string) (b : string) : bool = if (=.) a b then false else true

// Cargo supplies JSON. Skip uninterpreted values as balanced token spans, then
// validate the types of every field that grants permission to build the CLI.
let rec composite_end (text : string) (cursor : i32) (depth : i32) : i32 =
    inl _, after, part, ok = token text cursor
    if (=.) ok false || (=.) part "" then -2i32
    elif (=.) part "{" || (=.) part "[" then composite_end text after ((+.) depth 1i32)
    elif (=.) part "}" || (=.) part "]" then
        if (=.) depth 1i32 then after else composite_end text after ((-.) depth 1i32)
    else composite_end text after depth
let rec scalar_end (text : string) (cursor : i32) : i32 =
    inl first, after, part, ok = token text cursor
    if (=.) ok false then -2i32
    elif (=.) part "" || (=.) part "," || (=.) part "}" || (=.) part "]" then first
    else scalar_end text after
inl value_end (text : string) (cursor : i32) : i32 =
    inl _, after, part, ok = token text cursor
    if (=.) ok false || (=.) part "" then -2i32
    elif (=.) part "{" || (=.) part "[" then composite_end text after 1i32
    else scalar_end text after
let rec fields (text : string) (cursor : i32) (key : string) : i32 =
    inl first, after, part, ok = token text cursor
    if (=.) ok false then -2i32
    elif (=.) part "}" then -1i32
    else
        inl name, _, string_ok = literal text first
        inl _, colon_end, colon, colon_ok = token text after
        if (=.) string_ok false || (=.) colon_ok false || different colon ":" then -2i32
        elif (=.) name key then skip text colon_end
        else
            inl end_value = value_end text colon_end
            if (<) end_value 0i32 then -2i32
            else
                inl _, next, separator, ok = token text end_value
                if (=.) ok false then -2i32
                elif (=.) separator "}" then -1i32
                elif (=.) separator "," then fields text next key
                else -2i32
inl field (text : string) (cursor : i32) (key : string) : i32 =
    if (<) cursor 0i32 then -2i32
    else
        inl _, after, part, ok = token text cursor
        if ok && (=.) part "{" then fields text after key else -2i32
let rec members (text : string) (cursor : i32) (wanted : string) : i32 =
    inl first, after, part, ok = token text cursor
    if (=.) ok false then -1i32
    elif (=.) part "]" then 0i32
    elif (=.) part "," then members text after wanted
    else
        inl value, end_string, valid = literal text first
        if (=.) valid false then -1i32
        elif (=.) value wanted then 1i32
        else members text end_string wanted

inl requirement (text : string) (package_at : i32) : i32 =
    inl metadata = field text package_at "metadata"
    inl eoie = field text metadata "eoie"
    if (<) eoie 0i32 then 0i32
    else
        inl _, _, part, ok = token text eoie
        if ok && (=.) part "null" then 0i32
        elif (=.) ok false || different part "{" then -3i32
        else
            inl required = field text eoie "test-requires-cli"
            if (=.) required -1i32 then 0i32
            elif (<) required 0i32 then -3i32
            else
                inl _, _, flag, valid = token text required
                if valid && (=.) flag "true" then 1i32
                elif valid && (=.) flag "false" then 0i32
                else -4i32

let rec packages (text : string) (cursor : i32) (members_at : i32) (wanted : string) (found : bool) (need_cli : i32) : i32 =
    inl first, after, part, ok = token text cursor
    if (=.) ok false then -5i32
    elif (=.) part "]" then if found then need_cli else -2i32
    elif (=.) part "," then packages text after members_at wanted found need_cli
    elif different part "{" then -5i32
    else
        inl end_package = value_end text first
        inl name_at = field text first "name"
        inl id_at = field text first "id"
        inl name, _, name_ok = literal text name_at
        inl id, _, id_ok = literal text id_at
        if (<) end_package 0i32 || (=.) name_ok false || (=.) id_ok false then -5i32
        elif (=.) name wanted then
            inl member = members text members_at id
            if (<) member 0i32 then -5i32
            elif (=.) member 1i32 then
                if found then -2i32
                else
                    inl requires = requirement text first
                    if (<) requires 0i32 then requires
                    else packages text end_package members_at wanted true requires
            else packages text end_package members_at wanted found need_cli
        else packages text end_package members_at wanted found need_cli

let rec selected (text : string) (names : string) (cursor : i32) (separator : char) (packages_at : i32) (members_at : i32) (need_cli : i32) : i32 =
    inl end_name = find_char names cursor separator
    inl wanted = cut names cursor end_name
    inl result = packages text packages_at members_at wanted false 0i32
    if (<) result 0i32 then result
    else
        inl next_need = if (=.) result 1i32 then 1i32 else need_cli
        if (=.) end_name (length names) then next_need
        else selected text names ((+.) end_name 1i32) separator packages_at members_at next_need

let inspect (text : string) (names : string) (separator : string) : i32 =
    inl package_at = field text 0i32 "packages"
    inl member_at = field text 0i32 "workspace_members"
    if (<) package_at 0i32 || (<) member_at 0i32 then -5i32
    else
        inl _, packages_after, package_kind, packages_ok = token text package_at
        inl _, members_after, member_kind, members_ok = token text member_at
        if packages_ok && members_ok && (=.) package_kind "[" && (=.) member_kind "[" then
            selected text names 0i32 (at separator 0i32) packages_after members_after 0i32
        else -5i32
