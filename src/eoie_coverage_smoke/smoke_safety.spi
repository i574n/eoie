inl rust_global (x : string) : () = !!!!Global(x)
inl emit_runtime () : () = rust_global "struct CoverageSmokeScratch(PathBuf);\nimpl CoverageSmokeScratch {\n    fn create(label: &str) -> Result<Self, String> {\n        let path = coverage_smoke_temp(label);\n        fs::create_dir(&path).map_err(|error| format!(\"create smoke scratch {}: {error}\", path.display()))?;\n        Ok(Self(path))\n    }\n}\nimpl Drop for CoverageSmokeScratch {\n    fn drop(&mut self) { let _ = fs::remove_dir_all(&self.0); }\n}\n\nfn coverage_smoke_check_release(binary: &Path, root: &Path, timeout_ms: u64) -> Result<(), String> {\n    let mut command = Command::new(binary);\n    command.current_dir(root).arg(\"bundle\").arg(\"check\").arg(root).arg(\"eoie\");\n    let observed = run_bounded_observed_with_input(&mut command, timeout_ms, None)?;\n    if !observed.status.success() {\n        return Err(format!(\"coverage smoke requires a valid strict EOIE release; bundle check failed: {}\", String::from_utf8_lossy(&observed.stderr)));\n    }\n    Ok(())\n}\n\npub fn coverage_smoke_preflight(binary: &Path, root: &Path, timeout_ms: u64) -> Result<(), String> {\n    coverage_smoke_check_release(binary, root, timeout_ms)?;\n    let grcov = env::var_os(\"EOIE_GRCOV\").map(PathBuf::from).ok_or_else(|| \"EOIE_GRCOV is required for coverage smoke\".to_owned())?;\n    let llvm = env::var_os(\"EOIE_LLVM_BIN\").map(PathBuf::from).ok_or_else(|| \"EOIE_LLVM_BIN is required for coverage smoke\".to_owned())?;\n    if !grcov.is_absolute() || !grcov.is_file() { return Err(\"EOIE_GRCOV must be an absolute executable file path\".to_owned()); }\n    if !llvm.is_absolute() || !llvm.is_dir() { return Err(\"EOIE_LLVM_BIN must be an absolute directory path\".to_owned()); }\n    for tool in [\"llvm-profdata\", \"llvm-cov\"] {\n        if !llvm.join(format!(\"{tool}{}\", env::consts::EXE_SUFFIX)).is_file() { return Err(format!(\"EOIE_LLVM_BIN is missing {tool}\")); }\n    }\n    Ok(())\n}\n\nfn coverage_smoke_regular_metadata(path: &Path) -> Result<fs::Metadata, String> {\n    let metadata = fs::symlink_metadata(path).map_err(|error| format!(\"smoke metadata {}: {error}\", path.display()))?;\n    let mut linked = metadata.file_type().is_symlink();\n    #[cfg(windows)] {\n        use std::os::windows::fs::MetadataExt;\n        linked |= metadata.file_attributes() & 0x400 != 0;\n    }\n    if linked || !(metadata.is_file() || metadata.is_dir()) { return Err(format!(\"smoke snapshot refuses links or special entries: {}\", path.display())); }\n    Ok(metadata)\n}\n\nfn coverage_smoke_copy_tree(source: &Path, destination: &Path, budget: &mut u64, entries: &mut usize, depth: usize) -> Result<(), String> {\n    if depth > 64 { return Err(\"smoke snapshot exceeds directory depth limit\".to_owned()); }\n    if !coverage_smoke_regular_metadata(source)?.is_dir() { return Err(\"smoke snapshot source must be a directory\".to_owned()); }\n    fs::create_dir(destination).map_err(|error| format!(\"create snapshot {}: {error}\", destination.display()))?;\n    for entry in fs::read_dir(source).map_err(|error| error.to_string())? {\n        let entry = entry.map_err(|error| error.to_string())?;\n        let name = entry.file_name();\n        if [\".git\", \".cache\", \"vendor\", \"target\"].iter().any(|skip| name == std::ffi::OsStr::new(skip)) { continue; }\n        *entries = entries.checked_sub(1).ok_or_else(|| \"smoke snapshot exceeds entry limit\".to_owned())?;\n        let path = entry.path();\n        let metadata = coverage_smoke_regular_metadata(&path)?;\n        let output = destination.join(name);\n        if metadata.is_dir() { coverage_smoke_copy_tree(&path, &output, budget, entries, depth + 1)?; }\n        else {\n            let size = metadata.len();\n            if size > *budget { return Err(\"smoke snapshot exceeds byte limit\".to_owned()); }\n            use std::io::{Read, Write};\n            let mut input = fs::File::open(&path).map_err(|error| error.to_string())?.take(size + 1);\n            let mut copied = fs::OpenOptions::new().write(true).create_new(true).open(&output).map_err(|error| error.to_string())?;\n            let count = std::io::copy(&mut input, &mut copied).map_err(|error| error.to_string())?;\n            if count != size { return Err(format!(\"smoke snapshot source changed during copy: {}\", path.display())); }\n            copied.flush().map_err(|error| error.to_string())?;\n            fs::set_permissions(&output, metadata.permissions()).map_err(|error| error.to_string())?;\n            *budget -= count;\n        }\n    }\n    Ok(())\n}\n\nfn coverage_smoke_in_snapshot(context: &CoverageSmokeContext<'_>, run: impl FnOnce(&CoverageSmokeContext<'_>) -> Result<(), String>) -> Result<(), String> {\n    let scratch = CoverageSmokeScratch::create(\"snapshot\")?;\n    let root = scratch.0.join(\"release\");\n    coverage_smoke_copy_tree(context.root, &root, &mut (512 * 1024 * 1024), &mut 20000, 0)?;\n    let isolated = CoverageSmokeContext { root: &root, ..*context };\n    run(&isolated)\n}\n\n#[cfg(test)]\n#[path = \"smoke_safety_tests.rs\"]\nmod smoke_safety_tests;\n"
