nominal path_list = $'std::rc::Rc<Vec<std::rc::Rc<str>>>'

nominal pending_writes = $'std::rc::Rc<std::cell::RefCell<Vec<(std::rc::Rc<str>, std::rc::Rc<str>)>>>'

nominal text_read = $'Result<std::rc::Rc<str>, std::rc::Rc<str>>'

nominal replacement_outcome = $'std::rc::Rc<(std::rc::Rc<str>, u64, std::rc::Rc<str>)>'

inl argument (~index : i32) : string = $'std::rc::Rc::<str>::from(std::env::args().nth(!index as usize).unwrap_or_default())' : string
inl argument_count () : i32 = $'std::env::args().count() as i32' : i32
inl stdin_text () : string = $'{ let mut text = String::new(); let _ = std::io::Read::read_to_string(&mut std::io::stdin(), &mut text); std::rc::Rc::<str>::from(text) }' : string
inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()
inl column () : string = $'std::rc::Rc::<str>::from(char::from(31u8).to_string())' : string
inl directory_exists (~path : string) : bool = $'std::path::Path::new(&*!path).is_dir()' : bool

let target_paths (~root : string) (~target : string) : path_list =
    $'{ fn wildcard(mask: &str, name: &str) -> bool { let parts = mask.split(char::from(42u8)).collect::<Vec<_>>(); if parts.len() == 1 { return mask == name; } let mut rest = name; if \!rest.starts_with(parts[0]) { return false; } rest = &rest[parts[0].len()..]; for middle in &parts[1..parts.len() - 1] { match rest.find(middle) { Some(at) => rest = &rest[at + middle.len()..], None => return false } } rest.len() >= parts[parts.len() - 1].len() && rest.ends_with(parts[parts.len() - 1]) } fn joined(shown: &str, name: &str) -> String { if shown.is_empty() { name.to_owned() } else { format\!("{shown}/{name}") } } fn walk(base: &std::path::Path, shown: &str, segments: &[String], found: &mut Vec<String>) { let Some((head, rest)) = segments.split_first() else { if base.is_file() { found.push(shown.to_owned()); } return; }; let children = || std::fs::read_dir(base).map(|entries| entries.filter_map(|entry| entry.ok()).filter(|entry| entry.file_type().map(|kind| \!kind.is_symlink()).unwrap_or(false)).collect::<Vec<_>>()).unwrap_or_default(); if head == "**" { walk(base, shown, rest, found); for entry in children() { let name = entry.file_name().to_string_lossy().into_owned(); if entry.path().is_dir() && \![".git", "target", "node_modules"].contains(&name.as_str()) { walk(&entry.path(), &joined(shown, &name), segments, found); } } } else if head.contains(char::from(42u8)) { for entry in children() { let name = entry.file_name().to_string_lossy().into_owned(); if wildcard(head, &name) { walk(&entry.path(), &joined(shown, &name), rest, found); } } } else { walk(&base.join(head), &joined(shown, head), rest, found); } } let pattern = (&*!target).replace(char::from(92u8), "/"); let segments = pattern.split(char::from(47u8)).filter(|segment| \!segment.is_empty() && *segment \!= ".").map(str::to_owned).collect::<Vec<_>>(); let mut found = Vec::new(); if pattern.contains(char::from(42u8)) { walk(std::path::Path::new(&*!root), "", &segments, &mut found); found.sort(); found.dedup(); } else { found.push(segments.join("/")); } std::rc::Rc::new(found.into_iter().map(std::rc::Rc::<str>::from).collect::<Vec<_>>()) }' : path_list

inl path_count (~paths : path_list) : i32 = $'!paths.len() as i32' : i32
inl path_at (~paths : path_list) (~index : i32) : string = $'!paths[!index as usize].clone()' : string

inl pending_new () : pending_writes = $'std::rc::Rc::new(std::cell::RefCell::new(Vec::new()))' : pending_writes
inl pending_count (~pending : pending_writes) : u64 = $'!pending.borrow().len() as u64' : u64

let text_now (~pending : pending_writes) (~root : string) (~path : string) : text_read =
    $'{ let staged = !pending.borrow().iter().find(|entry| &*entry.0 == &*!path).map(|entry| entry.1.clone()); match staged { Some(text) => Ok(text), None => std::fs::read(std::path::Path::new(&*!root).join(&*!path)).map_err(|error| std::rc::Rc::<str>::from(format\!("unreadable: {error}"))).and_then(|bytes| String::from_utf8(bytes).map(std::rc::Rc::<str>::from).map_err(|_| std::rc::Rc::<str>::from("not UTF-8 text"))) } }' : text_read

inl read_ok (~read : text_read) : bool = $'!read.is_ok()' : bool
inl read_text (~read : text_read) : string = $'!read.clone().unwrap_or_default()' : string
inl read_error (~read : text_read) : string = $'!read.clone().err().unwrap_or_default()' : string

let staged (~pending : pending_writes) (~path : string) (~text : string) : () =
    $'{ let mut writes = !pending.borrow_mut(); match writes.iter_mut().find(|entry| &*entry.0 == &*!path) { Some(entry) => entry.1 = !text.clone(), None => writes.push((!path.clone(), !text.clone())) } }' : ()

let committed (~pending : pending_writes) (~root : string) : string =
    $'{ let writes = !pending.borrow(); let root = std::path::Path::new(&*!root); let mut temporaries = Vec::new(); let mut problem = String::new(); for (path, text) in writes.iter() { let target = root.join(&**path); let temporary = target.with_file_name(format\!(".{}.eoie-do.tmp", target.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default())); match std::fs::write(&temporary, text.as_bytes()) { Ok(()) => temporaries.push((temporary, target)), Err(error) => { problem = format\!("write {path}: {error}"); break; } } } if problem.is_empty() { for (temporary, target) in &temporaries { if let Err(error) = std::fs::rename(temporary, target) { problem = format\!("rename {}: {error}", target.display()); break; } } } else { for (temporary, _) in &temporaries { let _ = std::fs::remove_file(temporary); } } std::rc::Rc::<str>::from(problem) }' : string

let replaced_in (~text : string) (~anchor : string) (~replacement : string) : replacement_outcome =
    $'{ let text = &*!text; let crlf = text.contains("\r\n"); let adapt = |value: &str| if crlf && value.contains(char::from(10u8)) && \!value.contains("\r\n") { value.replace("\n", "\r\n") } else { value.to_owned() }; let anchor = adapt(&*!anchor); let replacement = adapt(&*!replacement); if anchor.is_empty() { return std::rc::Rc::new((std::rc::Rc::<str>::from(text), 0, std::rc::Rc::<str>::from(""))); } let starts = text.match_indices(anchor.as_str()).map(|(at, _)| at).collect::<Vec<_>>(); let lines = starts.iter().map(|at| (text[..*at].matches(char::from(10u8)).count() + 1).to_string()).collect::<Vec<_>>().join(","); std::rc::Rc::new((std::rc::Rc::<str>::from(text.replace(anchor.as_str(), replacement.as_str())), starts.len() as u64, std::rc::Rc::<str>::from(lines))) }' : replacement_outcome

inl outcome_text (~outcome : replacement_outcome) : string = $'!outcome.0.clone()' : string
inl outcome_count (~outcome : replacement_outcome) : u64 = $'!outcome.1' : u64
inl outcome_marks (~outcome : replacement_outcome) : string = $'!outcome.2.clone()' : string

let sites_of (~text : string) (~anchor : string) (~path : string) : string =
    $'{ let text = &*!text; let anchor = &*!anchor; let first = anchor.lines().next().unwrap_or(anchor); let sites = if anchor.is_empty() { Vec::new() } else { text.lines().enumerate().filter(|(_, line)| line.contains(first)).map(|(index, line)| format\!("{}:{}  {}", &*!path, index + 1, line)).collect::<Vec<_>>() }; std::rc::Rc::<str>::from(sites.join("\n")) }' : string

let sha256_of (~text : string) : string =
    $'{ use sha2::Digest; std::rc::Rc::<str>::from(sha2::Sha256::digest(!text.as_bytes()).iter().map(|byte| format\!("{byte:02x}")).collect::<String>()) }' : string

let quoted (~text : string) : string =
    $'{ let shown = format\!("{:?}", &*!text); std::rc::Rc::<str>::from(if shown.chars().count() > 80 { format\!("{}...{}", shown.chars().take(76).collect::<String>(), char::from(34u8)) } else { shown }) }' : string

let lines_label (~marks : string) : string =
    $'{ let mut lines = (&*!marks).split(char::from(44u8)).filter_map(|value| value.parse::<u64>().ok()).collect::<Vec<_>>(); lines.sort(); lines.dedup(); let mut ranges: Vec<(u64, u64)> = Vec::new(); for line in lines.iter().copied() { match ranges.last_mut() { Some(range) if range.1 + 1 == line => range.1 = line, _ => ranges.push((line, line)) } } let text = ranges.iter().map(|(first, last)| if first == last { first.to_string() } else { format\!("{first}-{last}") }).collect::<Vec<_>>().join(","); std::rc::Rc::<str>::from(if lines.len() == 1 { format\!("line {text}") } else { format\!("lines {text}") }) }' : string

let preview_of (~before : string) (~after : string) : string =
    $'{ let old = (&*!before).lines().collect::<Vec<_>>(); let new = (&*!after).lines().collect::<Vec<_>>(); let mut shown = Vec::new(); if old.len() == new.len() { for (index, (left, right)) in old.iter().zip(new.iter()).enumerate() { if left \!= right { shown.push(format\!("-{}  {}", index + 1, left)); shown.push(format\!("+{}  {}", index + 1, right)); } } } else { let prefix = old.iter().zip(new.iter()).take_while(|(left, right)| left == right).count(); let suffix = old[prefix..].iter().rev().zip(new[prefix..].iter().rev()).take_while(|(left, right)| left == right).count(); for index in prefix..old.len() - suffix { shown.push(format\!("-{}  {}", index + 1, old[index])); } for index in prefix..new.len() - suffix { shown.push(format\!("+{}  {}", index + 1, new[index])); } } std::rc::Rc::<str>::from(shown.join("\n")) }' : string

let shown_file (~pending : pending_writes) (~root : string) (~path : string) : string =
    $'{ let staged = !pending.borrow().iter().find(|entry| &*entry.0 == &*!path).map(|entry| entry.1.to_string()); let text = staged.or_else(|| std::fs::read(std::path::Path::new(&*!root).join(&*!path)).ok().map(|bytes| String::from_utf8_lossy(&bytes).into_owned())); std::rc::Rc::<str>::from(match text { Some(text) => { let lines = text.lines().collect::<Vec<_>>(); let width = lines.len().to_string().len(); let mut shown = vec\![(&*!path).to_owned()]; for (index, line) in lines.iter().enumerate() { shown.push(format\!("{:<width$}  {}", index + 1, line)); } shown.join("\n") } None => format\!("{} (unreadable)", &*!path) }) }' : string

let aligned (~report : string) : string =
    $'{ let separator = char::from(31u8); let rows = (&*!report).lines().collect::<Vec<_>>(); let mut widths: Vec<usize> = Vec::new(); for row in &rows { if row.contains(separator) { let cells = row.split(separator).collect::<Vec<_>>(); for (index, cell) in cells[..cells.len() - 1].iter().enumerate() { let length = cell.chars().count(); if widths.len() <= index { widths.push(length); } else if widths[index] < length { widths[index] = length; } } } } let shown = rows.iter().map(|row| if row.contains(separator) { let cells = row.split(separator).collect::<Vec<_>>(); let last = cells.len() - 1; cells.iter().enumerate().map(|(index, cell)| if index == last { cell.to_string() } else { format\!("{:<width$}  ", cell, width = widths[index]) }).collect::<String>() } else { row.to_string() }).collect::<Vec<_>>(); std::rc::Rc::<str>::from(shown.join("\n")) }' : string
