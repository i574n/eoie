nominal record_list = $'std::rc::Rc<Vec<Vec<std::rc::Rc<str>>>>'

let compiled_text (~text : string) : string = $'eoie_do_program::eoie_do_program_compiled(&*!text)' : string

let records_of (~encoded : string) : record_list =
    $'std::rc::Rc::new((&*!encoded).split(char::from(30u8)).map(|record| record.split(char::from(31u8)).map(std::rc::Rc::<str>::from).collect::<Vec<_>>()).collect::<Vec<_>>())' : record_list

let field_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).cloned().unwrap_or_default()' : string
inl has_query (~records : record_list) : bool = $'!records.iter().skip(1).any(|fields| fields.first().map(|kind| &**kind == "query").unwrap_or(false))' : bool
inl has_fact (~records : record_list) : bool = $'!records.iter().skip(1).any(|fields| fields.first().map(|kind| &**kind == "query").unwrap_or(false) && fields.get(1).map(|verb| ["hash", "env", "exists", "nearest", "json", "lines", "table", "dirs", "tag", "count", "diff"].contains(&&**verb) || (&**verb == "files" && fields.iter().any(|word| &**word == "wcount"))).unwrap_or(false))' : bool
inl has_run (~records : record_list) : bool = $'!records.iter().skip(1).any(|fields| fields.first().map(|kind| &**kind == "query").unwrap_or(false) && fields.get(1).map(|verb| ["run", "errors", "processes", "stop"].contains(&&**verb)).unwrap_or(false))' : bool
inl has_write (~records : record_list) : bool = $'!records.iter().skip(1).any(|fields| fields.first().map(|kind| &**kind == "query").unwrap_or(false) && fields.get(1).map(|verb| &**verb == "append" || &**verb == "copy").unwrap_or(false))' : bool
inl has_edit (~records : record_list) : bool = $'!records.iter().skip(1).any(|fields| fields.first().map(|kind| &**kind == "edit").unwrap_or(false))' : bool

union program_family =
    | Edits
    | Reads
    | Facts
    | Runs
    | Writes

union compiled_program =
    | CompileRejected : string
    | Delegated : program_family * string

let program_decoded (~text : string) : compiled_program =
    inl encoded = compiled_text text
    inl records = records_of encoded
    if field_at records 0i32 0i32 = "ok" then
        if has_run records then Delegated ((if has_edit records then Edits else Runs), encoded)
        elif has_write records then Delegated (Writes, encoded)
        elif has_fact records then Delegated (Facts, encoded)
        elif has_query records then Delegated (Reads, encoded) else Delegated (Edits, encoded)
    else CompileRejected (field_at records 1i32 0i32)
