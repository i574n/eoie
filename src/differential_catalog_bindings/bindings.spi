let differential_catalog_equal_binding (expected : i32) (observed : i32) : i32 =
    if expected = observed then 1i32 else 0i32

inl differential_catalog_shape_binding (gate_mask : i32) (gate_count : i32) : i32 =
    if gate_mask = 15i32 then
        if gate_count = 4i32 then 1i32 else 0i32
    else 0i32

inl differential_catalog_settlement_binding (scenarios : i32) (receipts : i32) (evidence_flags : i32) : i32 =
    if scenarios = 10i32 then
        if receipts = 9i32 then
            if evidence_flags = 31i32 then 1i32 else 0i32
        else 0i32
    else 0i32

inl differential_catalog_legacy_binding (cataloged : i32) (decided : i32) (complete : i32) : i32 =
    if cataloged = 36i32 then
        if decided = 36i32 then
            if complete = 1i32 then 1i32 else 0i32
        else 0i32
    else 0i32
