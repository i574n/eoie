inl rust_global (x : string) : () = !!!!Global(x)

inl emit_tests () : () =
    rust_global """
fn rollback_contract_fnv1a(bytes: &[u8]) -> u64 { bytes.iter().fold(0xcbf29ce484222325u64, |hash, byte| (hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3)) }

#[test]
fn partial_rollback_matches_restored_oracle_and_receipt() {
    let root = prepared("rollback-differential");
    let a = root.join("a.txt");
    let b = root.join("b.txt");
    let oracle = root.join("oracle-a.txt");
    fs::write(&a, "one").expect("a");
    fs::write(&b, "two").expect("b");
    fs::write(&oracle, "one").expect("oracle");
    let source = format!("{}{}", plan("a.txt", "one", "changed-a"), plan("b.txt", "two", "changed-b"));
    let error = gated_with_corruption(&root, &source, 2, "b.txt").expect_err("fault");
    assert!(error.contains("rollback=failed"));
    let oracle_bytes = fs::read(&oracle).expect("oracle bytes");
    let restored_bytes = fs::read(&a).expect("restored bytes");
    assert_eq!(restored_bytes, oracle_bytes);
    assert!(b.is_dir());
    let hash = rollback_contract_fnv1a(&oracle_bytes);
    let receipt = format!("route=partial-rollback-byte-exact\nfnv1a={hash:016x}\nbytes={}\nrestored=1\nfailed=1\n", oracle_bytes.len());
    fs::write(root.join("partial-rollback.receipt"), &receipt).expect("receipt");
    assert!(receipt.contains("bytes=3"));
    no_stage(&root);
    fs::remove_dir_all(root).expect("cleanup");
}

#[test]
fn three_promotion_rollback_restores_two_and_records_one_failure() {
    let root = prepared("rollback-three-promotions");
    let a = root.join("a.txt"); let b = root.join("b.txt"); let c = root.join("c.txt");
    let oracle_a = root.join("oracle-a.txt"); let oracle_b = root.join("oracle-b.txt");
    fs::write(&a, "one").expect("a"); fs::write(&b, "two").expect("b"); fs::write(&c, "three").expect("c");
    fs::write(&oracle_a, "one").expect("oracle a"); fs::write(&oracle_b, "two").expect("oracle b");
    let source = format!("{}{}{}", plan("a.txt", "one", "changed-a"), plan("b.txt", "two", "changed-b"), plan("c.txt", "three", "changed-c"));
    let error = gated_with_corruption(&root, &source, 3, "c.txt").expect_err("fault");
    assert!(error.contains("rollback=failed"));
    let a_bytes = fs::read(&a).expect("a restored"); let b_bytes = fs::read(&b).expect("b restored");
    assert_eq!(a_bytes, fs::read(&oracle_a).expect("oracle a bytes")); assert_eq!(b_bytes, fs::read(&oracle_b).expect("oracle b bytes")); assert!(c.is_dir());
    let mut restored = a_bytes.clone(); restored.extend_from_slice(&b_bytes); let hash = rollback_contract_fnv1a(&restored);
    let receipt = format!("route=three-promotion-partial-rollback-byte-exact\nfnv1a={hash:016x}\nbytes={}\nrestored=2\nfailed=1\n", restored.len());
    fs::write(root.join("three-promotion-rollback.receipt"), &receipt).expect("receipt");
    assert!(receipt.contains("restored=2")); assert!(receipt.contains("failed=1"));
    no_stage(&root); fs::remove_dir_all(root).expect("cleanup");
}

#[test]
fn postgate_failure_after_all_promotions_restores_every_file() {
    let root = prepared("postgate-after-promotions");
    let a = root.join("a.txt"); let b = root.join("b.txt");
    fs::write(&a, "one").expect("a"); fs::write(&b, "two").expect("b");
    let source = format!("{}{}", plan("a.txt", "one", "changed-a"), plan("b.txt", "two", "changed-b"));
    let error = gated(&root, &source, 2, false).expect_err("postgate fault");
    assert!(error.contains("patch executable postgate rejected"));
    assert!(error.contains("rollback=restored"));
    assert_eq!(fs::read_to_string(&a).expect("a restored"), "one");
    assert_eq!(fs::read_to_string(&b).expect("b restored"), "two");
    no_stage(&root); fs::remove_dir_all(root).expect("cleanup");
}

#[test]
fn executable_gate_success_commits_every_file() {
    let root = prepared("executable-gate-success");
    let a = root.join("a.txt"); let b = root.join("b.txt");
    fs::write(&a, "one").expect("a"); fs::write(&b, "two").expect("b");
    let source = format!("{}{}", plan("a.txt", "one", "changed-a"), plan("b.txt", "two", "changed-b"));
    gated(&root, &source, 2, true).expect("gate pass");
    assert_eq!(fs::read_to_string(&a).expect("a committed"), "changed-a");
    assert_eq!(fs::read_to_string(&b).expect("b committed"), "changed-b");
    no_stage(&root); fs::remove_dir_all(root).expect("cleanup");
}

#[test]
fn executable_gate_failure_restores_every_file() {
    let root = prepared("executable-gate-failure");
    let a = root.join("a.txt"); let b = root.join("b.txt");
    fs::write(&a, "one").expect("a"); fs::write(&b, "two").expect("b");
    let source = format!("{}{}", plan("a.txt", "one", "changed-a"), plan("b.txt", "two", "changed-b"));
    let error = gated(&root, &source, 2, false).expect_err("gate reject");
    assert!(error.contains("patch executable postgate rejected"));
    assert!(error.contains("rollback=restored"));
    assert_eq!(fs::read_to_string(&a).expect("a restored"), "one");
    assert_eq!(fs::read_to_string(&b).expect("b restored"), "two");
    no_stage(&root); fs::remove_dir_all(root).expect("cleanup");
}"""
