open model

let fs_action_shape_binding (row_count : i32) (problem_count : i32) : i32 =
    if row_count < 1i32 then 0i32
    elif problem_count < 0i32 then 0i32
    elif 0i32 < problem_count then 0i32
    else 1i32

let fs_action_freshness_binding (kind_code : i32) (expected_ok : i32) : i32 =
    if kind_code < 0i32 then 0i32
    elif 3i32 < kind_code then 0i32
    elif expected_ok < 1i32 then 0i32
    else 1i32

let fs_action_apply_binding (row_count : i32) (applied_count : i32) : i32 =
    if row_count < 1i32 then 0i32
    elif applied_count < row_count then 0i32
    elif row_count < applied_count then 0i32
    else 1i32

let fs_action_verify_binding (row_count : i32) (verified_count : i32) : i32 =
    if row_count < 1i32 then 0i32
    elif verified_count < row_count then 0i32
    elif row_count < verified_count then 0i32
    else 1i32

let fs_action_rollback_binding (row_count : i32) (restored_count : i32) : i32 =
    if row_count < 1i32 then 0i32
    elif restored_count < row_count then 0i32
    elif row_count < restored_count then 0i32
    else 1i32
