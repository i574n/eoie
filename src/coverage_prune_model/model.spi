nominal coverage_idle = ()
let coverage_jobs_binding (requested : i32) (available : i32) : i32 =
    if requested = 0i32 then
        if available < 2i32 then 1i32 else 2i32
    elif requested < 1i32 || 256i32 < requested then -1i32
    else requested

nominal coverage_profiles_loaded = ()
nominal coverage_assessed = ()
nominal prune_candidate_verified = ()
nominal prune_staged = ()
nominal prune_committed = ()

union coverage_op from to =
    | LoadCoverageProfiles :: coverage_op coverage_idle coverage_profiles_loaded
    | AssessCoverageFloors :: coverage_op coverage_profiles_loaded coverage_assessed
    | VerifyPruneCandidate :: coverage_op coverage_idle prune_candidate_verified
    | StagePruneCandidate :: coverage_op prune_candidate_verified prune_staged
    | CommitPruneReceipt :: coverage_op prune_staged prune_committed

union rec coverage_plan from to =
    | CoverageStep :: forall from to. coverage_op from to -> coverage_plan from to
    | CoverageThen :: forall from to. (exists middle. coverage_plan from middle * coverage_plan middle to) -> coverage_plan from to

inl assess_plan () : coverage_plan coverage_idle coverage_assessed =
    CoverageThen (exists (
        CoverageStep LoadCoverageProfiles,
        CoverageStep AssessCoverageFloors
    ))

inl prune_plan () : coverage_plan coverage_idle prune_committed =
    CoverageThen (exists (
        CoverageStep VerifyPruneCandidate,
        CoverageThen (exists (
            CoverageStep StagePruneCandidate,
            CoverageStep CommitPruneReceipt
        ))
    ))

nominal coverage_run_idle = ()
nominal coverage_run_configured = ()
nominal coverage_binary_instrumented = ()
nominal coverage_contracts_executed = ()
nominal coverage_profiles_emitted = ()

union coverage_contract_scope =
    | PublicContracts :: coverage_contract_scope
    | WorkspaceContracts :: coverage_contract_scope
    | SmokePublic :: coverage_contract_scope

union coverage_run_op from to =
    | ConfigureCoverageRun :: coverage_contract_scope -> coverage_run_op coverage_run_idle coverage_run_configured
    | BuildInstrumentedBinary :: coverage_run_op coverage_run_configured coverage_binary_instrumented
    | ExecuteInstrumentedContracts :: coverage_run_op coverage_binary_instrumented coverage_contracts_executed
    | EmitCoverageProfiles :: coverage_run_op coverage_contracts_executed coverage_profiles_emitted

union rec coverage_run_plan from to =
    | CoverageRunStep :: forall from to. coverage_run_op from to -> coverage_run_plan from to
    | CoverageRunThen :: forall from to. (exists middle. coverage_run_plan from middle * coverage_run_plan middle to) -> coverage_run_plan from to

inl instrumented_workspace_plan () : coverage_run_plan coverage_run_idle coverage_profiles_emitted =
    CoverageRunThen (exists (
        CoverageRunStep (ConfigureCoverageRun WorkspaceContracts),
        CoverageRunThen (exists (
            CoverageRunStep BuildInstrumentedBinary,
            CoverageRunThen (exists (
                CoverageRunStep ExecuteInstrumentedContracts,
                CoverageRunStep EmitCoverageProfiles
            ))
        ))
    ))
