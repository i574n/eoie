open model

let binary_install_shape_binding (path_count_ok : i32) (distinct_paths : i32) : i32 =
    if path_count_ok < 1i32 then 0i32
    elif distinct_paths < 1i32 then 0i32
    else 1i32

let binary_install_source_binding (expected_match : i32) (source_state : i32) : i32 =
    if expected_match < 1i32 then 0i32
    elif source_state < 3i32 then 0i32
    elif 3i32 < source_state then 0i32
    else 1i32

let binary_install_freshness_binding (expected_code : i32) (observed_code : i32) : i32 =
    if expected_code < 0i32 then 0i32
    elif observed_code < 0i32 then 0i32
    elif 1i32 < expected_code then 0i32
    elif 1i32 < observed_code then 0i32
    elif expected_code < observed_code then 0i32
    elif observed_code < expected_code then 0i32
    else 1i32

let binary_install_running_destination_binding (same_as_current : i32) (guard_enabled : i32) : i32 =
    if guard_enabled < 1i32 then 0i32
    elif same_as_current < 0i32 then 0i32
    elif 0i32 < same_as_current then 0i32
    else 1i32

let binary_install_permission_binding (mode_valid : i32) (executable : i32) : i32 =
    if mode_valid < 1i32 then 0i32
    elif executable < 1i32 then 0i32
    else 1i32

let binary_install_mode_binding (mode_code : i32) (effect_mask : i32) : i32 =
    if mode_code < 0i32 then 0i32
    elif 1i32 < mode_code then 0i32
    elif effect_mask < 0i32 then 0i32
    elif mode_code < 1i32 then
        if effect_mask < 1i32 then 1i32 else 0i32
    else
        if effect_mask < 7i32 then 0i32
        elif 7i32 < effect_mask then 0i32
        else 1i32

let binary_install_commit_binding (payload_hash_ok : i32) (evidence_mask : i32) : i32 =
    if payload_hash_ok < 1i32 then 0i32
    elif evidence_mask < 7i32 then 0i32
    elif 7i32 < evidence_mask then 0i32
    else 1i32
