nominal record_list = $'std::rc::Rc<Vec<Vec<std::rc::Rc<str>>>>'

nominal fact_outcome = $'std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)>'

let records_of (~encoded : string) : record_list =
    $'std::rc::Rc::new((&*!encoded).split(char::from(30u8)).map(|record| record.split(char::from(31u8)).map(std::rc::Rc::<str>::from).collect::<Vec<_>>()).collect::<Vec<_>>())' : record_list

inl record_count (~records : record_list) : i32 = $'!records.len() as i32' : i32
let field_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).cloned().unwrap_or_default()' : string
inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()

let field_index (~records : record_list) (~record : i32) (~word : string) : i32 =
    $'!records.get(!record as usize).and_then(|fields| fields.iter().position(|field| field.len() > 1 && field.starts_with(char::from(119u8)) && &field[1..] == &*!word)).map(|index| index as i32).unwrap_or(-1)' : i32

let body_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).filter(|field| \!field.is_empty()).map(|field| std::rc::Rc::<str>::from(&field[1..])).unwrap_or_default()' : string

let first_of_kind (~records : record_list) (~record : i32) (~kind : u8) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.iter().skip(2).find(|field| field.as_bytes().first() == Some(&!kind)).map(|field| std::rc::Rc::<str>::from(&field[1..]))).unwrap_or_default()' : string

let items_span (~records : record_list) (~record : i32) (~from : i32) (~until : i32) : string =
    $'{ let fields = !records.get(!record as usize).cloned().unwrap_or_default(); let until = if !until < 0 { fields.len() } else { (!until as usize).min(fields.len()) }; let mut items = Vec::new(); for raw in fields.iter().take(until).skip(!from as usize) { if raw.is_empty() { continue; } let (kind, body) = raw.split_at(1); if kind == "q" { items.push(body.to_owned()); } else { items.extend(body.split(|c: char| c == char::from(44u8) || c.is_whitespace()).filter(|item| \!item.is_empty()).map(str::to_owned)); } } std::rc::Rc::<str>::from(items.join("\n")) }' : string

let expanded (~root : string) (~items : string) : string =
    $'std::rc::Rc::<str>::from((&*!items).lines().filter(|item| \!item.is_empty()).flat_map(|item| eoie_do_read::eoie_do_read_matching(&*!root, item).lines().map(str::to_owned).collect::<Vec<_>>()).collect::<Vec<_>>().join("\n"))' : string

inl outcome_report (~outcome : fact_outcome) : string = $'!outcome.0.clone()' : string
inl outcome_counter (~outcome : fact_outcome) (~index : u64) : u64 = $'!outcome.1[!index as usize]' : u64
inl outcome_failed (~outcome : fact_outcome) : bool = $'!outcome.2' : bool

let hashed (~root : string) (~paths : string) : fact_outcome =
    $'{ use sha2::Digest; let root = std::path::Path::new(&*!root); let rows = (&*!paths).lines().filter(|path| \!path.is_empty()).map(|path| (path.to_owned(), std::fs::read(root.join(path)).ok().map(|bytes| (bytes.len() as u64, sha2::Sha256::digest(&bytes).iter().map(|byte| format\!("{byte:02x}")).collect::<String>())))).collect::<Vec<_>>(); let path_width = rows.iter().map(|row| row.0.len()).max().unwrap_or(0).max(4); let bytes_width = rows.iter().map(|row| row.1.as_ref().map(|found| found.0.to_string().len()).unwrap_or(1)).max().unwrap_or(0).max(5); let mut shown = vec\![format\!("{:<path_width$}  {:<bytes_width$}  {}", "file", "bytes", "sha256")]; let mut failed = rows.is_empty(); let mut total = 0u64; let mut groups: Vec<(String, Vec<String>)> = Vec::new(); for (path, found) in &rows { match found { Some((bytes, digest)) => { total += bytes; shown.push(format\!("{:<path_width$}  {:<bytes_width$}  {}", path, bytes, digest)); match groups.iter_mut().find(|group| &group.0 == digest) { Some(group) => group.1.push(path.clone()), None => groups.push((digest.clone(), vec\![path.clone()])) } } None => { failed = true; shown.push(format\!("{:<path_width$}  {:<bytes_width$}  unreadable", path, "-")); } } } for group in groups.iter().filter(|group| group.1.len() > 1) { shown.push(format\!("equal  {}", group.1.join(" = "))); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [rows.len() as u64, total, groups.len() as u64, 0], failed)) }' : fact_outcome

let environment (~names : string) : fact_outcome =
    $'{ let names = (&*!names).lines().filter(|name| \!name.is_empty()).map(str::to_owned).collect::<Vec<_>>(); let width = names.iter().map(String::len).max().unwrap_or(0); let mut set = 0u64; let shown = names.iter().map(|name| match std::env::var(name) { Ok(value) => { set += 1; format\!("{:<width$}  {:?}", name, value) } Err(_) => format\!("{:<width$}  unset", name) }).collect::<Vec<_>>(); std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [names.len() as u64, set, 0, 0], false)) }' : fact_outcome

let existence (~root : string) (~paths : string) : fact_outcome =
    $'{ let root = std::path::Path::new(&*!root); let paths = (&*!paths).lines().filter(|path| \!path.is_empty()).map(str::to_owned).collect::<Vec<_>>(); let width = paths.iter().map(String::len).max().unwrap_or(0); let mut present = 0u64; let shown = paths.iter().map(|path| { let full = root.join(path); match std::fs::metadata(&full) { Ok(metadata) if metadata.is_dir() => { present += 1; let entries = std::fs::read_dir(&full).map(|entries| entries.count()).unwrap_or(0); format\!("{:<width$}  directory  {} {}", path, entries, if entries == 1 { "entry" } else { "entries" }) } Ok(metadata) => { present += 1; format\!("{:<width$}  file  {} bytes", path, metadata.len()) } Err(_) => format\!("{:<width$}  missing", path) } }).collect::<Vec<_>>(); std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [paths.len() as u64, present, 0, 0], false)) }' : fact_outcome

let nearest_marker (~root : string) (~path : string) (~pattern : string) (~targets : string) : fact_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let pattern = match regex::Regex::new(&*!pattern) { Ok(pattern) => pattern, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("nearest: invalid pattern: {error}")), [1, 0, 0, 0], true)) }; let path = &*!path; let text = match std::fs::read(std::path::Path::new(&*!root).join(path)) { Ok(bytes) => String::from_utf8_lossy(&bytes).into_owned(), Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  unreadable: {error}")), [1, 0, 0, 0], true)) }; let lines = text.lines().collect::<Vec<_>>(); let targets = (&*!targets).lines().filter_map(|target| target.trim().parse::<usize>().ok()).collect::<Vec<_>>(); let rows = targets.iter().map(|target| { let found = (0..(*target).min(lines.len())).rev().find(|index| pattern.is_match(lines[*index])); (target.to_string(), found.map(|index| (index + 1).to_string()).unwrap_or_else(|| "-".to_owned()), found.map(|index| lines[index].to_owned()).unwrap_or_else(|| "(none above)".to_owned())) }).collect::<Vec<_>>(); let line_width = rows.iter().map(|row| row.0.len()).max().unwrap_or(0).max(4); let nearest_width = rows.iter().map(|row| row.1.len()).max().unwrap_or(0).max(7); let mut shown = vec\![format\!("{:<line_width$}  {:<nearest_width$}  {}", "line", "nearest", "text")]; for row in &rows { shown.push(format\!("{:<line_width$}  {:<nearest_width$}  {}", row.0, row.1, row.2)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [1, rows.len() as u64, 0, 0], false)) })()' : fact_outcome

let json_fields (~root : string) (~path : string) (~fields : string) : fact_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let path = &*!path; let text = match std::fs::read_to_string(std::path::Path::new(&*!root).join(path)) { Ok(text) => text, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  unreadable: {error}")), [1, 0, 0, 0], true)) }; let value: serde_json::Value = match serde_json::from_str(&text) { Ok(value) => value, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  invalid json: {error}")), [1, 0, 0, 0], true)) }; let fields = (&*!fields).lines().filter(|field| \!field.is_empty()).map(str::to_owned).collect::<Vec<_>>(); let width = fields.iter().map(String::len).max().unwrap_or(0); let mut failed = false; let shown = fields.iter().map(|field| { let segments = field.split(char::from(46u8)).collect::<Vec<_>>(); let wants_length = segments.len() > 1 && segments.last() == Some(&"length"); let walk = if wants_length { &segments[..segments.len() - 1] } else { &segments[..] }; let found = walk.iter().try_fold(&value, |current, segment| match current { serde_json::Value::Array(items) => segment.parse::<usize>().ok().and_then(|index| items.get(index)), other => other.get(*segment) }); let shown = match found { None => { failed = true; "missing".to_owned() } Some(found) if wants_length => match found { serde_json::Value::Array(items) => items.len().to_string(), serde_json::Value::Object(entries) => entries.len().to_string(), serde_json::Value::String(text) => text.chars().count().to_string(), _ => { failed = true; "no length".to_owned() } }, Some(found) => found.to_string() }; format\!("{:<width$}  {}", field, shown) }).collect::<Vec<_>>(); std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [1, fields.len() as u64, 0, 0], failed)) })()' : fact_outcome

let lines_grouped (~root : string) (~path : string) (~pattern : string) : fact_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let pattern = match regex::Regex::new(&*!pattern) { Ok(pattern) => pattern, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("lines: invalid pattern: {error}")), [1, 0, 0, 0], true)) }; let path = &*!path; let text = match std::fs::read(std::path::Path::new(&*!root).join(path)) { Ok(bytes) => String::from_utf8_lossy(&bytes).into_owned(), Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  unreadable: {error}")), [1, 0, 0, 0], true)) }; let mut groups: Vec<(String, u64)> = Vec::new(); let mut total = 0u64; for line in text.lines() { total += 1; let key = match pattern.captures(line) { Some(captures) => captures.get(1).or_else(|| captures.get(0)).map(|found| found.as_str().to_owned()).unwrap_or_default(), None => "(no match)".to_owned() }; match groups.iter_mut().find(|group| group.0 == key) { Some(group) => group.1 += 1, None => groups.push((key, 1)) } } groups.sort_by(|left, right| right.1.cmp(&left.1)); let width = groups.iter().map(|group| group.0.len()).max().unwrap_or(0).max(5); let mut shown = vec\![format\!("{:<width$}  {}", "group", "count")]; for group in &groups { shown.push(format\!("{:<width$}  {}", group.0, group.1)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [1, total, groups.len() as u64, 0], false)) })()' : fact_outcome

let files_by_extension (~root : string) (~paths : string) : fact_outcome =
    $'{ let root = std::path::Path::new(&*!root); let paths = (&*!paths).lines().filter(|path| \!path.is_empty()).map(str::to_owned).collect::<Vec<_>>(); let mut groups: Vec<(String, u64, u64)> = Vec::new(); let mut total = 0u64; for path in &paths { let extension = std::path::Path::new(path).extension().map(|extension| format\!(".{}", extension.to_string_lossy())).unwrap_or_else(|| "(none)".to_owned()); let bytes = std::fs::metadata(root.join(path)).map(|metadata| metadata.len()).unwrap_or(0); total += bytes; match groups.iter_mut().find(|group| group.0 == extension) { Some(group) => { group.1 += 1; group.2 += bytes; } None => groups.push((extension, 1, bytes)) } } groups.sort_by(|left, right| right.1.cmp(&left.1)); let width = groups.iter().map(|group| group.0.len()).max().unwrap_or(0).max(3); let files_width = groups.iter().map(|group| group.1.to_string().len()).max().unwrap_or(0).max(5); let mut shown = vec\![format\!("{:<width$}  {:<files_width$}  {}", "ext", "files", "bytes")]; for group in &groups { shown.push(format\!("{:<width$}  {:<files_width$}  {}", group.0, group.1, group.2)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [paths.len() as u64, total, groups.len() as u64, 0], paths.is_empty())) }' : fact_outcome

let table_counted (~root : string) (~path : string) (~column : string) (~keep_equal : bool) (~value : string) (~groups : string) : fact_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let path = &*!path; let text = match std::fs::read_to_string(std::path::Path::new(&*!root).join(path)) { Ok(text) => text, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  unreadable: {error}")), [0, 0, 0, 0], true)) }; let separator = if path.ends_with(".csv") { char::from(44u8) } else { char::from(9u8) }; let mut lines = text.lines(); let header = lines.next().unwrap_or("").split(separator).map(str::trim).collect::<Vec<_>>(); let position = |name: &str| header.iter().position(|title| *title == name); let wanted = (&*!groups).lines().filter(|name| \!name.is_empty()).collect::<Vec<_>>(); let mut missing = wanted.iter().filter(|name| position(name).is_none()).map(|name| name.to_string()).collect::<Vec<_>>(); let filter = if (&*!column).is_empty() { None } else { match position(&*!column) { Some(index) => Some(index), None => { missing.push((&*!column).to_owned()); None } } }; if \!missing.is_empty() { return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  no column {} (columns: {})", missing.join(", "), header.join(", "))), [0, 0, 0, 0], true)); } let indexes = wanted.iter().filter_map(|name| position(name)).collect::<Vec<_>>(); let mut rows = 0u64; let mut matched = 0u64; let mut counts: Vec<(Vec<String>, u64)> = Vec::new(); for line in lines.filter(|line| \!line.trim().is_empty()) { rows += 1; let cells = line.split(separator).map(str::trim).collect::<Vec<_>>(); if let Some(index) = filter { if (cells.get(index).copied().unwrap_or("") == &*!value) \!= !keep_equal { continue; } } matched += 1; let key = indexes.iter().map(|index| cells.get(*index).copied().unwrap_or("").to_owned()).collect::<Vec<_>>(); match counts.iter_mut().find(|entry| entry.0 == key) { Some(entry) => entry.1 += 1, None => counts.push((key, 1)) } } counts.sort_by(|left, right| right.1.cmp(&left.1)); let widths = wanted.iter().enumerate().map(|(column, name)| counts.iter().map(|entry| entry.0[column].len()).max().unwrap_or(0).max(name.len())).collect::<Vec<_>>(); let render = |cells: Vec<String>, count: String| { let mut parts = cells.iter().zip(&widths).map(|(cell, width)| format\!("{:<width$}", cell, width = *width)).collect::<Vec<_>>(); parts.push(count); parts.join("  ") }; let mut shown = vec\![render(wanted.iter().map(|name| name.to_string()).collect(), "count".to_owned())]; for entry in &counts { shown.push(render(entry.0.clone(), entry.1.to_string())); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [rows, matched, counts.len() as u64, 0], false)) })()' : fact_outcome
let nothing_found () : fact_outcome = $'std::rc::Rc::new((std::rc::Rc::<str>::from(""), [0, 0, 0, 0], false))' : fact_outcome

let dirs_classified (~root : string) (~records : record_list) (~record : i32) : fact_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let root = std::path::Path::new(&*!root); let all = &*!records; let start = !record as usize; let words = |fields: &Vec<std::rc::Rc<str>>| fields.iter().skip(2).filter(|field| \!field.is_empty()).map(|field| (field.starts_with(char::from(113u8)), field[1..].to_owned())).collect::<Vec<_>>(); let head = words(&all[start]); let target = head.first().map(|word| word.1.clone()).unwrap_or_default(); let required = head.iter().skip_while(|word| word.1 \!= "having").skip(1).filter(|word| word.1 \!= "and").map(|word| word.1.clone()).collect::<Vec<_>>(); let (folder, mask) = match target.rsplit_once(char::from(47u8)) { Some((folder, mask)) if mask.contains(char::from(42u8)) => (folder.to_owned(), mask.to_owned()), _ => (target.clone(), String::new()) }; let wildcard = |mask: &str, name: &str| { let parts = mask.split(char::from(42u8)).collect::<Vec<_>>(); if parts.len() == 1 { return mask == name; } name.starts_with(parts[0]) && name.ends_with(parts[parts.len() - 1]) && name.len() >= parts[0].len() + parts[parts.len() - 1].len() }; let mut candidates = if mask.is_empty() { vec\![target.clone()] } else { std::fs::read_dir(root.join(&folder)).map(|entries| entries.filter_map(|entry| entry.ok()).filter(|entry| entry.path().is_dir()).map(|entry| entry.file_name().to_string_lossy().into_owned()).filter(|name| wildcard(&mask, name)).map(|name| format\!("{folder}/{name}")).collect::<Vec<_>>()).unwrap_or_default() }; candidates.sort(); let matched = candidates.iter().filter(|dir| required.iter().all(|file| root.join(dir.as_str()).join(file).is_file())).cloned().collect::<Vec<_>>(); let mut tags: Vec<(String, Vec<(bool, String)>)> = Vec::new(); let mut grouping: Option<String> = None; for fields in all.iter().skip(start + 1) { match fields.get(1).map(|verb| &**verb) { Some("tag") => { let line = words(fields); let name = line.first().map(|word| word.1.clone()).unwrap_or_default(); tags.push((name, line.into_iter().skip(2).collect())); } Some("count") => { grouping = words(fields).iter().skip_while(|word| word.1 \!= "by").nth(1).map(|word| word.1.clone()); } _ => break } } let evaluate = |dir: &str, expression: &[(bool, String)]| -> Result<bool, String> { let mut any = false; let mut all = true; let mut negate = false; let mut index = 0; while index < expression.len() { let (quoted, word) = &expression[index]; if \!quoted && word == "and" { index += 1; continue; } if \!quoted && word == "or" { any = any || all; all = true; index += 1; continue; } if \!quoted && word == "not" { negate = \!negate; index += 1; continue; } let file = word.clone(); let pattern = match (expression.get(index + 1), expression.get(index + 2)) { (Some((false, tilde)), Some((true, pattern))) if tilde == "~" => pattern.clone(), _ => return Err(format\!("tag: expected <file> ~ <quoted regex> near {file}")) }; let pattern = regex::Regex::new(&pattern).map_err(|error| format\!("tag: invalid pattern: {error}"))?; let text = std::fs::read(root.join(dir).join(&file)).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); let hit = pattern.is_match(&text) \!= negate; all = all && hit; negate = false; index += 3; } Ok(any || all) }; let short = |dir: &String| dir.rsplit(char::from(47u8)).next().unwrap_or(dir).to_owned(); let mut values: Vec<Vec<String>> = Vec::new(); for dir in &matched { let mut row = Vec::new(); for (_, expression) in &tags { match evaluate(dir, expression) { Ok(value) => row.push(value.to_string()), Err(problem) => return std::rc::Rc::new((std::rc::Rc::<str>::from(problem), [matched.len() as u64, candidates.len() as u64, 0, 0], true)) } } values.push(row); } let shown = match grouping.as_ref().and_then(|name| tags.iter().position(|tag| &tag.0 == name).map(|index| (name.clone(), index))) { Some((name, index)) => { let mut groups: Vec<(String, u64, Vec<String>)> = Vec::new(); for (dir, row) in matched.iter().zip(&values) { match groups.iter_mut().find(|group| group.0 == row[index]) { Some(group) => { group.1 += 1; group.2.push(short(dir)); } None => groups.push((row[index].clone(), 1, vec\![short(dir)])) } } groups.sort_by(|left, right| right.1.cmp(&left.1)); let width = groups.iter().map(|group| group.0.len()).max().unwrap_or(0).max(name.len()); let mut lines = vec\![format\!("{:<width$}  {:<5}  {}", name, "count", "dirs")]; for group in &groups { lines.push(format\!("{:<width$}  {:<5}  {}", group.0, group.1, group.2.join(", "))); } lines } None => { if let Some(name) = &grouping { return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("count by: no tag named {name}")), [matched.len() as u64, candidates.len() as u64, 0, 0], true)); } let width = matched.iter().map(|dir| short(dir).len()).max().unwrap_or(0).max(3); let mut lines = vec\![std::iter::once(format\!("{:<width$}", "dir")).chain(tags.iter().map(|tag| format\!("{:<w$}", tag.0, w = tag.0.len().max(5)))).collect::<Vec<_>>().join("  ").trim_end().to_owned()]; for (dir, row) in matched.iter().zip(&values) { lines.push(std::iter::once(format\!("{:<width$}", short(dir))).chain(row.iter().zip(&tags).map(|(value, tag)| format\!("{:<w$}", value, w = tag.0.len().max(5)))).collect::<Vec<_>>().join("  ").trim_end().to_owned()); } lines } }; std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [matched.len() as u64, candidates.len() as u64, 0, 0], false)) })()' : fact_outcome
