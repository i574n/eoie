let state_path_candidate_code (~name : string) : u64 =
    if (name = "typecheck_receipts.spi") then 0u64
    elif sm'.ends_with ".spi" name then 1u64
    else 0u64

inl main () : i32 =
    inl _ = state_path_candidate_code "ratings.spi"
    inl _ = state_path_candidate_code "typecheck_receipts.spi"
    inl _ = state_path_candidate_code "notes.txt"
    0i32
