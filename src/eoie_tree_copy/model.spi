let entry_allowed (depth : i32) (entries : i32) : i32 =
    if depth < 0i32 then 0i32
    elif 128i32 < depth then 0i32
    elif entries < 0i32 then 0i32
    elif entries < 100000i32 then 1i32
    else 0i32

let remaining_entries (entries : i32) : i32 =
    if entries < 0i32 then -1i32
    elif 100000i32 < entries then -1i32
    else 100000i32 - entries
