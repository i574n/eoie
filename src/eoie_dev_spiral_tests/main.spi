open registry

let rec run_all (root : string) (target : string) (names : string) (separator : string) (dry : bool) (timeout : u64) (notebooks : spiral_test_notebooks) : i32 =
    match notebooks with
    | NoMoreNotebooks => 0i32
    | SpiralTestNotebook (package, relative, rest) =>
        inl code =
            if selects names separator package then
                if dry then notebook.announce relative else notebook.run root target relative timeout
            else 0i32
        if !!!!EQ(code,0i32) then run_all root target names separator dry timeout rest else code

inl main () : i32 =
    !!!!Export("eoie_dev_spiral_tests_run", ((fun (root, target, names, separator, dry, timeout) => run_all root target names separator dry timeout (registered ())) : string * string * string * string * bool * u64 -> i32))
    0i32