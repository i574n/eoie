inl present (root : string) (relative : string) : bool =
    $'std::path::Path::new(&*!root).join(&*!relative).is_file()' : bool

inl announce (relative : string) : i32 =
    $'{ std::io::Write::write_all(&mut std::io::stdout(),format\!("spiral test blocks {}\n",&*!relative).as_bytes()).unwrap(); 0i32 }' : i32

inl run (root : string) (target : string) (relative : string) (timeout : u64) : i32 =
    $'{ let root=std::path::Path::new(&*!root); let target=std::path::Path::new(&*!target); let kino=std::env::var_os("EOIE_SPIRAL_CELLS").map(std::path::PathBuf::from).or_else(|| std::env::var_os("EOIE_SPIRAL_BUNDLE").map(|bundle| std::path::PathBuf::from(bundle).join("..").join("..").join("cells"))).unwrap_or_else(|| root.join("..").join("spiral").join("apps").join("cells")); let source=root.join(&*!relative); let output=target.join("spiral-tests").join(source.file_name().unwrap()).with_extension("spi.ipynb"); let _=std::fs::create_dir_all(target.join("spiral-tests")); let eoie=target.join("debug").join(format\!("eoie{}",std::env::consts::EXE_SUFFIX)); let mut command=std::process::Command::new("pwsh"); command.current_dir(root).arg("-NoProfile").arg("-File").arg(kino.join("spi").join("run_notebook.ps1")).arg("--path").arg(&source).arg("--output-path").arg(&output).arg("--no-html").env("EOIE_BIN_UNDER_TEST",&eoie).env("SPIRAL_CELLS_WARM","0").env("SPIRAL_CELLS_MEMO","0").env("SPIRAL_CELLS_COMPILER","process"); match eoie_process::run_bounded(&mut command,!timeout) { Ok(status) => status.code().unwrap_or(1), Err(error) => { let _=std::io::Write::write_all(&mut std::io::stderr(),error.as_bytes()); 2 } } }' : i32