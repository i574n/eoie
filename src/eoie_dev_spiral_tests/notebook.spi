inl present (root : string) (relative : string) : bool =
    $'std::path::Path::new(&*!root).join(&*!relative).is_file()' : bool

inl announce (relative : string) : i32 =
    $'{ std::io::Write::write_all(&mut std::io::stdout(),format\!("spiral test blocks {}\n",&*!relative).as_bytes()).unwrap(); 0i32 }' : i32

nominal batch_outcome = $'(i32, std::rc::Rc<str>)'

let run_batch (root : string) (target : string) (relatives : string) (timeout : u64) : batch_outcome =
    $'{ let root=std::path::Path::new(&*!root); let target=std::path::Path::new(&*!target); let cells_root=std::env::var_os("EOIE_SPIRAL_CELLS").map(std::path::PathBuf::from).or_else(|| std::env::var_os("EOIE_SPIRAL_BUNDLE").map(|bundle| std::path::PathBuf::from(bundle).join("..").join("..").join("cells"))).unwrap_or_else(|| root.join("..").join("spiral").join("apps").join("cells")); let relatives=(&*!relatives).lines().map(str::to_owned).collect::<Vec<_>>(); let reports_dir=target.join("spiral-tests"); let _=std::fs::create_dir_all(&reports_dir); let eoie=target.join("debug").join(format\!("eoie{}",std::env::consts::EXE_SUFFIX)); let port=20000+std::process::id()%10000; let mut command=std::process::Command::new("pwsh"); command.current_dir(root).arg("-NoProfile").arg("-File").arg(cells_root.join("spi").join("run_notebook.ps1")); for relative in &relatives { command.arg("--path").arg(root.join(relative)); } command.arg("--output-dir").arg(&reports_dir).arg("--no-html").arg("--gate").env("EOIE_BIN_UNDER_TEST",&eoie).env("SPIRAL_CELLS_WARM","0").env("SPIRAL_CELLS_MEMO","0").env_remove("SPIRAL_CELLS_COMPILER").env("SPIRAL_CELLS_COMPILER_PORT",port.to_string()); let bounded=(!timeout).saturating_mul(relatives.len().max(1) as u64); let stdout_handle=std::io::stdout(); let stderr_handle=std::io::stderr(); let streamed=eoie_process_streaming::run_bounded_streaming(&mut command,bounded,None,|kind,bytes| match kind { eoie_process_streaming::ProcessStreamKind::Stdout => { let mut out=stdout_handle.lock(); std::io::Write::write_all(&mut out,bytes).and_then(|_| std::io::Write::flush(&mut out)).map_err(|error| error.to_string()) } eoie_process_streaming::ProcessStreamKind::Stderr => { let mut err=stderr_handle.lock(); std::io::Write::write_all(&mut err,bytes).and_then(|_| std::io::Write::flush(&mut err)).map_err(|error| error.to_string()) } }); match streamed { Ok(capture) => { let code=if matches\!(capture.termination,eoie_process_streaming::ProcessTermination::TimedOut) { 124 } else { capture.status.code().unwrap_or(1) }; let quote=char::from(34u8); let failed_key=format\!("{quote}failed{quote}:"); let file_key=format\!("{quote}file{quote}:{quote}"); let text=String::from_utf8_lossy(&capture.stdout).replace(char::from(92u8),"/").to_lowercase(); let reports=text.lines().filter_map(|line| line.strip_prefix("spiral-tests file ")).map(|json| { let failed=json.split(failed_key.as_str()).nth(1).map(|rest| rest.chars().take_while(|c| c.is_ascii_digit()).collect::<String>()).unwrap_or_default(); let file=json.split(file_key.as_str()).nth(1).and_then(|rest| rest.split(quote).next()).unwrap_or("").to_owned(); (file,failed) }).collect::<Vec<_>>(); let failing=relatives.iter().filter(|relative| { let wanted=relative.replace(char::from(92u8),"/").to_lowercase(); match reports.iter().find(|(file,_)| file.ends_with(&wanted)) { Some((_,failed)) => failed.as_str() \!= "0", None => true } }).cloned().collect::<Vec<_>>(); (code,std::rc::Rc::<str>::from(failing.join("\n"))) } Err(error) => { let _=std::io::Write::write_all(&mut std::io::stderr(),error.as_bytes()); (2,std::rc::Rc::<str>::from(relatives.join("\n"))) } } }' : batch_outcome

inl batch_code (outcome : batch_outcome) : i32 = $'!outcome.0' : i32
inl batch_failed (outcome : batch_outcome) : string = $'!outcome.1.clone()' : string
inl line_count (text : string) : i32 = $'(&*!text).lines().count() as i32' : i32
inl line_at (text : string) (index : i32) : string = $'std::rc::Rc::<str>::from((&*!text).lines().nth(!index as usize).unwrap_or(""))' : string
