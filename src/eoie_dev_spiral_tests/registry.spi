union rec spiral_test_notebooks =
    | NoMoreNotebooks
    | SpiralTestNotebook : string * string * spiral_test_notebooks

inl registered () : spiral_test_notebooks =
    SpiralTestNotebook ("agile-planning-rollup", "src/agile_planning_rollup/planning_cli.spi",
        SpiralTestNotebook ("agile-todo-scan", "src/agile_todo_model/model.spi",
            SpiralTestNotebook ("agile-todo-scan", "src/agile_todo_model/todo_cli.spi",
                SpiralTestNotebook ("eoie-archive-tar-runtime", "src/eoie_archive_tar_runtime/format.spi",
                    SpiralTestNotebook ("eoie-bundle-retention", "src/eoie_bundle_retention/series.spi",
                        SpiralTestNotebook ("eoie-bundle-retention", "src/eoie_bundle_retention/receipt.spi", NoMoreNotebooks))))))

inl selects (names : string) (separator : string) (package : string) : bool =
    if rust_std_string.model.equals names "" then true
    else rust_std_string.model.contains (rust_std_string.model.concat5 separator names separator "" "") (rust_std_string.model.concat5 separator package separator "" "")