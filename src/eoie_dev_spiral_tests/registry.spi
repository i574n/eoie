                    SpiralTestNotebook ("eoie-bundle-retention", "src/eoie_bundle_retention/series.spi",
                        SpiralTestNotebook ("eoie-bundle-retention", "src/eoie_bundle_retention/receipt.spi",
                            SpiralTestNotebook ("eoie-cli", "src/eoie_cli_model/argument_file.spi",
                                SpiralTestNotebook ("eoie-jobs", "src/eoie_jobs/model.spi",
                                    SpiralTestNotebook ("eoie-repo-state", "src/eoie_repo_state/state.spi",
                                        SpiralTestNotebook ("eoie-table-query", "src/eoie_table_query/query.spi",
                                            SpiralTestNotebook ("eoie-lcov", "src/eoie_lcov/lcov.spi",
                                                SpiralTestNotebook ("eoie-bundle-retention", "src/eoie_bundle_retention/receipt_read.spi",
                                                    SpiralTestNotebook ("eoie-read-query", "src/eoie_read_query/model.spi", SpiralTestNotebook ("eoie-read-query", "src/eoie_receipt/receipt.spi", SpiralTestNotebook ("eoie-do-program", "src/eoie_do_program/program.spi", SpiralTestNotebook ("eoie-do-read", "src/eoie_do_read/grammar.spi", SpiralTestNotebook ("eoie-process-table", "src/eoie_process_table/model.spi", SpiralTestNotebook ("eoie-do-facts", "src/eoie_do_facts/grammar.spi", SpiralTestNotebook ("eoie-do-process", "src/eoie_do_process/grammar.spi", SpiralTestNotebook ("eoie-do-tables", "src/eoie_do_tables/grammar.spi", SpiralTestNotebook ("eoie-do-write", "src/eoie_do_write/grammar.spi", SpiralTestNotebook ("eoie-do-git", "src/eoie_do_git/grammar.spi", SpiralTestNotebook ("eoie-do-jobs", "src/eoie_do_jobs/grammar.spi", SpiralTestNotebook ("eoie-do-lab", "src/eoie_do_lab/grammar.spi", SpiralTestNotebook ("eoie-cli", "src/workspace_primitives/toolchain.spi", SpiralTestNotebook ("eoie-contracts", "src/agile_task_notes/notes_cli.spi", SpiralTestNotebook ("eoie-contracts", "src/eoie_contracts/receipts_cli.spi", SpiralTestNotebook ("eoie-agile-contracts", "src/eoie_agile_contracts/agile_cli.spi", SpiralTestNotebook ("eoie-archive-contracts", "src/eoie_archive_contracts/archive_cli.spi", SpiralTestNotebook ("eoie-release-contracts", "src/eoie_release_contracts/upgrade_cli.spi", SpiralTestNotebook ("eoie-cli", "src/eoie_cli/windows_cli.spi", SpiralTestNotebook ("eoie-coverage-prune", "src/coverage_prune_model/model.spi", SpiralTestNotebook ("eoie-coverage-prune", "src/eoie_coverage_prune/coverage_cli.spi", SpiralTestNotebook ("eoie-coverage-prune", "src/eoie_coverage_prune/evidence_cli.spi", SpiralTestNotebook ("eoie-release-contracts", "src/eoie_release_contracts/hygiene_cli.spi", SpiralTestNotebook ("eoie-proxy-search", "src/eoie_proxy_search/hash_cli.spi", NoMoreNotebooks))))))))))))))))))))))))))))))))))))

inl selects (names : string) (separator : string) (package : string) : bool =
    if rust_std_string.model.equals names "" then true
    else rust_std_string.model.contains (rust_std_string.model.concat5 separator names separator "" "") (rust_std_string.model.concat5 separator package separator "" "")