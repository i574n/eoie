nominal table_outcome = $'std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)>'

nominal record_list = $'std::rc::Rc<Vec<Vec<std::rc::Rc<str>>>>'

let records_of (~encoded : string) : record_list =
    $'std::rc::Rc::new((&*!encoded).split(char::from(30u8)).map(|record| record.split(char::from(31u8)).map(std::rc::Rc::<str>::from).collect::<Vec<_>>()).collect::<Vec<_>>())' : record_list

inl record_count (~records : record_list) : i32 = $'!records.len() as i32' : i32

let field_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).cloned().unwrap_or_default()' : string

inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()

let field_index (~records : record_list) (~record : i32) (~word : string) : i32 =
    $'!records.get(!record as usize).and_then(|fields| fields.iter().position(|field| field.len() > 1 && field.starts_with(char::from(119u8)) && &field[1..] == &*!word)).map(|index| index as i32).unwrap_or(-1)' : i32

let body_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).filter(|field| \!field.is_empty()).map(|field| std::rc::Rc::<str>::from(&field[1..])).unwrap_or_default()' : string

let items_span (~records : record_list) (~record : i32) (~from : i32) (~until : i32) : string =
    $'{ let fields = !records.get(!record as usize).cloned().unwrap_or_default(); let until = if !until < 0 { fields.len() } else { (!until as usize).min(fields.len()) }; let mut items = Vec::new(); for raw in fields.iter().take(until).skip(!from as usize) { if raw.is_empty() { continue; } let (kind, body) = raw.split_at(1); if kind == "q" { items.push(body.to_owned()); } else { items.extend(body.split(|c: char| c == char::from(44u8) || c.is_whitespace()).filter(|item| \!item.is_empty()).map(str::to_owned)); } } std::rc::Rc::<str>::from(items.join("\n")) }' : string

inl outcome_report (~outcome : table_outcome) : string = $'!outcome.0.clone()' : string
inl outcome_counter (~outcome : table_outcome) (~index : u64) : u64 = $'!outcome.1[!index as usize]' : u64
inl outcome_failed (~outcome : table_outcome) : bool = $'!outcome.2' : bool

let tables_diffed (~root : string) (~left : string) (~right : string) (~keys : string) (~columns : string) : table_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let read = |path: &str| -> Result<(Vec<String>, Vec<Vec<String>>), String> { let text = std::fs::read_to_string(std::path::Path::new(&*!root).join(path)).map_err(|error| format\!("{path}  unreadable: {error}"))?; let separator = if path.ends_with(".csv") { char::from(44u8) } else { char::from(9u8) }; let mut lines = text.lines(); let header = lines.next().unwrap_or("").split(separator).map(|cell| cell.trim().to_owned()).collect::<Vec<_>>(); Ok((header, lines.filter(|line| \!line.trim().is_empty()).map(|line| line.split(separator).map(|cell| cell.trim().to_owned()).collect()).collect())) }; let fail = |message: String| std::rc::Rc::new((std::rc::Rc::<str>::from(message), [0, 0, 0, 0], true)); let (left_header, left_rows) = match read(&*!left) { Ok(table) => table, Err(message) => return fail(message) }; let (right_header, right_rows) = match read(&*!right) { Ok(table) => table, Err(message) => return fail(message) }; let keys = (&*!keys).lines().filter(|key| \!key.is_empty()).map(str::to_owned).collect::<Vec<_>>(); let mut columns = (&*!columns).lines().filter(|column| \!column.is_empty()).map(str::to_owned).collect::<Vec<_>>(); if columns.is_empty() { columns = left_header.iter().filter(|name| \!keys.contains(name) && right_header.contains(name)).cloned().collect(); } let position = |header: &Vec<String>, name: &String| header.iter().position(|title| title == name); for name in keys.iter().chain(&columns) { if position(&left_header, name).is_none() || position(&right_header, name).is_none() { return fail(format\!("diff: column {name} is not in both tables")); } } let key_of = |header: &Vec<String>, row: &Vec<String>| keys.iter().map(|name| row.get(position(header, name).unwrap()).cloned().unwrap_or_default()).collect::<Vec<_>>().join("|"); let cell = |header: &Vec<String>, row: &Vec<String>, name: &String| row.get(position(header, name).unwrap()).cloned().unwrap_or_default(); let mut changes: Vec<(String, String, String, String)> = Vec::new(); let mut changed = 0u64; let mut both = 0u64; let mut removed = Vec::new(); for row in &left_rows { let key = key_of(&left_header, row); match right_rows.iter().find(|other| key_of(&right_header, other) == key) { None => removed.push(key), Some(other) => { both += 1; let mut differs = false; for name in &columns { let (before, after) = (cell(&left_header, row, name), cell(&right_header, other, name)); if before \!= after { differs = true; changes.push((key.clone(), name.clone(), before, after)); } } if differs { changed += 1; } } } } let added = right_rows.iter().map(|row| key_of(&right_header, row)).filter(|key| \!left_rows.iter().any(|row| &key_of(&left_header, row) == key)).collect::<Vec<_>>(); let key_width = changes.iter().map(|change| change.0.len()).chain(if added.is_empty() { None } else { Some(5) }).chain(if removed.is_empty() { None } else { Some(7) }).max().unwrap_or(0).max(3); let column_width = changes.iter().map(|change| change.1.len()).max().unwrap_or(0).max(6); let before_width = changes.iter().map(|change| change.2.len()).max().unwrap_or(0).max(1); let mut shown = vec\![format\!("{:<key_width$}  {:<column_width$}  {:<before_width$}  {}", "key", "column", "a", "b")]; for change in &changes { shown.push(format\!("{:<key_width$}  {:<column_width$}  {:<before_width$}  {}", change.0, change.1, change.2, change.3).trim_end().to_owned()); } for key in &added { shown.push(format\!("{:<key_width$}  {}", "added", key)); } for key in &removed { shown.push(format\!("{:<key_width$}  {}", "removed", key)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [left_rows.len() as u64, right_rows.len() as u64, changed, both], false)) })()' : table_outcome