///- --package .
test grammar static =
    open rust_std_string.model
    open host

open rust_std_string.model
open host

union table_step =
    | TablesDiffed : string * string * string * string

union table_parse =
    | TableParsed : table_step
    | TableRejected : string

let table_parsed (~records : record_list) (~record : i32) : table_parse =
    inl verb = field_at records record 1i32
    inl left = body_at records record 2i32
    inl right = body_at records record 3i32
    inl by_at = field_index records record "by"
    inl on_at = field_index records record "on"
    if verb <> "diff" then TableRejected (concat5 verb " cannot share one program with diff yet; run it as its own call" "" "" "")
    elif left = "" || right = "" || right = "by" then TableRejected "diff: expected two tables"
    elif by_at < 0i32 then TableRejected "diff: expected by <key,...>"
    else
        inl keys = items_span records record (by_at + 1i32) (if on_at < 0i32 then (-1i32) else on_at)
        inl columns = if on_at < 0i32 then "" else items_span records record (on_at + 1i32) (-1i32)
        if keys = "" then TableRejected "by: expected a value after it" else TableParsed (TablesDiffed (left, right, keys, columns))

inl expect (condition : bool) (~detail : string) : () = if condition then () else $'panic\!("{}", &*!detail)' : ()

inl records_from_bars (~text : string) : record_list =
    $'std::rc::Rc::new((&*!text).split(char::from(10u8)).map(|record| record.split(char::from(124u8)).map(std::rc::Rc::<str>::from).collect::<Vec<_>>()).collect::<Vec<_>>())' : record_list

///> rust
test diff_statements_name_two_tables_keys_and_columns =
    match table_parsed (records_from_bars "ok\nquery|diff|wa.tsv|wb.tsv|wby|wid,|wbackend|won|wcompile,|wexit") 1i32 with
    | TableParsed (TablesDiffed (left, right, keys, columns)) => expect (left = "a.tsv" && right = "b.tsv" && keys = "id\nbackend" && columns = "compile\nexit") "diff parts"
    | TableRejected message => expect false message
    match table_parsed (records_from_bars "ok\nquery|diff|wa.tsv|wb.tsv") 1i32 with
    | TableRejected message => expect (message = "diff: expected by <key,...>") "missing keys"
    | TableParsed _ => expect false "keys are required"