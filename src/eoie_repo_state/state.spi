///- --package .
test state static =
    open rust_std_string.model

open rust_std_string.model

union entry_kind =
    | TrackedChange
    | RenamedChange
    | UntrackedEntry
    | UnmergedEntry
    | HeaderLine
    | OtherLine

inl entry_kind_of (~line : string) : entry_kind =
    if starts_with line "1 " then TrackedChange
    elif starts_with line "2 " then RenamedChange
    elif starts_with line "? " then UntrackedEntry
    elif starts_with line "u " then UnmergedEntry
    elif starts_with line "# " then HeaderLine
    else OtherLine

type change_counts =
    {
        staged : u64
        modified : u64
        untracked : u64
        unmerged : u64
    }

inl no_changes () : change_counts = { staged = 0u64; modified = 0u64; untracked = 0u64; unmerged = 0u64 }

inl field (~line : string) (~index : u64) : string =
    $'std::rc::Rc::<str>::from(!line.split(char::from(32u8)).nth(!index as usize).unwrap_or(""))' : string

inl from_field (~line : string) (~index : u64) : string =
    $'std::rc::Rc::<str>::from(!line.splitn((!index as usize) + 1, char::from(32u8)).nth(!index as usize).unwrap_or("").split(char::from(9u8)).next().unwrap_or(""))' : string

inl staged_flag (~xy : string) : bool = $'!xy.chars().next().map(|c| c == char::from(46u8)).unwrap_or(true) == false' : bool

inl modified_flag (~xy : string) : bool = $'!xy.chars().nth(1).map(|c| c == char::from(46u8)).unwrap_or(true) == false' : bool

inl area_of (~path : string) (~depth : u64) : string =
    $'{ let parts = !path.split(char::from(47u8)).collect::<Vec<_>>(); let keep = (!depth as usize).min(parts.len().saturating_sub(1)).max(1).min(parts.len()); std::rc::Rc::<str>::from(parts[..keep].join("/")) }' : string

inl flag_count (flag : bool) : u64 = if flag then 1u64 else 0u64

let counts_of (~line : string) : change_counts =
    inl base = no_changes ()
    match entry_kind_of line with
    | TrackedChange =>
        inl xy = field line 1u64
        { base with staged = flag_count (staged_flag xy); modified = flag_count (modified_flag xy) }
    | RenamedChange =>
        inl xy = field line 1u64
        { base with staged = flag_count (staged_flag xy); modified = flag_count (modified_flag xy) }
    | UntrackedEntry => { base with untracked = 1u64 }
    | UnmergedEntry => { base with unmerged = 1u64 }
    | HeaderLine => base
    | OtherLine => base

let path_of (~line : string) : string =
    match entry_kind_of line with
    | TrackedChange => from_field line 8u64
    | RenamedChange => from_field line 9u64
    | UntrackedEntry => from_field line 1u64
    | UnmergedEntry => from_field line 10u64
    | HeaderLine => ""
    | OtherLine => ""

inl expect (condition : bool) (~detail : string) : () = if condition then () else $'panic\!("{}", &*!detail)' : ()

///> rust
test porcelain_v2_lines_count_by_kind =
    inl staged = counts_of "1 M. N... 100644 100644 100644 abc def src/eoie_jobs/jobs.spi"
    expect (staged.staged = 1u64 && staged.modified = 0u64) "staged only"
    inl both = counts_of "1 MM N... 100644 100644 100644 abc def src/eoie_cli/main.spi"
    expect (both.staged = 1u64 && both.modified = 1u64) "staged and modified"
    expect ((counts_of "? lab/EOIE-CORE-OPERATORS/sweep.ps1").untracked = 1u64) "untracked"
    expect (path_of "1 .M N... 100644 100644 100644 abc def src/a b/c.spi" = "src/a b/c.spi") "paths keep spaces"
    expect (path_of "2 R. N... 100644 100644 100644 abc def R100 src/new.spi\tsrc/old.spi" = "src/new.spi") "renames report the new path"

///> rust
test areas_cut_paths_at_the_requested_depth =
    expect (area_of "src/eoie_jobs/jobs.spi" 2u64 = "src/eoie_jobs") "two levels"
    expect (area_of "Cargo.lock" 2u64 = "Cargo.lock") "top-level file"
    expect (area_of "apps/compiler/tmp/x.ps1" 1u64 = "apps") "one level"
