///- --package .
union argument_source =
    | DirectArguments
    | FileArguments : string
    | StdinArguments

nominal argument_text = $'Result<std::rc::Rc<str>, std::rc::Rc<str>>'

inl argument_flag () : string = "--args-from"

inl standard_input_marker () : string = "-"

inl process_argument (~index : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().nth(!index as usize).unwrap_or_default())' : string

let argument_source () : argument_source =
    if process_argument 1i32 = argument_flag () then
        inl origin = process_argument 2i32
        if origin = standard_input_marker () then StdinArguments else FileArguments origin
    else DirectArguments

inl file_text (~path : string) : argument_text =
    $'std::fs::read_to_string(&*!path).map(std::rc::Rc::<str>::from).map_err(|error| std::rc::Rc::<str>::from(format\!("--args-from {}: {error}", &*!path)))' : argument_text

inl stdin_text () : argument_text =
    $'{ let mut text = String::new(); std::io::Read::read_to_string(&mut std::io::stdin(), &mut text).map(|_| std::rc::Rc::<str>::from(text)).map_err(|error| std::rc::Rc::<str>::from(format\!("--args-from -: {error}"))) }' : argument_text

inl text_read (~text : argument_text) : bool = $'!text.is_ok()' : bool

inl text_value (~text : argument_text) : string =
    $'!text.clone().unwrap_or_else(|error| error)' : string

inl argument_count (~text : string) : i32 =
    $'!text.lines().map(|line| line.trim_end_matches(char::from(13u8))).count() as i32' : i32

inl relaunched_with (~text : string) : i32 =
    $'{ let arguments = !text.lines().map(|line| line.trim_end_matches(char::from(13u8)).to_owned()).chain(std::env::args().skip(3)).collect::<Vec<_>>(); match std::env::current_exe().and_then(|exe| std::process::Command::new(exe).args(&arguments).status()) { Ok(status) => status.code().unwrap_or(1), Err(error) => { eprintln\!("eoie error: --args-from relaunch: {error}"); 2 } } }' : i32

inl rejected (~message : string) : i32 =
    $'{ eprintln\!("eoie error: {}", &*!message); 2 }' : i32

inl relaunched (text : argument_text) : i32 =
    if text_read text then relaunched_with (text_value text) else rejected (text_value text)

let run_from (source : argument_source) (direct : () -> i32) : i32 =
    match source with
    | DirectArguments => direct ()
    | FileArguments path => relaunched (file_text path)
    | StdinArguments => relaunched (stdin_text ())

inl expect (condition : bool) (~detail : string) : () = if condition then () else $'panic\!("{}", &*!detail)' : ()

///> rust
test each_line_is_one_argument_and_quotes_survive =
    expect (argument_count "agile\nnote\nroot\nID\nsay \"hi\" twice" = 5i32) "five lines"
    expect (argument_count "a\r\nb\r\n" = 2i32) "crlf lines and a final newline"
