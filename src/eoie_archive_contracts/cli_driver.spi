inl rust_global (x : string) : () = !!!!Global(x)

inl emit_archive_contract_cli_driver () =
    rust_global """#![cfg(test)]
use std::env;
use std::fs;
use std::path::{Path, PathBuf};
use std::process::{Command, Output};
use std::time::{SystemTime, UNIX_EPOCH};

fn eoie_binary() -> PathBuf {
    if let Ok(path) = env::var("EOIE_BIN_UNDER_TEST") { return PathBuf::from(path); }
    let current = env::current_exe().expect("current test executable");
    let name = if cfg!(windows) { "eoie.exe" } else { "eoie" };
    let debug = current.parent().and_then(Path::parent).expect("target profile directory");
    let candidate = current.ancestors().skip(1).take_while(|directory| directory.file_name().is_some_and(|dir| dir != "target")).map(|directory| directory.join(name)).find(|path| path.is_file()).unwrap_or_else(|| debug.join(name));
    assert!(candidate.is_file(), "EOIE binary not found at {}", candidate.display());
    candidate
}

fn run(args: &[&str]) -> Output {
    Command::new(eoie_binary()).current_dir(env::temp_dir()).current_dir(env::temp_dir()).current_dir(env::temp_dir()).args(args).output().expect("run EOIE")
}

fn run_ok(args: &[&str]) -> String {
    let output = run(args);
    assert!(output.status.success(), "EOIE failed: {}", String::from_utf8_lossy(&output.stderr));
    String::from_utf8(output.stdout).expect("utf8 stdout")
}

fn temporary(label: &str) -> PathBuf {
    let stamp = SystemTime::now().duration_since(UNIX_EPOCH).expect("clock").as_nanos();
    env::temp_dir().join(format!("eoie-contract-{label}-{}-{stamp}", std::process::id()))
}

fn write(path: &Path, text: &str) {
    fs::create_dir_all(path.parent().expect("parent")).expect("create parent");
    fs::write(path, text).expect("write fixture");
}"""
