let toolchain_program_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    elif action_code < 1i32 then 0i32
    elif 1i32 < action_code then
        if action_code < 4i32 then 0i32
        elif 4i32 < action_code then 0i32
        else 2i32
    else 1i32

let toolchain_argument_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    elif action_code < 7i32 then action_code
    else 6i32

let toolchain_environment_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    elif action_code < 3i32 then 0i32
    elif 3i32 < action_code then
        if action_code < 7i32 then 0i32 else 1i32
    else 2i32

let toolchain_timeout_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    else 0i32

let toolchain_success_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    else 0i32

let toolchain_resume_profile_binding (action_code : i32) (witness : i32) : i32 =
    if action_code < 0i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif witness < 0i32 then -1i32
    elif 0i32 < witness then -1i32
    elif action_code = 2i32 then model.toolchain_resume_profile_code model.CargoCheckResume
    elif action_code = 3i32 then model.toolchain_resume_profile_code model.CargoTestResume
    elif action_code = 4i32 then model.toolchain_resume_profile_code model.CargoClippyResume
    elif action_code = 5i32 then model.toolchain_resume_profile_code model.CargoReleaseResume
    elif action_code = 7i32 then model.toolchain_resume_profile_code model.SpiralUtilityResume
    else model.toolchain_resume_profile_code model.CargoUtilityResume

let toolchain_resume_retry_binding (checkpoint : i32) (outcome : i32) : i32 =
    if checkpoint = 4i32 && outcome = 3i32 then model.toolchain_resume_decision_code model.RetryTimedOutReceipt else model.toolchain_resume_decision_code model.ContinueReceipt

let toolchain_execution_plan_binding (action_code : i32) (witness : i32) : i32 =
    inl program = toolchain_program_profile_binding action_code witness
    inl environment = toolchain_environment_profile_binding action_code witness
    inl timeout = toolchain_timeout_profile_binding action_code witness
    inl success = toolchain_success_profile_binding action_code witness
    if program < 0i32 then -1i32
    elif environment < 0i32 then -1i32
    elif timeout < 0i32 then -1i32
    elif success < 0i32 then -1i32
    else program + (environment * 4i32 + (timeout * 16i32 + success * 32i32))

let toolchain_environment_entry_count_binding (action_code : i32) (witness : i32) : i32 =
    inl environment = toolchain_environment_profile_binding action_code witness
    if environment < 0i32 then -1i32
    elif environment = 1i32 then 0i32
    elif environment = 2i32 then 8i32
    else 5i32

let toolchain_environment_entry_binding (action_code : i32) (index : i32) : i32 =
    inl environment = toolchain_environment_profile_binding action_code 0i32
    inl count = toolchain_environment_entry_count_binding action_code 0i32
    if environment < 0i32 then -1i32
    elif index < 0i32 then -1i32
    elif index < count then
        if index = 0i32 then 0i32
        elif index = 1i32 then 17i32
        elif index = 2i32 then 34i32
        elif index = 3i32 then 51i32
        elif index = 4i32 then 68i32
        elif index = 5i32 then 85i32
        elif index = 6i32 then 86i32
        else 103i32
    else -1i32
