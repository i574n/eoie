nominal child_process = $'std::rc::Rc<std::cell::RefCell<std::process::Child>>'

nominal spawn_outcome = $'Result<std::rc::Rc<std::cell::RefCell<std::process::Child>>, std::rc::Rc<str>>'

inl argument (~index : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().nth(!index as usize).unwrap_or_default())' : string

let argument_count () : i32 = env.command_line_argument_count () + 1i32

inl arguments_from (~index : i32) : string =
    $'std::rc::Rc::<str>::from(std::env::args().skip(!index as usize).collect::<Vec<_>>().join("\n"))' : string

let decimal_u64 (~text : string) : u64 = optionm'.default_value 0u64 (convert.try_convert text)

inl decimal_i32 (~text : string) : i32 = $'!text.trim().parse::<i32>().unwrap_or(-1)' : i32

let decimal_text (~value : u64) : string = $'std::rc::Rc::<str>::from((!value).to_string())' : string

let now_ms () : u64 =
    $'std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|elapsed| elapsed.as_millis() as u64).unwrap_or(0)' : u64

inl sleep_ms (~millis : u64) : () = $'std::thread::sleep(std::time::Duration::from_millis(!millis))' : ()

let heavy_gate_script () : string =
    $'std::rc::Rc::<str>::from(std::env::var_os("EOIE_HEAVY_GATE").map(std::path::PathBuf::from).filter(|path| path.is_file()).or_else(|| std::env::current_dir().ok().and_then(|cwd| cwd.ancestors().map(|base| base.join("spiral").join("apps").join("compiler").join("tmp").join("scripts").join("heavy.ps1")).find(|candidate| candidate.is_file()))).map(|path| path.to_string_lossy().into_owned()).unwrap_or_default())' : string

let jobs_root () : string =
    $'std::rc::Rc::<str>::from(std::env::var_os("EOIE_JOBS_HOME").map(std::path::PathBuf::from).or_else(|| std::env::var_os("LOCALAPPDATA").map(|base| std::path::PathBuf::from(base).join("eoie").join("jobs"))).or_else(|| std::env::var_os("HOME").map(|base| std::path::PathBuf::from(base).join(".cache").join("eoie").join("jobs"))).unwrap_or_else(|| std::path::PathBuf::from(".eoie-jobs")).to_string_lossy().as_ref())' : string

let joined (~base : string) (~name : string) : string =
    $'std::rc::Rc::<str>::from(std::path::Path::new(&*!base).join(&*!name).to_string_lossy().as_ref())' : string

inl current_directory () : string =
    $'std::rc::Rc::<str>::from(std::env::current_dir().map(|path| path.to_string_lossy().into_owned()).unwrap_or_default())' : string

inl directory_created (~path : string) : string =
    $'std::rc::Rc::<str>::from(std::fs::create_dir_all(&*!path).err().map(|error| format\!("create {}: {error}", &*!path)).unwrap_or_default())' : string

let text_written (~path : string) (~text : string) : string =
    $'{ let temporary = format\!("{}.tmp", &*!path); std::rc::Rc::<str>::from(std::fs::write(&temporary, !text.as_bytes()).and_then(|_| std::fs::rename(&temporary, &*!path)).err().map(|error| format\!("write {}: {error}", &*!path)).unwrap_or_default()) }' : string

let text_or_empty (~path : string) : string =
    $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default())' : string

let file_bytes (~path : string) : u64 = $'std::fs::metadata(&*!path).map(|metadata| metadata.len()).unwrap_or(0)' : u64

let directory_exists (~path : string) : bool = file_system.path_buf_is_dir (file_system.new_path_buf (sm'.to_std_string path))

let file_exists (~path : string) : bool = file_system.path_buf_is_file (file_system.new_path_buf (sm'.to_std_string path))

inl newest_directories (~path : string) (~count : u64) : string =
    $'{ let mut names = std::fs::read_dir(&*!path).map(|entries| entries.filter_map(|entry| entry.ok()).filter(|entry| entry.path().is_dir()).map(|entry| entry.file_name().to_string_lossy().into_owned()).filter(|name| name.starts_with("job-")).collect::<Vec<_>>()).unwrap_or_default(); names.sort(); names.reverse(); names.truncate(!count as usize); std::rc::Rc::<str>::from(names.join("\n")) }' : string

let last_lines (~path : string) (~count : u64) : string =
    $'{ let text = std::fs::read_to_string(&*!path).unwrap_or_default(); let lines = text.lines().collect::<Vec<_>>(); let from = lines.len().saturating_sub(!count as usize); std::rc::Rc::<str>::from(lines[from..].join("\n")) }' : string

let stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()

let stderr_line (~text : string) : () = $'eprintln\!("{}", &*!text)' : ()

let supervisor_executable (~root : string) : string =
    $'{ let copy = || -> std::io::Result<std::path::PathBuf> { let source = std::env::current_exe()?; let metadata = std::fs::metadata(&source)?; let stamp = metadata.modified().ok().and_then(|time| time.duration_since(std::time::UNIX_EPOCH).ok()).map(|elapsed| elapsed.as_secs()).unwrap_or(0); let folder = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from).unwrap_or_else(std::env::temp_dir).join("eoie").join("supervisor"); std::fs::create_dir_all(&folder)?; let stem = source.file_stem().map(|stem| stem.to_string_lossy().into_owned()).unwrap_or_default(); let target = folder.join(format\!("{}-{}-{}{}", stem, metadata.len(), stamp, std::env::consts::EXE_SUFFIX)); if \!target.is_file() { let temporary = target.with_extension("tmp"); std::fs::copy(&source, &temporary)?; std::fs::rename(&temporary, &target)?; let day = std::time::Duration::from_secs(86400); for entry in std::fs::read_dir(&folder).into_iter().flatten().flatten() { let path = entry.path(); let same_stem = path.file_name().map(|name| name.to_string_lossy().starts_with(&format\!("{stem}-"))).unwrap_or(false); let stale = entry.metadata().and_then(|metadata| metadata.modified()).ok().and_then(|time| time.elapsed().ok()).map(|age| age > day).unwrap_or(false); if same_stem && stale && path \!= target { let _ = std::fs::remove_file(&path); } } } Ok(target) }; std::rc::Rc::<str>::from(copy().map(|path| path.to_string_lossy().into_owned()).unwrap_or_default()) }' : string

inl already_relaunched () : bool = $'std::env::var_os("EOIE_JOB_RELAUNCHED").is_some()' : bool

inl running_from (~executable : string) : bool =
    $'std::env::current_exe().map(|path| path.to_string_lossy() == &*!executable).unwrap_or(false)' : bool

inl relaunched_as (~executable : string) (~watch : u64) : i32 =
    $'match std::process::Command::new(&*!executable).args(std::env::args().skip(1)).env("EOIE_JOB_RELAUNCHED", "1").env("EOIE_JOB_WATCH", (!watch).to_string()).status() { Ok(status) => status.code().unwrap_or(1), Err(error) => { eprintln\!("eoie error: job relaunch: {error}"); 2 } }' : i32

inl supervisor_launched (~id : string) : string = $'eoie_job_host::eoie_job_host_request(&*!id)' : string

let parent_pid () : u64 =
    $'{ \#[cfg(windows)] fn parent() -> u64 { \#[repr(C)] struct Entry { size: u32, usage: u32, pid: u32, heap: usize, module: u32, threads: u32, parent: u32, base: i32, flags: u32, exe: [u16; 260] } unsafe extern "system" { fn CreateToolhelp32Snapshot(flags: u32, pid: u32) -> *mut std::ffi::c_void; fn Process32FirstW(snapshot: *mut std::ffi::c_void, entry: *mut Entry) -> i32; fn Process32NextW(snapshot: *mut std::ffi::c_void, entry: *mut Entry) -> i32; fn CloseHandle(handle: *mut std::ffi::c_void) -> i32; } let me = std::process::id(); unsafe { let snapshot = CreateToolhelp32Snapshot(2, 0); if snapshot as isize == -1 { return 0; } let mut entry: Entry = std::mem::zeroed(); entry.size = std::mem::size_of::<Entry>() as u32; let mut found = 0u64; let mut more = Process32FirstW(snapshot, &mut entry) \!= 0; while more { if entry.pid == me { found = entry.parent as u64; break; } more = Process32NextW(snapshot, &mut entry) \!= 0; } CloseHandle(snapshot); found } } \#[cfg(not(windows))] fn parent() -> u64 { std::os::unix::process::parent_id() as u64 } parent() }' : u64

let process_alive (~pid : u64) : bool =
    $'{ \#[cfg(windows)] fn alive(pid: u64) -> bool { unsafe extern "system" { fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *mut std::ffi::c_void; fn WaitForSingleObject(handle: *mut std::ffi::c_void, ms: u32) -> u32; fn CloseHandle(handle: *mut std::ffi::c_void) -> i32; fn GetLastError() -> u32; } if pid == 0 { return true; } unsafe { let handle = OpenProcess(0x0010_0000, 0, pid as u32); if handle.is_null() { return GetLastError() == 5; } let running = WaitForSingleObject(handle, 0) == 258; CloseHandle(handle); running } } \#[cfg(not(windows))] fn alive(pid: u64) -> bool { pid == 0 || std::os::unix::process::parent_id() as u64 == pid } alive(!pid) }' : bool

let child_container () : u64 =
    $'{ \#[cfg(windows)] fn container() -> u64 { static CONTAINER: std::sync::OnceLock<u64> = std::sync::OnceLock::new(); *CONTAINER.get_or_init(|| { unsafe extern "system" { fn CreateJobObjectW(attributes: *mut std::ffi::c_void, name: *const u16) -> *mut std::ffi::c_void; fn SetInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32) -> i32; } unsafe { let job = CreateJobObjectW(std::ptr::null_mut(), std::ptr::null()); if \!job.is_null() { let mut limits = [0u64; 18]; limits[2] = 0x2800; SetInformationJobObject(job, 9, limits.as_mut_ptr().cast(), 144); } job as u64 } }) } \#[cfg(not(windows))] fn container() -> u64 { 0 } container() }' : u64

let container_capped (~cap_mb : u64) : bool =
    inl container = child_container ()
    $'{ \#[cfg(windows)] let capped = { unsafe extern "system" { fn QueryInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32, returned: *mut u32) -> i32; fn SetInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32) -> i32; } let job = !container as *mut std::ffi::c_void; let mut limits = [0u64; 18]; \!job.is_null() && unsafe { QueryInformationJobObject(job, 9, limits.as_mut_ptr().cast(), 144, std::ptr::null_mut()) } \!= 0 && { limits[2] |= 0x200; limits[15] = (!cap_mb).saturating_mul(1048576); (unsafe { SetInformationJobObject(job, 9, limits.as_mut_ptr().cast(), 144) } \!= 0) } }; \#[cfg(not(windows))] let capped = { let _ = (!container, !cap_mb); false }; capped }' : bool

let container_peak_mb () : u64 =
    inl container = child_container ()
    $'{ \#[cfg(windows)] let peak = { unsafe extern "system" { fn QueryInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32, returned: *mut u32) -> i32; } let job = !container as *mut std::ffi::c_void; let mut limits = [0u64; 18]; if job.is_null() || unsafe { QueryInformationJobObject(job, 9, limits.as_mut_ptr().cast(), 144, std::ptr::null_mut()) } == 0 { 0 } else { limits[17] / 1048576 } }; \#[cfg(not(windows))] let peak = { let _ = !container; 0u64 }; peak }' : u64

inl logged_spawn (~argv : string) (~cwd : string) (~stdout_path : string) (~stderr_path : string) : spawn_outcome =
    inl container = child_container ()
    $'{ let mut parts = !argv.lines(); let program = parts.next().unwrap_or_default().to_owned(); let arguments = parts.map(str::to_owned).collect::<Vec<_>>(); let outcome = (|| -> std::io::Result<std::process::Child> { let stdout = std::fs::File::create(&*!stdout_path)?; let stderr = std::fs::File::create(&*!stderr_path)?; let mut command = std::process::Command::new(&program); command.args(&arguments).current_dir(&*!cwd).stdin(std::process::Stdio::null()).stdout(stdout).stderr(stderr); \#[cfg(windows)] { use std::os::windows::process::CommandExt; command.creation_flags(0x0800_0000).env_remove("NoDefaultCurrentDirectoryInExePath"); } \#[cfg(unix)] { use std::os::unix::process::CommandExt; command.process_group(0); } let child = command.spawn()?; \#[cfg(windows)] { unsafe extern "system" { fn AssignProcessToJobObject(job: *mut std::ffi::c_void, process: *mut std::ffi::c_void) -> i32; } use std::os::windows::io::AsRawHandle; if !container \!= 0 { unsafe { AssignProcessToJobObject(!container as *mut std::ffi::c_void, child.as_raw_handle()); } } } \#[cfg(not(windows))] { let _ = !container; } Ok(child) })(); outcome.map(|child| std::rc::Rc::new(std::cell::RefCell::new(child))).map_err(|error| std::rc::Rc::<str>::from(format\!("spawn {program}: {error}"))) }' : spawn_outcome

inl spawned (~outcome : spawn_outcome) : bool = $'!outcome.is_ok()' : bool

inl spawned_child (~outcome : spawn_outcome) : child_process = $'!outcome.clone().unwrap()' : child_process

inl spawn_error (~outcome : spawn_outcome) : string = $'!outcome.clone().err().unwrap_or_default()' : string

inl child_pid (~child : child_process) : u64 = $'!child.borrow().id() as u64' : u64

inl child_exit_or_running (~child : child_process) : i64 =
    $'match !child.borrow_mut().try_wait() { Ok(Some(status)) => status.code().map(|code| code as i64).unwrap_or(-2), Ok(None) => -1, Err(_) => -2 }' : i64

inl child_tree_stopped (~child : child_process) : u64 =
    inl container = child_container ()
    $'{ let mut child = !child.borrow_mut(); let root = child.id(); \#[cfg(windows)] let survivors = { unsafe extern "system" { fn TerminateJobObject(job: *mut std::ffi::c_void, code: u32) -> i32; fn QueryInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32, returned: *mut u32) -> i32; } let _ = root; let job = !container as *mut std::ffi::c_void; if \!job.is_null() { unsafe { TerminateJobObject(job, 124); } } let _ = child.kill(); let _ = child.wait(); let active = || -> u64 { let mut accounting = [0u64; 6]; if job.is_null() || unsafe { QueryInformationJobObject(job, 1, accounting.as_mut_ptr().cast(), 48, std::ptr::null_mut()) } == 0 { 0 } else { accounting[5] & 0xffff_ffff } }; let mut waited = 0u64; while active() > 0 && waited < 3000 { std::thread::sleep(std::time::Duration::from_millis(100)); waited += 100; } active() }; \#[cfg(unix)] let survivors = { let _ = !container; let _ = std::process::Command::new("kill").arg("-KILL").arg("--").arg(format\!("-{root}")).status(); let _ = child.kill(); let _ = child.wait(); std::thread::sleep(std::time::Duration::from_millis(300)); std::fs::read_dir("/proc").map(|entries| entries.filter_map(|entry| entry.ok()).filter(|entry| std::fs::read_to_string(entry.path().join("stat")).ok().and_then(|stat| stat.rsplit_once(char::from(41u8)).map(|(_, rest)| rest.split_whitespace().nth(2) == Some(root.to_string().as_str()))).unwrap_or(false)).count() as u64).unwrap_or(0) }; survivors }' : u64
