nominal record_list = $'std::rc::Rc<Vec<Vec<std::rc::Rc<str>>>>'

nominal path_list = $'std::rc::Rc<Vec<std::rc::Rc<str>>>'

nominal touched_files = $'std::rc::Rc<std::cell::RefCell<std::collections::BTreeSet<std::rc::Rc<str>>>>'

nominal query_outcome = $'std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)>'

let records_of (~encoded : string) : record_list =
    $'std::rc::Rc::new((&*!encoded).split(char::from(30u8)).map(|record| record.split(char::from(31u8)).map(std::rc::Rc::<str>::from).collect::<Vec<_>>()).collect::<Vec<_>>())' : record_list

inl record_count (~records : record_list) : i32 = $'!records.len() as i32' : i32
let field_at (~records : record_list) (~record : i32) (~field : i32) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.get(!field as usize)).cloned().unwrap_or_default()' : string
let decimal_of (~text : string) : u64 = $'!text.trim().parse::<u64>().unwrap_or(0)' : u64
inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()

let files_matching (~root : string) (~target : string) (~include : string) (~exclude : string) : path_list =
    $'{ fn wildcard(mask: &str, name: &str) -> bool { let parts = mask.split(char::from(42u8)).collect::<Vec<_>>(); if parts.len() == 1 { return mask == name; } let mut rest = name; if \!rest.starts_with(parts[0]) { return false; } rest = &rest[parts[0].len()..]; for middle in &parts[1..parts.len() - 1] { match rest.find(middle) { Some(at) => rest = &rest[at + middle.len()..], None => return false } } rest.len() >= parts[parts.len() - 1].len() && rest.ends_with(parts[parts.len() - 1]) } fn glob_match(pattern: &[&str], path: &[&str]) -> bool { match pattern.split_first() { None => path.is_empty(), Some((head, rest)) if *head == "**" => (0..=path.len()).any(|skip| glob_match(rest, &path[skip..])), Some((head, rest)) => match path.split_first() { Some((name, tail)) => wildcard(head, name) && glob_match(rest, tail), None => false } } } fn segments(text: &str) -> Vec<String> { text.replace(char::from(92u8), "/").split(char::from(47u8)).filter(|segment| \!segment.is_empty() && *segment \!= ".").map(str::to_owned).collect() } let root = std::path::Path::new(&*!root); let mut pattern = segments(&*!target); let star = char::from(42u8); let globbed = pattern.iter().any(|segment| segment.contains(star)); if \!globbed { let joined = pattern.join("/"); if \!root.join(&joined).is_dir() { return std::rc::Rc::new(vec\![std::rc::Rc::<str>::from(joined)]); } pattern.push("**".to_owned()); } let base = pattern.iter().take_while(|segment| \!segment.contains(star)).cloned().collect::<Vec<_>>(); let pattern_refs = pattern.iter().map(String::as_str).collect::<Vec<_>>(); let excluded = segments(&*!exclude); let excluded_refs = excluded.iter().map(String::as_str).collect::<Vec<_>>(); let masks = (&*!include).split(char::from(44u8)).map(str::trim).filter(|mask| \!mask.is_empty()).collect::<Vec<_>>(); let skip = [".git", "target", "node_modules", "_build", "deps"]; let mut found = Vec::new(); let mut stack = vec\![base.clone()]; while let Some(folder) = stack.pop() { let Ok(entries) = std::fs::read_dir(root.join(folder.join("/"))) else { continue }; for entry in entries.filter_map(|entry| entry.ok()) { let Ok(kind) = entry.file_type() else { continue }; if kind.is_symlink() { continue; } let name = entry.file_name().to_string_lossy().into_owned(); let mut relative = folder.clone(); relative.push(name.clone()); if kind.is_dir() { if \!skip.contains(&name.as_str()) { stack.push(relative); } continue; } let relative_refs = relative.iter().map(String::as_str).collect::<Vec<_>>(); if glob_match(&pattern_refs, &relative_refs) && (masks.is_empty() || masks.iter().any(|mask| wildcard(mask, &name))) && (excluded_refs.is_empty() || \!glob_match(&excluded_refs, &relative_refs)) { found.push(relative.join("/")); } } } found.sort(); std::rc::Rc::new(found.into_iter().map(std::rc::Rc::<str>::from).collect::<Vec<_>>()) }' : path_list

inl touched_new () : touched_files = $'std::rc::Rc::new(std::cell::RefCell::new(std::collections::BTreeSet::new()))' : touched_files
inl touched_count (~touched : touched_files) : u64 = $'!touched.borrow().len() as u64' : u64
let git_marked (~records : record_list) (~record : i32) : bool =
    $'!records.get(!record as usize).map(|fields| fields.iter().any(|field| &**field == "wgit") && fields.iter().any(|field| &**field == "wstatus")).unwrap_or(false)' : bool

let git_hits (~root : string) (~paths : path_list) (~needle : string) (~literal : bool) : query_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let source = if !literal { regex::escape(&*!needle) } else { (&*!needle).to_owned() }; let pattern = match regex::Regex::new(&source) { Ok(pattern) => pattern, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("search: invalid pattern: {error}")), [0, 0, 0, 0], true)) }; let root = std::path::PathBuf::from(&*!root); let state_of = |path: &str| { let full = root.join(path); let folder = full.parent().map(std::path::Path::to_path_buf).unwrap_or_else(|| root.clone()); let name = full.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default(); match std::process::Command::new("git").current_dir(&folder).args(["status", "--porcelain", "--untracked-files=all", "--"]).arg(&name).stdin(std::process::Stdio::null()).output() { Ok(output) if output.status.success() => { let text = String::from_utf8_lossy(&output.stdout).into_owned(); if text.trim().is_empty() { "clean" } else if text.starts_with("??") { "untracked" } else { "modified" } } _ => "no repo" } }; let mut hits: Vec<(String, String, &str)> = Vec::new(); let mut matched = 0u64; for path in !paths.iter() { let text = String::from_utf8_lossy(&std::fs::read(root.join(&**path)).unwrap_or_default()).into_owned(); let found = text.lines().enumerate().filter(|(_, line)| pattern.is_match(line)).map(|(index, line)| (format\!("{}:{}", path, index + 1), line.to_owned())).collect::<Vec<_>>(); if found.is_empty() { continue; } matched += 1; let state = state_of(path); hits.extend(found.into_iter().map(|(place, line)| (place, line, state))); } let place_width = hits.iter().map(|hit| hit.0.len()).max().unwrap_or(0); let text_width = hits.iter().map(|hit| hit.1.chars().count()).max().unwrap_or(0); let shown = hits.iter().map(|(place, line, state)| format\!("{:<place_width$}  {:<text_width$}  {}", place, line, state)).collect::<Vec<_>>(); std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [!paths.len() as u64, matched, hits.len() as u64, 0], false)) })()' : query_outcome

let touched_with (~touched : touched_files) (~paths : path_list) : () = $'!touched.borrow_mut().extend(!paths.iter().cloned())' : ()

inl outcome_report (~outcome : query_outcome) : string = $'!outcome.0.clone()' : string
inl outcome_counter (~outcome : query_outcome) (~index : u64) : u64 = $'!outcome.1[!index as usize]' : u64
inl outcome_failed (~outcome : query_outcome) : bool = $'!outcome.2' : bool

let searched (~root : string) (~paths : path_list) (~needle : string) (~literal : bool) (~before : u64) (~after : u64) (~first : u64) (~paths_only : bool) : query_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { use rayon::prelude::*; let source = if !literal { regex::escape(&*!needle) } else { (&*!needle).to_owned() }; let pattern = match regex::Regex::new(&source) { Ok(pattern) => pattern, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("search: invalid pattern: {error}")), [0, 0, 0, 0], true)) }; let root = std::path::PathBuf::from(&*!root); let paths = !paths.iter().map(|path| path.to_string()).collect::<Vec<_>>(); let hits = paths.par_iter().filter_map(|path| { let bytes = std::fs::read(root.join(path)).ok()?; let text = String::from_utf8_lossy(&bytes).into_owned(); let lines = text.lines().map(str::to_owned).collect::<Vec<_>>(); let found = lines.iter().enumerate().filter(|(_, line)| pattern.is_match(line)).map(|(index, _)| index).collect::<Vec<_>>(); if found.is_empty() { None } else { Some((path.clone(), found, lines)) } }).collect::<Vec<_>>(); let (before, after, first) = (!before as usize, !after as usize, !first as usize); let clip = |line: &str| if line.chars().count() > 240 { format\!("{}...", line.chars().take(240).collect::<String>()) } else { line.to_owned() }; let mut shown = Vec::new(); let mut total = 0u64; for (path, found, lines) in &hits { total += found.len() as u64; let taken = if first > 0 { found.iter().copied().take(first).collect::<Vec<_>>() } else { found.clone() }; if !paths_only { for index in &taken { shown.push(format\!("{}:{}", path, index + 1)); } continue; } shown.push(path.clone()); let last_line = taken.iter().map(|index| (index + after).min(lines.len() - 1)).max().unwrap_or(0); let width = (last_line + 1).to_string().len(); let mut printed: Option<usize> = None; for index in &taken { let start = index.saturating_sub(before).max(printed.map_or(0, |line| line + 1)); let end = (index + after).min(lines.len() - 1); for line in start..=end { let marker = if taken.contains(&line) { char::from(62u8) } else { char::from(32u8) }; shown.push(format\!("{:>width$}{} {}", line + 1, marker, clip(&lines[line]))); } printed = Some(printed.map_or(end, |line| line.max(end))); } } if shown.len() > 4000 { let hidden = shown.len() - 4000; shown.truncate(4000); shown.push(format\!("... {hidden} more lines (narrow the search or use first n per file)")); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [paths.len() as u64, hits.len() as u64, total, 0], false)) })()' : query_outcome

let around (~root : string) (~path : string) (~needle : string) (~before : u64) (~after : u64) : query_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let path = &*!path; let text = match std::fs::read(std::path::Path::new(&*!root).join(path)) { Ok(bytes) => String::from_utf8_lossy(&bytes).into_owned(), Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  unreadable: {error}")), [1, 0, 0, 0], true)) }; let lines = text.lines().collect::<Vec<_>>(); let found = lines.iter().enumerate().filter(|(_, line)| line.contains(&*!needle)).map(|(index, _)| index).collect::<Vec<_>>(); if found.is_empty() { return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("{path}  no match for {:?}", &*!needle)), [1, 0, 0, 0], true)); } let (before, after) = (!before as usize, !after as usize); let numbers = found.iter().map(|index| (index + 1).to_string()).collect::<Vec<_>>().join(","); let mut shown = vec\![if found.len() == 1 { format\!("{path}  match at line {numbers}") } else { format\!("{path}  matches at lines {numbers}") }]; let last_line = found.iter().map(|index| (index + after).min(lines.len() - 1)).max().unwrap_or(0); let width = (last_line + 1).to_string().len(); let mut printed: Option<usize> = None; let mut count = 0u64; for index in &found { let start = index.saturating_sub(before).max(printed.map_or(0, |line| line + 1)); let end = (index + after).min(lines.len() - 1); for line in start..=end { let marker = if found.contains(&line) { char::from(62u8) } else { char::from(32u8) }; shown.push(format\!("{:>width$}{} {}", line + 1, marker, lines[line])); count += 1; } printed = Some(printed.map_or(end, |line| line.max(end))); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [1, found.len() as u64, count, 0], false)) })()' : query_outcome

let listing (~root : string) (~paths : path_list) : query_outcome =
    $'{ let root = std::path::Path::new(&*!root); let rows = !paths.iter().map(|path| (path.to_string(), std::fs::read(root.join(&**path)).ok().map(|bytes| (bytes.len() as u64, String::from_utf8_lossy(&bytes).lines().count() as u64)))).collect::<Vec<_>>(); let path_width = rows.iter().map(|row| row.0.len()).max().unwrap_or(0).max(4); let bytes_width = rows.iter().map(|row| row.1.map(|counts| counts.0.to_string().len()).unwrap_or(1)).max().unwrap_or(0).max(5); let mut shown = vec\![format\!("{:<path_width$}  {:<bytes_width$}  {}", "path", "bytes", "lines")]; let mut tally = [rows.len() as u64, 0, 0, 0]; let mut failed = false; for (path, counts) in &rows { match counts { Some((bytes, lines)) => { tally[1] += bytes; tally[2] += lines; shown.push(format\!("{:<path_width$}  {:<bytes_width$}  {}", path, bytes, lines)); } None => { failed = true; shown.push(format\!("{:<path_width$}  {:<bytes_width$}  unreadable", path, "-")); } } } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), tally, failed)) }' : query_outcome

let edge_lines (~root : string) (~paths : path_list) (~count : u64) (~from_end : bool) : query_outcome =
    $'{ let root = std::path::Path::new(&*!root); let count = !count as usize; let from_end = !from_end; let files = !paths.iter().map(|path| (path.to_string(), std::fs::read(root.join(&**path)).ok().map(|bytes| String::from_utf8_lossy(&bytes).lines().map(str::to_owned).collect::<Vec<_>>()))).collect::<Vec<_>>(); let mut failed = false; let mut shown = Vec::new(); let path_width = files.iter().map(|file| file.0.len()).max().unwrap_or(0); for (path, lines) in &files { let Some(lines) = lines else { failed = true; shown.push(format\!("{path}  unreadable")); continue }; let first = if from_end { lines.len().saturating_sub(count) } else { 0 }; let last = if from_end { lines.len() } else { count.min(lines.len()) }; if count == 1 { shown.push(format\!("{:<path_width$}  {}", path, lines.get(first).map(String::as_str).unwrap_or("(empty)"))); continue; } shown.push(format\!("{path} ({} {} lines)", if from_end { "last" } else { "first" }, count)); let width = last.to_string().len(); for index in first..last { if from_end { shown.push(lines[index].clone()); } else { shown.push(format\!("{:<width$}  {}", index + 1, lines[index])); } } } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), [files.len() as u64, 0, 0, 0], failed)) }' : query_outcome

let waited (~root : string) (~path : string) (~needle : string) (~timeout_ms : u64) : query_outcome =
    $'(|| -> std::rc::Rc<(std::rc::Rc<str>, [u64; 4], bool)> { let pattern = match regex::Regex::new(&*!needle) { Ok(pattern) => pattern, Err(error) => return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("wait: invalid pattern: {error}")), [1, 0, 0, 0], true)) }; let path = &*!path; let file = std::path::Path::new(&*!root).join(path); let started = std::time::Instant::now(); let timeout = !timeout_ms; let limit = std::time::Duration::from_millis(timeout); let elapsed_text = |millis: u128| if millis < 10000 { format\!("{millis}ms") } else { format\!("{:.1}s", millis as f64 / 1000.0) }; let timeout_text = if timeout % 1000 == 0 { format\!("{}s", timeout / 1000) } else { format\!("{timeout}ms") }; loop { let text = std::fs::read(&file).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); if let Some((index, line)) = text.lines().enumerate().find(|(_, line)| pattern.is_match(line)) { return std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("wait {path}  matched {:?} at line {} after {}", line, index + 1, elapsed_text(started.elapsed().as_millis()))), [1, 0, 0, 0], false)); } if started.elapsed() >= limit { let lines = text.lines().collect::<Vec<_>>(); let last = lines.last().copied().unwrap_or("(empty)"); let report = [format\!("wait {path}  no match for {:?} in {timeout_text}  lines {}  bytes {}", &*!needle, lines.len(), text.len()), format\!("{path} (last 1 line)"), last.to_owned()].join(&char::from(10u8).to_string()); return std::rc::Rc::new((std::rc::Rc::<str>::from(report), [1, 1, 0, 0], true)); } std::thread::sleep(std::time::Duration::from_millis(100)); } })()' : query_outcome