open rust_std_string.model
open eoie_memory_model.model

let rec dangling_in (~body : string) (from : i32) (~slugs : string) (~file : string) (~acc : string) : string =
    inl opening = index_of body "[[" from
    inl close = if opening < 0i32 then -1i32 else index_of body "]]" opening
    if close < 0i32 then acc
    else
        inl target = text_between body (opening + 2i32) close
        inl known = contains slugs (concat5 "\n" target "\n" "" "")
        dangling_in body (close + 2i32) slugs file (if known then acc else concat5 acc file ": dangling [[" target "]]\n")

let rec slug_lines (list : memory_list) (~acc : string) : string =
    match list with
    | NoMemories => acc
    | MemoryThen (entry, rest) => slug_lines rest (concat5 acc entry.slug "\n" "" "")

let rec file_lines (list : memory_list) (~acc : string) : string =
    match list with
    | NoMemories => acc
    | MemoryThen (entry, rest) => file_lines rest (concat5 acc entry.file "\n" "" "")

type check_tally =
    {
        lines : string
        dangling : i32
        reasons : i32
        unindexed : i32
    }

let rec checked (list : memory_list) (~slugs : string) (~index : string) (tally : check_tally) : check_tally =
    match list with
    | NoMemories => tally
    | MemoryThen (entry, rest) =>
        inl dangling = dangling_in entry.body 0i32 slugs entry.file ""
        inl dangling_count = $'(!dangling).lines().count() as i32' : i32
        inl reasoned = contains entry.body "**Why:**" && contains entry.body "**How to apply:**"
        inl reason_line = if needs_reasons entry.kind && reasoned = false then concat5 entry.file ": " (kind_word entry.kind) " without **Why:** and **How to apply:**\n" "" else ""
        inl indexed = contains index (concat5 "](" entry.file ")" "" "")
        inl index_line = if indexed then "" else concat5 entry.file ": missing from MEMORY.md\n" "" "" ""
        checked rest slugs index { lines = concat5 tally.lines dangling reason_line index_line ""; dangling = tally.dangling + dangling_count; reasons = tally.reasons + (if reason_line = "" then 0i32 else 1i32); unindexed = tally.unindexed + (if indexed then 0i32 else 1i32) }

let rec index_targets_missing (~index : string) (from : i32) (~files : string) (~acc : string) : string =
    inl opening = index_of index "](" from
    inl close = if opening < 0i32 then -1i32 else index_of index ")" opening
    if close < 0i32 then acc
    else
        inl target = text_between index (opening + 2i32) close
        inl present = contains files (concat5 "\n" target "\n" "" "")
        index_targets_missing index (close + 1i32) files (if present || ends_with target ".md" = false then acc else concat5 acc "MEMORY.md: entry for missing " target "\n" "")

let memory_check (~data : string) : i32 =
    if file_present data = false then failed (concat5 "check needs a readable data file: " data "" "" "")
    else
        inl store = store_of (exact_text data)
        inl slugs = slug_lines store.memories "\n"
        inl tally = checked store.memories slugs store.index { lines = ""; dangling = 0i32; reasons = 0i32; unindexed = 0i32 }
        inl missing = index_targets_missing store.index 0i32 (file_lines store.memories "\n") ""
        inl missing_count = $'(!missing).lines().count() as i32' : i32
        inl problems = tally.reasons + tally.unindexed + missing_count
        inl report = concat5 tally.lines missing store.problems "" ""
        $'print\!("{}", &*!report)' : ()
        inl counts = concat5 " memories=" (count_text store.count) " dangling_links=" (count_text tally.dangling) " missing_reasons="
        stdout_line (concat5 (if problems = 0i32 then "eoie memory check ok" else "eoie memory check failed") counts (count_text tally.reasons) (concat5 " unindexed=" (count_text tally.unindexed) " index_missing=" (count_text missing_count) "") "")
        if problems = 0i32 then 0i32 else 1i32

let rec listed (list : memory_list) (~kind : string) (shown : i32) : i32 =
    match list with
    | NoMemories => shown
    | MemoryThen (entry, rest) =>
        if kind = "" || kind = kind_word entry.kind then
            stdout_line (concat5 (kind_word entry.kind) "  " entry.slug "  " (clipped entry.description 100i32))
            listed rest kind (shown + 1i32)
        else listed rest kind shown

let memory_list_run (~data : string) (~kind : string) : i32 =
    if file_present data = false then failed (concat5 "list needs a readable data file: " data "" "" "")
    else
        match (if kind = "" then KindKnown KindUser else kind_of_word kind) with
        | KindUnknown => failed (concat5 "list --kind expects " (union_reflection.cases.union_cases_joined kind_word "|") ", got " kind "")
        | KindKnown _ =>
            inl shown = listed (store_of (exact_text data)).memories kind 0i32
            stdout_line (concat5 "eoie memory list ok shown=" (count_text shown) (if kind = "" then "" else concat5 " kind=" kind "" "" "") "" "")
            0i32

inl lowered (~text : string) : string = $'std::rc::Rc::<str>::from((!text).to_lowercase().as_str())' : string
inl occurrences (~text : string) (~word : string) : i32 = $'(!text).matches(&*!word).count() as i32' : i32
inl query_words (~query : string) : string = $'std::rc::Rc::<str>::from((!query).to_lowercase().split_whitespace().collect::<Vec<_>>().join("\n").as_str())' : string

let rec query_score (~words : string) (entry : memory_entry) (score : i32) : i32 =
    if words = "" then score
    else
        inl word = first_line words
        inl gained = 5i32 * occurrences (lowered entry.slug) word + 3i32 * occurrences (lowered entry.description) word + occurrences (lowered entry.body) word
        query_score (rest_lines words) entry (score + gained)

union rec ranked =
    | NoRanked
    | RankedThen : i32 * memory_entry * ranked

let rec ranked_inserted (score : i32) (entry : memory_entry) (list : ranked) : ranked =
    match list with
    | NoRanked => RankedThen (score, entry, NoRanked)
    | RankedThen (head_score, head, rest) =>
        if score > head_score || (score = head_score && text_before entry.slug head.slug) then RankedThen (score, entry, list)
        else RankedThen (head_score, head, ranked_inserted score entry rest)

let rec ranked_from (list : memory_list) (~words : string) (acc : ranked) : ranked =
    match list with
    | NoMemories => acc
    | MemoryThen (entry, rest) =>
        inl score = query_score words entry 0i32
        ranked_from rest words (if score > 0i32 then ranked_inserted score entry acc else acc)

let rec ranked_printed (list : ranked) (limit : i32) (shown : i32) : i32 =
    match list with
    | NoRanked => shown
    | RankedThen (score, entry, rest) =>
        if shown < limit then
            stdout_line (concat5 (count_text score) "  " (kind_word entry.kind) "  " (concat5 entry.slug "  " (clipped entry.description 100i32) "" ""))
            ranked_printed rest limit (shown + 1i32)
        else shown

let memory_recall (~data : string) (~query : string) (limit : i32) : i32 =
    if file_present data = false then failed (concat5 "recall needs a readable data file: " data "" "" "")
    elif query_words query = "" then failed "recall needs query words"
    else
        inl store = store_of (exact_text data)
        inl shown = ranked_printed (ranked_from store.memories (query_words query) NoRanked) limit 0i32
        stdout_line (concat5 "eoie memory recall ok shown=" (count_text shown) " of=" (count_text store.count) (concat5 " query=" query "" "" ""))
        0i32

inl main () : i32 =
    !!!!Export("eoie_memory_check", ((fun data => memory_check data) : string -> i32))
    !!!!Export("eoie_memory_list", ((fun (data, kind) => memory_list_run data kind) : string * string -> i32))
    !!!!Export("eoie_memory_recall", ((fun (data, query, limit) => memory_recall data query limit) : string * string * i32 -> i32))
    0i32
