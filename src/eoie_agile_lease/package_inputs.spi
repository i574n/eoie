inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () = rust_global "pub fn agile_package_input_fingerprint(state_dir: &Path, include_state: bool) -> Option<u64> {\n    fn absolute(path: &Path) -> Option<PathBuf> {\n        let path = if path.is_absolute() { path.to_owned() } else { std::env::current_dir().ok()?.join(path) };\n        let mut result = PathBuf::new();\n        for part in path.components() {\n            match part {\n                std::path::Component::CurDir => {},\n                std::path::Component::ParentDir => { eoie_rust_std_fs::rooted_canonical_directory(&result).ok()?; if !result.pop() { return None; } },\n                _ => result.push(part.as_os_str()),\n            }\n        }\n        Some(result)\n    }\n    fn name(value: &str) -> bool {\n        let mut chars = value.chars();\n        chars.next().is_some_and(|c| c.is_ascii_lowercase() || c == '_')\n            && chars.all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '\\'')\n    }\n    struct Graph {\n        root: PathBuf,\n        active: std::collections::BTreeSet<PathBuf>,\n        visited: std::collections::BTreeSet<PathBuf>,\n        records: std::collections::BTreeMap<PathBuf, String>,\n        bytes_left: usize,\n    }\n    impl Graph {\n        fn file(&mut self, path: &Path) -> Option<Vec<u8>> {\n            if self.records.len() >= 4096 { return None; }\n            let bytes = eoie_rust_std_fs::read_regular_limited(path, self.bytes_left.min(8 * 1024 * 1024)).ok()?;\n            self.bytes_left = self.bytes_left.checked_sub(bytes.len())?;\n            self.records.insert(path.to_owned(), eoie_proxy_search::inspection_sha256(bytes.clone()));\n            Some(bytes)\n        }\n        fn package(&mut self, directory: PathBuf, include_state: bool, depth: usize) -> Option<()> {\n            if depth > 64 || self.active.contains(&directory) { return None; }\n            if self.visited.contains(&directory) { return Some(()); }\n            if self.visited.len() + self.active.len() >= 256 { return None; }\n            self.active.insert(directory.clone());\n            let source = String::from_utf8(self.file(&directory.join(\"package.spiproj\"))?).ok()?;\n            let mut module_dir = directory.clone();\n            let mut package_dir = directory.parent()?.to_owned();\n            let mut section = \"\";\n            let mut fields = std::collections::BTreeSet::new();\n            let mut modules = Vec::new();\n            let mut packages = Vec::new();\n            for raw in source.lines() {\n                if raw.trim().is_empty() { continue; }\n                if raw.starts_with(' ') {\n                    let value = raw.strip_prefix(\"    \")?;\n                    if value.starts_with(char::is_whitespace) || value.trim_end() != value { return None; }\n                    match section {\n                        \"modules\" => {\n                            let stem = value.strip_suffix('-').unwrap_or(value);\n                            let (stem, extension) = match stem.strip_suffix('*') { Some(stem) => (stem, \"spir\"), None => (stem, \"spi\") };\n                            if !name(stem) { return None; }\n                            modules.push(format!(\"{stem}.{extension}\"));\n                        },\n                        \"packages\" => {\n                            let stem = value.strip_suffix('-').unwrap_or(value);\n                            if !name(stem) { return None; }\n                            packages.push(stem.to_owned());\n                        },\n                        _ => return None,\n                    }\n                } else {\n                    let (key, value) = raw.split_once(':')?;\n                    if !fields.insert(key) { return None; }\n                    let value = value.trim();\n                    match key {\n                        \"modules\" | \"packages\" if value.is_empty() => section = key,\n                        \"moduleDir\" | \"packageDir\" if !value.is_empty() => {\n                            let path = Path::new(value);\n                            if path.is_absolute() || value.contains(':') || value.contains('\\\\') { return None; }\n                            let resolved = absolute(&directory.join(path))?;\n                            let mut cursor = directory.clone();\n                            for part in path.components() {\n                                match part {\n                                    std::path::Component::Normal(p) => cursor.push(p),\n                                    std::path::Component::ParentDir => { cursor.pop(); },\n                                    std::path::Component::CurDir => {},\n                                    _ => return None,\n                                }\n                                eoie_rust_std_fs::rooted_canonical_directory(&cursor).ok()?;\n                            }\n                            if key == \"moduleDir\" { module_dir = resolved; } else { package_dir = resolved; }\n                            section = \"\";\n                        },\n                        _ => return None,\n                    }\n                }\n            }\n            if directory == self.root && (module_dir != directory || modules.iter().any(|name| !name.ends_with(\".spi\"))) { return None; }\n            for module in modules {\n                let path = module_dir.join(module);\n                if directory != self.root || include_state { self.file(&path)?; }\n                else { eoie_rust_std_fs::rooted_open_regular_read(&path).ok()?; }\n            }\n            for package in packages { self.package(package_dir.join(package), include_state, depth + 1)?; }\n            self.active.remove(&directory);\n            self.visited.insert(directory);\n            Some(())\n        }\n    }\n    let root = absolute(state_dir)?;\n    eoie_rust_std_fs::rooted_canonical_directory(&root).ok()?;\n    let mut graph = Graph { root: root.clone(), active: Default::default(), visited: Default::default(), records: Default::default(), bytes_left: 64 * 1024 * 1024 };\n    graph.package(root.clone(), include_state, 0)?;\n    let base = root.parent()?;\n    let mut identity = String::from(\"agile-package-inputs-v1\\n\");\n    for (path, hash) in graph.records {\n        let path = path.strip_prefix(base).unwrap_or(&path).to_str()?.replace('\\\\', \"/\");\n        identity.push_str(&format!(\"{}:{path}:{hash}\\n\", path.len()));\n    }\n    let hash = eoie_proxy_search::inspection_sha256(identity.into_bytes());\n    u64::from_str_radix(&hash[..16], 16).ok()\n}\n"
