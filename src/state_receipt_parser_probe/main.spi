open rust_std_env.model

inl parse_exit (~input : string) (~expected : string) : i32 =
    $'if state_receipt_parser_domain::eoie_state_receipt_parse(!input.as_ref()).as_ref() == !expected.as_ref() { 0 } else { 1 }' : i32

inl main () : i32 =
    inl source = """
        union state_check_snapshot = | StateCheckSnapshot :: u64 -> state_check_snapshot
        union module_attestation = | RuntimeAttestation | BuildAttestation :: u64 -> module_attestation
        union module_typecheck_receipt = | ModuleTypecheckReceipt :: string * u64 * u64 * module_attestation -> module_typecheck_receipt

        inl snapshot () : state_check_snapshot = StateCheckSnapshot 42u64
        inl receipt_0000 () : module_typecheck_receipt = ModuleTypecheckReceipt ("alpha.spi", 12u64, 34u64, BuildAttestation 99u64)
        inl main () : i32 = 0i32

        """
    inl expected = "snapshot\t42\nmodule\talpha.spi\t12\t34\tbuild:99\n"
    parse_exit source expected
