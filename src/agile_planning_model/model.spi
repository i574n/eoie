open workspace_primitives.outcome
open sm'_operators
open workspace_primitives.numbers
open workspace_primitives.bytes
open agile_task_text.model

union task_load =
    | LoadLight
    | LoadMedium
    | LoadHeavy

union task_assignee =
    | AssigneeAgent
    | AssigneePair
    | AssigneeUser

union planned_estimate =
    | Unestimated
    | EstimateMinutes : i32

union planned_load =
    | LoadUnset
    | PlannedLoad : task_load

union planned_assignee =
    | Unassigned
    | PlannedAssignee : task_assignee

type task_planning =
    {
        estimate : planned_estimate
        load : planned_load
        assignee : planned_assignee
    }

union planning_field =
    | FieldEstimate
    | FieldLoad
    | FieldAssignee

inl unplanned () : task_planning = { estimate = Unestimated; load = LoadUnset; assignee = Unassigned }

inl parse_case_named forall t. (name : t -> string) (~text : string) : validation_result t =
    union_reflection.cases.union_cases_fold
        (fun parsed (case_value : t) => if (text = (name case_value)) then Valid case_value else parsed)
        Invalid

inl task_load_case (load : task_load) : string = union_reflection.cases.union_case_suffix "Load" load
inl task_assignee_case (assignee : task_assignee) : string = union_reflection.cases.union_case_suffix "Assignee" assignee
inl task_load_name (load : task_load) : string = ascii_lowercase (task_load_case load)
inl task_assignee_name (assignee : task_assignee) : string = ascii_lowercase (task_assignee_case assignee)

inl planning_field_name (field : planning_field) : string = ascii_lowercase (union_reflection.cases.union_case_suffix "Field" field)
inl parse_planning_field (~text : string) : validation_result planning_field = parse_case_named planning_field_name text
union cleared_word =
    | ClearedNone
    | ClearedDash

inl cleared_text (word : cleared_word) : string =
    match word with
    | ClearedNone => "none"
    | ClearedDash => "-"

inl cleared_value (~text : string) : bool = union_reflection.cases.union_case_where (fun (word : cleared_word) => text = cleared_text word) (fun _ => true) false

let parse_planned_load (~text : string) : validation_result planned_load =
    inl lowered = ascii_lowercase text
    if cleared_value lowered then Valid LoadUnset
    else
        match parse_case_named task_load_name lowered with
        | Valid load => Valid (PlannedLoad load)
        | Invalid => Invalid

let parse_planned_assignee (~text : string) : validation_result planned_assignee =
    inl lowered = ascii_lowercase text
    if cleared_value lowered then Valid Unassigned
    else
        match parse_case_named task_assignee_name lowered with
        | Valid assignee => Valid (PlannedAssignee assignee)
        | Invalid => Invalid

inl planned_or_unset (parsed : validation_result planned_load) : planned_load =
    match parsed with
    | Valid load => load
    | Invalid => LoadUnset

inl assigned_or_unset (parsed : validation_result planned_assignee) : planned_assignee =
    match parsed with
    | Valid assignee => assignee
    | Invalid => Unassigned

union estimate_unit =
    | MinuteUnit
    | HourUnit

inl estimate_unit_factor = function
    | MinuteUnit => 1i32
    | HourUnit => 60i32

inl estimate_digit_limit () : i32 = 6i32
inl ascii_zero () : i32 = 48i32
inl ascii_digit (code : i32) : bool = if ascii_zero () <= code then code <= 57i32 else false
inl decimal_step (value : i32) (code : i32) : i32 = $"!value * 10 + !code - 48"
inl i32_scaled (value : i32) (factor : i32) : i32 = $"!value * !factor"

let rec decimal_digits_value (text : string) (offset : i32) (length : i32) (value : i32) : i32 =
    if length <= offset then value
    elif ascii_digit (byte_at text offset) then decimal_digits_value text (offset + 1i32) length (decimal_step value (byte_at text offset))
    else -1i32

let decimal_value (~digits : string) : validation_result i32 =
    inl length = byte_len digits
    if length <= 0i32 then Invalid
    elif length <= estimate_digit_limit () then
        inl value = decimal_digits_value digits 0i32 length 0i32
        if value < 0i32 then Invalid else Valid value
    else Invalid

inl estimate_unit_of (~text : string) : estimate_unit =
    if sm'.ends_with "h" text then HourUnit else MinuteUnit

inl estimate_digits (~text : string) : string =
    if sm'.ends_with "h" text then byte_slice text 0i32 (byte_len text - 1i32)
    elif sm'.ends_with "m" text then byte_slice text 0i32 (byte_len text - 1i32)
    else text

inl estimate_minute_ceiling () : i32 = 999999i32

inl bounded_estimate (minutes : i32) : validation_result planned_estimate =
    if minutes <= estimate_minute_ceiling () then Valid (EstimateMinutes minutes) else Invalid

let parse_planned_estimate (~text : string) : validation_result planned_estimate =
    if cleared_value text then Valid Unestimated
    else
        match decimal_value (estimate_digits text) with
        | Valid value => bounded_estimate (i32_scaled value (estimate_unit_factor (estimate_unit_of text)))
        | Invalid => Invalid

inl planning_field_rule = function
    | FieldEstimate => "estimate must be whole minutes (360, 360m) or hours (6h), at most 999999 minutes, or none"
    | FieldLoad => "load must be light, medium, heavy or none"
    | FieldAssignee => "assignee must be agent, pair, user or none"

inl task_load_code = function
    | LoadLight => 1i32
    | LoadMedium => 2i32
    | LoadHeavy => 3i32

inl task_assignee_code = function
    | AssigneeAgent => 1i32
    | AssigneePair => 2i32
    | AssigneeUser => 3i32

inl planned_load_code = function
    | LoadUnset => 0i32
    | PlannedLoad load => task_load_code load

inl planned_assignee_code = function
    | Unassigned => 0i32
    | PlannedAssignee assignee => task_assignee_code assignee

inl planned_minutes = function
    | Unestimated => 0i32
    | EstimateMinutes minutes => minutes

inl estimate_known = function
    | Unestimated => false
    | EstimateMinutes _ => true

inl estimate_text = function
    | Unestimated => "-"
    | EstimateMinutes minutes => (i32_text minutes) ++# "m"

inl load_text = function
    | LoadUnset => "-"
    | PlannedLoad load => task_load_name load

inl assignee_text = function
    | Unassigned => "-"
    | PlannedAssignee assignee => task_assignee_name assignee

inl json_quoted (~text : string) : string = "\"" ++# text ++# "\""

inl estimate_json = function
    | Unestimated => "null"
    | EstimateMinutes minutes => i32_text minutes

inl load_json = function
    | LoadUnset => "null"
    | PlannedLoad load => json_quoted (task_load_name load)

inl assignee_json = function
    | Unassigned => "null"
    | PlannedAssignee assignee => json_quoted (task_assignee_name assignee)

let planning_json_fields (plan : task_planning) : string =
    inl estimate = "\"estimate_minutes\":" ++# (estimate_json plan.estimate) ++# ",\"load\":" ++# (load_json plan.load)
    estimate ++# ",\"assignee\":" ++# (assignee_json plan.assignee)

let planning_summary (plan : task_planning) : string =
    inl estimate = "estimate=" ++# (estimate_text plan.estimate) ++# " load=" ++# (load_text plan.load)
    estimate ++# " assignee=" ++# (assignee_text plan.assignee)

inl estimate_state_token = function
    | Unestimated => "Unestimated"
    | EstimateMinutes minutes => "Minutes " ++# (i32_text minutes) ++# "u32"

inl load_state_token = function
    | LoadUnset => "LoadUnset"
    | PlannedLoad load => "Load " ++# (task_load_case load)

inl assignee_state_token = function
    | Unassigned => "Unassigned"
    | PlannedAssignee assignee => "Assigned " ++# (task_assignee_case assignee)

inl estimate_of_token (~token : string) : planned_estimate =
    if sm'.starts_with "Minutes " token then
        match decimal_value (sm'.replace "u32" "" (byte_slice token 8i32 (byte_len token))) with
        | Valid minutes => EstimateMinutes minutes
        | Invalid => Unestimated
    else Unestimated

inl load_of_token (~token : string) : planned_load =
    if sm'.starts_with "Load " token then planned_or_unset (parse_planned_load (byte_slice token 5i32 (byte_len token)))
    else LoadUnset

inl assignee_of_token (~token : string) : planned_assignee =
    if sm'.starts_with "Assigned " token then assigned_or_unset (parse_planned_assignee (byte_slice token 9i32 (byte_len token)))
    else Unassigned

inl schema_cases forall t. (case_text : t -> string) (type_name : string) : string =
    union_reflection.cases.union_cases_joined (fun (case_value : t) => !!!!StaticStringConcat(case_text case_value, !!!!StaticStringConcat(" :: ", type_name))) " | "

inl planning_schema () : string =
    inl loads = "union task_load =\n    | " ++# (schema_cases task_load_case "task_load") ++# """



        """
    inl assignees = "union task_assignee =\n    | " ++# (schema_cases task_assignee_case "task_assignee") ++# """



        """
    inl estimates = """
        union planned_estimate =
            | Unestimated :: planned_estimate | Minutes :: u32 -> planned_estimate


        """
    inl options = """
        union planned_load =
            | LoadUnset :: planned_load | Load :: task_load -> planned_load

        union planned_assignee =
            | Unassigned :: planned_assignee | Assigned :: task_assignee -> planned_assignee


        """
    loads ++# assignees ++# estimates ++# options ++# "union task_planning =\n    | Planning :: string * planned_estimate * planned_load * planned_assignee -> task_planning"

inl planning_schema_marker () : string = "union task_planning ="
inl agile_item_marker () : string = "-> agile_item"
inl planning_arguments_offset () : i32 = 10i32

inl planning_anchor (~id : string) : string = "Planning (\"" ++# id ++# "\","
inl task_anchor (~id : string) : string = "Task (\"" ++# id ++# "\","
inl planning_binding (~id : string) : string = "planning_of_" ++# (ascii_lowercase (sm'.replace "-" "_" id))

type planning_tokens =
    {
        estimate_token : string
        load_token : string
        assignee_token : string
    }

inl unset_tokens () : planning_tokens = { estimate_token = "Unestimated"; load_token = "LoadUnset"; assignee_token = "Unassigned" }

inl tokens_with (field : planning_field) (~token : string) (tokens : planning_tokens) : planning_tokens =
    match field with
    | FieldEstimate => { tokens with estimate_token = token }
    | FieldLoad => { tokens with load_token = token }
    | FieldAssignee => { tokens with assignee_token = token }

let planning_row (~id : string) (tokens : planning_tokens) : string =
    inl head = "inl " ++# (planning_binding id) ++# " () = Planning (" ++# (spi_quoted id) ++# ", "
    inl tail = tokens.estimate_token ++# ", " ++# tokens.load_token ++# ", " ++# tokens.assignee_token
    head ++# tail ++# ")"

let rec declared_from (text : string) (~needle : string) (offset : i32) : i32 =
    inl found = byte_find_from text needle offset
    if found < 0i32 then found
    elif declared_task text found then found
    else declared_from text needle (found + 1i32)

inl planning_offset (text : string) (~id : string) : i32 = declared_from text (planning_anchor id) 0i32

let byte_find_between (text : string) (~needle : string) (start : i32) (stop : i32) : i32 =
    $'(!text).get(!start as usize..!stop as usize).and_then(|slice| slice.find(&*!needle)).map(|at| at as i32 + !start).unwrap_or(-1)' : i32

let planning_offset_near (text : string) (~id : string) (start : i32) : i32 =
    inl next = byte_find_from text "Task (\"" (start + 1i32)
    inl found = byte_find_between text (planning_anchor id) start (if next < 0i32 then byte_len text else next)
    if found >= 0i32 && declared_task text found then found else (-1i32)
let planning_at (text : string) (found : i32) : task_planning =
    inl field = tuple_field text ($"!found + !(planning_arguments_offset ())" : i32) (byte_len text)
    { estimate = estimate_of_token (field 1i32); load = load_of_token (field 2i32); assignee = assignee_of_token (field 3i32) }

let planning_of (text : string) (~id : string) : task_planning =
    inl found = planning_offset text id
    if found < 0i32 then unplanned () else planning_at text found

let planning_near (text : string) (~id : string) (start : i32) : task_planning =
    inl found = planning_offset_near text id start
    if found < 0i32 then unplanned () else planning_at text found

let planning_tokens_of (text : string) (~id : string) : planning_tokens =
    inl found = planning_offset text id
    if found < 0i32 then unset_tokens ()
    else
        inl field = tuple_field text ($"!found + !(planning_arguments_offset ())" : i32) (byte_len text)
        { estimate_token = field 1i32; load_token = field 2i32; assignee_token = field 3i32 }

inl line_end_after (text : string) (offset : i32) : i32 =
    inl found = byte_find_from text "\n" offset
    if found < 0i32 then byte_len text else found

inl spliced (text : string) (start : i32) (stop : i32) (~middle : string) : string =
    (byte_slice text 0i32 start) ++# middle ++# (byte_slice text stop (byte_len text))

let planning_upserted (text : string) (~id : string) (tokens : planning_tokens) : validation_result string =
    inl task = byte_find text (task_anchor id)
    if task < 0i32 then Invalid
    else
        inl existing = planning_offset text id
        if existing < 0i32 then
            inl stop = line_end_after text task
            Valid (spliced text stop stop ("\n" ++# (planning_row id tokens)))
        else Valid (spliced text (line_start_before text existing) (line_end_after text existing) (planning_row id tokens))

let planning_schema_ensured (text : string) : string =
    if byte_find text (planning_schema_marker ()) < 0i32 then
        inl item = byte_find text (agile_item_marker ())
        if item < 0i32 then (planning_schema ()) ++# """



            """ ++# text
        else
            inl stop = line_end_after text item
            spliced text stop stop ("""



                """ ++# (planning_schema ()))
    else text
