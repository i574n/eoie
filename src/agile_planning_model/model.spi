open workspace_primitives.outcome
open workspace_primitives.numbers
open workspace_primitives.bytes
open agile_task_text.model

union task_load =
    | LoadLight
    | LoadMedium
    | LoadHeavy

union task_assignee =
    | AssigneeAgent
    | AssigneePair
    | AssigneeUser

union planned_estimate =
    | Unestimated
    | EstimateMinutes : i32

union planned_load =
    | LoadUnset
    | PlannedLoad : task_load

union planned_assignee =
    | Unassigned
    | PlannedAssignee : task_assignee

type task_planning =
    {
        estimate : planned_estimate
        load : planned_load
        assignee : planned_assignee
    }

union planning_field =
    | EstimateField
    | LoadField
    | AssigneeField

inl unplanned () : task_planning = { estimate = Unestimated; load = LoadUnset; assignee = Unassigned }

inl planning_field_names () : string = "estimate|load|assignee"

inl parse_planning_field (~text : string) : validation_result planning_field =
    match rust_std_string.model.pipe_index (planning_field_names ()) text with
    | 0u64 => Valid EstimateField
    | 1u64 => Valid LoadField
    | 2u64 => Valid AssigneeField
    | _ => Invalid

inl cleared_value (~text : string) : bool = rust_std_string.model.pipe_member "none|-" text

let parse_planned_load (~text : string) : validation_result planned_load =
    match rust_std_string.model.pipe_index "none|-|light|medium|heavy" (ascii_lowercase text) with
    | 0u64 | 1u64 => Valid LoadUnset
    | 2u64 => Valid (PlannedLoad LoadLight)
    | 3u64 => Valid (PlannedLoad LoadMedium)
    | 4u64 => Valid (PlannedLoad LoadHeavy)
    | _ => Invalid

let parse_planned_assignee (~text : string) : validation_result planned_assignee =
    match rust_std_string.model.pipe_index "none|-|agent|pair|user" (ascii_lowercase text) with
    | 0u64 | 1u64 => Valid Unassigned
    | 2u64 => Valid (PlannedAssignee AssigneeAgent)
    | 3u64 => Valid (PlannedAssignee AssigneePair)
    | 4u64 => Valid (PlannedAssignee AssigneeUser)
    | _ => Invalid

inl planned_or_unset (parsed : validation_result planned_load) : planned_load =
    match parsed with
    | Valid load => load
    | Invalid => LoadUnset

inl assigned_or_unset (parsed : validation_result planned_assignee) : planned_assignee =
    match parsed with
    | Valid assignee => assignee
    | Invalid => Unassigned

union estimate_unit =
    | MinuteUnit
    | HourUnit

inl estimate_unit_factor = function
    | MinuteUnit => 1i32
    | HourUnit => 60i32

inl estimate_digit_limit () : i32 = 6i32
inl ascii_zero () : i32 = 48i32
inl ascii_digit (code : i32) : bool = if i32_le (ascii_zero ()) code then i32_le code 57i32 else false
inl decimal_step (value : i32) (code : i32) : i32 = $"!value * 10 + !code - 48"
inl i32_scaled (value : i32) (factor : i32) : i32 = $"!value * !factor"

let rec decimal_digits_value (text : string) (offset : i32) (length : i32) (value : i32) : i32 =
    if i32_le length offset then value
    elif ascii_digit (byte_at text offset) then decimal_digits_value text (i32_next offset) length (decimal_step value (byte_at text offset))
    else -1i32

let decimal_value (~digits : string) : validation_result i32 =
    inl length = byte_len digits
    if i32_le length 0i32 then Invalid
    elif i32_le length (estimate_digit_limit ()) then
        inl value = decimal_digits_value digits 0i32 length 0i32
        if i32_negative value then Invalid else Valid value
    else Invalid

inl estimate_unit_of (~text : string) : estimate_unit =
    if rust_std_string.model.ends_with text "h" then HourUnit else MinuteUnit

inl estimate_digits (~text : string) : string =
    if rust_std_string.model.ends_with text "h" then byte_slice text 0i32 (i32_prev (byte_len text))
    elif rust_std_string.model.ends_with text "m" then byte_slice text 0i32 (i32_prev (byte_len text))
    else text

inl estimate_minute_ceiling () : i32 = 999999i32

inl bounded_estimate (minutes : i32) : validation_result planned_estimate =
    if i32_le minutes (estimate_minute_ceiling ()) then Valid (EstimateMinutes minutes) else Invalid

let parse_planned_estimate (~text : string) : validation_result planned_estimate =
    if cleared_value text then Valid Unestimated
    else
        match decimal_value (estimate_digits text) with
        | Valid value => bounded_estimate (i32_scaled value (estimate_unit_factor (estimate_unit_of text)))
        | Invalid => Invalid

inl planning_field_rule = function
    | EstimateField => "estimate must be whole minutes (360, 360m) or hours (6h), at most 999999 minutes, or none"
    | LoadField => "load must be light, medium, heavy or none"
    | AssigneeField => "assignee must be agent, pair, user or none"

inl task_load_name = function
    | LoadLight => "light"
    | LoadMedium => "medium"
    | LoadHeavy => "heavy"

inl task_assignee_name = function
    | AssigneeAgent => "agent"
    | AssigneePair => "pair"
    | AssigneeUser => "user"

inl task_load_case = function
    | LoadLight => "Light"
    | LoadMedium => "Medium"
    | LoadHeavy => "Heavy"

inl task_assignee_case = function
    | AssigneeAgent => "Agent"
    | AssigneePair => "Pair"
    | AssigneeUser => "User"

inl task_load_code = function
    | LoadLight => 1i32
    | LoadMedium => 2i32
    | LoadHeavy => 3i32

inl task_assignee_code = function
    | AssigneeAgent => 1i32
    | AssigneePair => 2i32
    | AssigneeUser => 3i32

inl planned_load_code = function
    | LoadUnset => 0i32
    | PlannedLoad load => task_load_code load

inl planned_assignee_code = function
    | Unassigned => 0i32
    | PlannedAssignee assignee => task_assignee_code assignee

inl planned_minutes = function
    | Unestimated => 0i32
    | EstimateMinutes minutes => minutes

inl estimate_known = function
    | Unestimated => false
    | EstimateMinutes _ => true

inl estimate_text = function
    | Unestimated => "-"
    | EstimateMinutes minutes => rust_std_string.model.concat5 (i32_text minutes) "m" "" "" ""

inl load_text = function
    | LoadUnset => "-"
    | PlannedLoad load => task_load_name load

inl assignee_text = function
    | Unassigned => "-"
    | PlannedAssignee assignee => task_assignee_name assignee

inl json_quoted (~text : string) : string = rust_std_string.model.concat5 "\"" text "\"" "" ""

inl estimate_json = function
    | Unestimated => "null"
    | EstimateMinutes minutes => i32_text minutes

inl load_json = function
    | LoadUnset => "null"
    | PlannedLoad load => json_quoted (task_load_name load)

inl assignee_json = function
    | Unassigned => "null"
    | PlannedAssignee assignee => json_quoted (task_assignee_name assignee)

let planning_json_fields (plan : task_planning) : string =
    inl estimate = rust_std_string.model.concat5 "\"estimate_minutes\":" (estimate_json plan.estimate) ",\"load\":" (load_json plan.load) ""
    rust_std_string.model.concat5 estimate ",\"assignee\":" (assignee_json plan.assignee) "" ""

let planning_summary (plan : task_planning) : string =
    inl estimate = rust_std_string.model.concat5 "estimate=" (estimate_text plan.estimate) " load=" (load_text plan.load) ""
    rust_std_string.model.concat5 estimate " assignee=" (assignee_text plan.assignee) "" ""

inl estimate_state_token = function
    | Unestimated => "Unestimated"
    | EstimateMinutes minutes => rust_std_string.model.concat5 "Minutes " (i32_text minutes) "u32" "" ""

inl load_state_token = function
    | LoadUnset => "LoadUnset"
    | PlannedLoad load => rust_std_string.model.concat5 "Load " (task_load_case load) "" "" ""

inl assignee_state_token = function
    | Unassigned => "Unassigned"
    | PlannedAssignee assignee => rust_std_string.model.concat5 "Assigned " (task_assignee_case assignee) "" "" ""

inl estimate_of_token (~token : string) : planned_estimate =
    if rust_std_string.model.starts_with token "Minutes " then
        match decimal_value (rust_std_string.model.replace (byte_slice token 8i32 (byte_len token)) "u32" "") with
        | Valid minutes => EstimateMinutes minutes
        | Invalid => Unestimated
    else Unestimated

inl load_of_token (~token : string) : planned_load =
    if rust_std_string.model.starts_with token "Load " then planned_or_unset (parse_planned_load (byte_slice token 5i32 (byte_len token)))
    else LoadUnset

inl assignee_of_token (~token : string) : planned_assignee =
    if rust_std_string.model.starts_with token "Assigned " then assigned_or_unset (parse_planned_assignee (byte_slice token 9i32 (byte_len token)))
    else Unassigned

inl planning_schema () : string =
    inl loads = "union task_load =\n    | Light :: task_load | Medium :: task_load | Heavy :: task_load\n\n"
    inl assignees = "union task_assignee =\n    | Agent :: task_assignee | Pair :: task_assignee | User :: task_assignee\n\n"
    inl estimates = "union planned_estimate =\n    | Unestimated :: planned_estimate | Minutes :: u32 -> planned_estimate\n\n"
    inl options = "union planned_load =\n    | LoadUnset :: planned_load | Load :: task_load -> planned_load\n\nunion planned_assignee =\n    | Unassigned :: planned_assignee | Assigned :: task_assignee -> planned_assignee\n\n"
    rust_std_string.model.concat5 loads assignees estimates options "union task_planning =\n    | Planning :: string * planned_estimate * planned_load * planned_assignee -> task_planning"

inl planning_schema_marker () : string = "union task_planning ="
inl agile_item_marker () : string = "-> agile_item"
inl planning_arguments_offset () : i32 = 10i32

inl planning_anchor (~id : string) : string = rust_std_string.model.concat5 "Planning (\"" id "\"," "" ""
inl task_anchor (~id : string) : string = rust_std_string.model.concat5 "Task (\"" id "\"," "" ""
inl planning_binding (~id : string) : string = rust_std_string.model.concat5 "planning_of_" (ascii_lowercase (rust_std_string.model.replace id "-" "_")) "" "" ""

type planning_tokens =
    {
        estimate_token : string
        load_token : string
        assignee_token : string
    }

inl unset_tokens () : planning_tokens = { estimate_token = "Unestimated"; load_token = "LoadUnset"; assignee_token = "Unassigned" }

inl tokens_with (field : planning_field) (~token : string) (tokens : planning_tokens) : planning_tokens =
    match field with
    | EstimateField => { tokens with estimate_token = token }
    | LoadField => { tokens with load_token = token }
    | AssigneeField => { tokens with assignee_token = token }

let planning_row (~id : string) (tokens : planning_tokens) : string =
    inl head = rust_std_string.model.concat5 "inl " (planning_binding id) " () = Planning (" (spi_quoted id) ", "
    inl tail = rust_std_string.model.concat5 tokens.estimate_token ", " tokens.load_token ", " tokens.assignee_token
    rust_std_string.model.concat5 head tail ")" "" ""

let rec declared_from (text : string) (~needle : string) (offset : i32) : i32 =
    inl found = byte_find_from text needle offset
    if i32_negative found then found
    elif declared_task text found then found
    else declared_from text needle (i32_next found)

inl planning_offset (text : string) (~id : string) : i32 = declared_from text (planning_anchor id) 0i32

let planning_at (text : string) (found : i32) : task_planning =
    inl field = tuple_field text ($"!found + !(planning_arguments_offset ())" : i32) (byte_len text)
    { estimate = estimate_of_token (field 1i32); load = load_of_token (field 2i32); assignee = assignee_of_token (field 3i32) }

let planning_of (text : string) (~id : string) : task_planning =
    inl found = planning_offset text id
    if i32_negative found then unplanned () else planning_at text found

let planning_tokens_of (text : string) (~id : string) : planning_tokens =
    inl found = planning_offset text id
    if i32_negative found then unset_tokens ()
    else
        inl field = tuple_field text ($"!found + !(planning_arguments_offset ())" : i32) (byte_len text)
        { estimate_token = field 1i32; load_token = field 2i32; assignee_token = field 3i32 }

inl line_end_after (text : string) (offset : i32) : i32 =
    inl found = byte_find_from text "\n" offset
    if i32_negative found then byte_len text else found

inl spliced (text : string) (start : i32) (stop : i32) (~middle : string) : string =
    rust_std_string.model.concat5 (byte_slice text 0i32 start) middle (byte_slice text stop (byte_len text)) "" ""

let planning_upserted (text : string) (~id : string) (tokens : planning_tokens) : validation_result string =
    inl task = byte_find text (task_anchor id)
    if i32_negative task then Invalid
    else
        inl existing = planning_offset text id
        if i32_negative existing then
            inl stop = line_end_after text task
            Valid (spliced text stop stop (rust_std_string.model.concat5 "\n" (planning_row id tokens) "" "" ""))
        else Valid (spliced text (line_start_before text existing) (line_end_after text existing) (planning_row id tokens))

let planning_schema_ensured (text : string) : string =
    if i32_negative (byte_find text (planning_schema_marker ())) then
        inl item = byte_find text (agile_item_marker ())
        if i32_negative item then rust_std_string.model.concat5 (planning_schema ()) "\n\n" text "" ""
        else
            inl stop = line_end_after text item
            spliced text stop stop (rust_std_string.model.concat5 "\n\n" (planning_schema ()) "" "" "")
    else text
