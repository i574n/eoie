open rust_std_fs.model
open agile_task_text.model
open workspace_primitives.numbers
open workspace_primitives.bytes
open workspace_primitives.clock
open workspace_primitives.console
open workspace_primitives.files
open ranking

inl query_flag_width (~argument : string) (~value : string) : i32 = $'agile_task_query::eoie_query_flag_width(&*!argument, &*!value)' : i32
inl query_flag_refusal (~argument : string) (~value : string) : string = $'agile_task_query::eoie_query_flag_refusal(&*!argument, &*!value)' : string
inl query_usage () : string = $'agile_task_query::eoie_query_usage()' : string
inl query_appended (~query : string) (~argument : string) (~value : string) : string = rust_std_string.model.concat5 query (if query = "" then "" else " ") argument (if value = "" then "" else " ") value

inl argument_owned index : string = rust_std_env.model.argument_owned index
inl argument_count () : i32 = $'std::env::args().skip(2).count() as i32' : i32
inl unquoted (~token : string) : string = byte_slice token 1i32 (byte_len token - 1i32)
inl padded (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); std::rc::Rc::<str>::from(text.to_string() + &" ".repeat(filler)) }' : string
inl right_aligned (~text : string) (width : i32) : string =
    $'{ let text = !text; let filler = (!width as usize).saturating_sub(text.chars().count()); std::rc::Rc::<str>::from(" ".repeat(filler) + &*text) }' : string
inl clipped (~text : string) (width : i32) : string =
    $'{ let text = !text; if text.chars().count() <= !width as usize { text } else { std::rc::Rc::<str>::from(text.chars().take((!width as usize).saturating_sub(3)).collect::<String>() + "...") } }' : string

inl progress_of (~token : string) : i32 = $'(!token).trim().trim_end_matches("u32").parse::<i32>().unwrap_or(0)' : i32

let backlog_task_at (text : string) (arguments : i32) (length : i32) : backlog_task =
    inl field = tuple_field text arguments length
    inl id = unquoted (field 0i32)
    {
        id = id
        title = unquoted (field 1i32)
        priority = level_of (field 3i32)
        difficulty = level_of (field 4i32)
        status = field 6i32
        deps = unquoted (field 7i32)
        tags = unquoted (field 8i32)
        estimate = $'agile_planning_fields::eoie_agile_planning_minutes_near(&*!text, &*!id, !arguments)' : i32
        progress = progress_of (field 5i32)
    }

let rec tasks_from (text : string) (offset : i32) (length : i32) (tasks : task_list) : task_list =
    inl found = byte_find_from text (task_marker ()) offset
    if found < 0i32 then tasks
    else
        inl arguments = $"!found + !(task_arguments_offset ())" : i32
        if declared_task text found then tasks_from text arguments length (TaskThen (backlog_task_at text arguments length, tasks))
        else tasks_from text arguments length tasks

let ranked_line (role : rank_role) (rank : i32) (item : ranked_task) : string =
    inl minutes = rust_std_string.model.concat5 (i32_text item.minutes) "m" (if item.estimated then " " else "~") "" ""
    inl score =
        match role with
        | MainAgent => rust_std_string.model.concat5 "  wsjf=" (padded (i32_text item.key) 7i32) "" "" ""
        | Subagent => ""
    inl head = rust_std_string.model.concat5 (right_aligned (i32_text rank) 3i32) "  " (padded item.id 28i32) " P" (i32_text item.priority)
    inl middle = rust_std_string.model.concat5 " D" (i32_text item.difficulty) "  " (right_aligned minutes 7i32) score
    rust_std_string.model.concat5 head middle "  unblocks=" (padded (i32_text item.unblocks) 5i32) (rust_std_string.model.concat5 "  " (clipped item.title 72i32) "" "" "")

let rec printed (role : rank_role) (list : ranked_list) (rank : i32) (limit : i32) : i32 =
    match list with
    | NoRanked => rank - 1i32
    | RankedThen (head, rest) =>
        if limit < rank then rank - 1i32
        else
            inl _ = stdout_line (ranked_line role rank head)
            printed role rest (rank + 1i32) limit

let rec ranked_count (list : ranked_list) (counted : i32) : i32 =
    match list with
    | NoRanked => counted
    | RankedThen (_, rest) => ranked_count rest (counted + 1i32)

union next_format =
    | NextText
    | NextJson

type next_request =
    {
        role : rank_role
        limit : i32
        filters : string
        format : next_format
    }

union next_parse =
    | NextParsed : next_request
    | NextRejected : string

inl next_usage () : string = rust_std_string.model.concat5 "expected --as main|subagent, " (query_usage ()) ", --json or a positive count" "" ""

let rec next_request_from (index : i32) (count : i32) (request : next_request) : next_parse =
    if count <= index then NextParsed request
    else
        inl argument = argument_owned index
        inl value = argument_owned (index + 1i32)
        if argument = "--as" then
            if value = "main" then next_request_from (index + 2i32) count { request with role = MainAgent }
            elif value = "subagent" then next_request_from (index + 2i32) count { request with role = Subagent }
            else NextRejected (rust_std_string.model.concat5 "--as expects main or subagent, got " value "" "" "")
        elif argument = "--json" then next_request_from (index + 1i32) count { request with format = NextJson }
        else
            inl width = query_flag_width argument value
            if width > 0i32 then next_request_from (index + width) count { request with filters = query_appended request.filters argument (if width = 2i32 then value else "") }
            elif width < 0i32 then NextRejected (query_flag_refusal argument value)
            else
                inl parsed = $'(!argument).parse::<i32>().ok().filter(|value| *value > 0).unwrap_or(0)' : i32
                if 0i32 < parsed then next_request_from (index + 1i32) count { request with limit = parsed }
                else NextRejected (rust_std_string.model.concat5 "unexpected argument " argument " (" (next_usage ()) ")")

let ranked_json (rank : i32) (item : ranked_task) : string =
    inl head = rust_std_string.model.concat5 "{\"rank\":" (i32_text rank) ",\"id\":\"" item.id "\""
    inl middle = rust_std_string.model.concat5 ",\"priority\":" (i32_text item.priority) ",\"difficulty\":" (i32_text item.difficulty) (rust_std_string.model.concat5 ",\"minutes\":" (i32_text item.minutes) ",\"estimated\":" (if item.estimated then "true" else "false") "")
    rust_std_string.model.concat5 head middle ",\"wsjf\":" (i32_text item.key) (rust_std_string.model.concat5 ",\"unblocks\":" (i32_text item.unblocks) ",\"title\":\"" item.title "\"}")

let rec json_items (list : ranked_list) (rank : i32) (limit : i32) (~items : string) : string * i32 =
    match list with
    | NoRanked => items, rank - 1i32
    | RankedThen (head, rest) =>
        if limit < rank then items, rank - 1i32
        else json_items rest (rank + 1i32) limit (if items = "" then ranked_json rank head else rust_std_string.model.concat5 items "," (ranked_json rank head) "" "")

inl next_failure (~reason : string) : i32 = stderr_failure (rust_std_string.model.concat5 "agile next rejected: " reason "" "" "")

let agile_next (~root : string) (request : next_request) : i32 =
    inl role = request.role
    inl limit = request.limit
    inl started = unix_ms ()
    match probe (unchecked (backlog_state_path root)) with
    | FileMissing _ => next_failure "state/agile.spi is missing"
    | FileReadable file =>
        inl text = loaded_string (read_text file)
        inl length = byte_len text
        inl malformed = first_malformed_task text 0i32 length
        if malformed < 0i32 then
            inl list = ranking_filtered role request.filters (tasks_from text 0i32 length NoTasks)
            match request.format with
            | NextJson =>
                inl items, shown = json_items list 1i32 limit ""
                stdout_line (rust_std_string.model.concat5 "{\"role\":\"" (rank_role_word role) "\",\"ready\":" (i32_text (ranked_count list 0i32)) (rust_std_string.model.concat5 ",\"shown\":" (i32_text shown) ",\"items\":[" items "]}"))
            | NextText =>
                inl shown = printed role list 1i32 limit
                inl ready = rust_std_string.model.concat5 " ready=" (i32_text (ranked_count list 0i32)) " shown=" (i32_text shown) ""
                stdout_line (rust_std_string.model.concat5 "eoie agile next ok role=" (rank_role_word role) ready " elapsed_ms=" (u64_text (ms_since started)))
        else next_failure (rust_std_string.model.concat5 "malformed Task fields at byte " (i32_text malformed) "" "" "")

let agile_next_entry () : i32 =
    match next_request_from 2i32 (argument_count ()) { role = MainAgent; limit = 10i32; filters = ""; format = NextText } with
    | NextParsed request => agile_next (argument_owned 1i32) request
    | NextRejected reason => next_failure reason

inl main () : i32 =
    !!!!Export("eoie_agile_next_run", ((fun () => agile_next_entry ()) : () -> i32))
    inl _ = agile_next_entry ()
    0i32
