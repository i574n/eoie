open rust_std_string.model
open eoie_table_query.cells
open eoie_table_query.table
open eoie_experiments.experiment_model
open eoie_experiments.ledger_host
open eoie_experiments.experiment_plan

type tally =
    {
        rows : i32
        count : f64
        sum : f64
        squares : f64
        successes : i32
    }

union rows_kept =
    | RowsKept : string
    | RowsRefused : string

inl rows_kept_of (kept : bool) (~detail : string) : rows_kept = if kept then RowsKept detail else RowsRefused detail
inl row_kept (~mask : string) (row : i32) : bool = $'(!mask).as_bytes().get(!row as usize) == Some(&49u8)' : bool

type scope =
    {
        kept : string
        group : i32
        time : i32
        since : string
    }

let text_before (~left : string) (~right : string) : bool = $'(!left) < (!right)' : bool

let in_arm (cells : table_cells) (chosen : scope) (~arm : string) (row : i32) : bool =
    row_kept chosen.kept row && (chosen.group < 0i32 || cell_at cells row chosen.group = arm)

let in_scope (cells : table_cells) (chosen : scope) (~arm : string) (row : i32) : bool =
    in_arm cells chosen arm row && (chosen.time < 0i32 || text_before (cell_at cells row chosen.time) chosen.since = false)

let rec tallied (cells : table_cells) (chosen : scope) (~arm : string) (metric : i32) (row : i32) (total : i32) (acc : tally) : tally =
    if row > total then acc
    elif in_scope cells chosen arm row then
        inl cell = cell_at cells row metric
        inl value = number_parsed cell
        inl numeric = (value = value)
        inl next = { acc with rows = acc.rows + 1i32; successes = acc.successes + (if success_cell cell then 1i32 else 0i32) }
        inl measured = if numeric then { next with count = next.count + 1.0f64; sum = next.sum + value; squares = next.squares + value * value } else next
        tallied cells chosen arm metric (row + 1i32) total measured
    else tallied cells chosen arm metric (row + 1i32) total acc

let rec early_rows (cells : table_cells) (chosen : scope) (~arm : string) (row : i32) (total : i32) (found : i32) : i32 =
    if row > total || chosen.time < 0i32 then found
    elif in_arm cells chosen arm row && in_scope cells chosen arm row = false then early_rows cells chosen arm (row + 1i32) total (found + 1i32)
    else early_rows cells chosen arm (row + 1i32) total found

let rec values_of (cells : table_cells) (chosen : scope) (~arm : string) (metric : i32) (row : i32) (total : i32) (~acc : string) : string =
    if row > total then acc
    elif in_scope cells chosen arm row then
        inl cell = cell_at cells row metric
        inl next = if number_parsed cell = number_parsed cell then (if acc = "" then cell else concat5 acc "," cell "" "") else acc
        values_of cells chosen arm metric (row + 1i32) total next
    else values_of cells chosen arm metric (row + 1i32) total acc

let median_terms_between (~values : string) (low : f64) (high : f64) : string =
    $'eoie_experiment_stats::eoie_median_terms(&*!values, !low, !high)' : string

let median_terms (~values : string) (~band : string) : string =
    median_terms_between values (number_parsed (head_of band ",")) (number_parsed (tail_of band ","))

inl look_suffix (verdict : look) : string =
    match verdict with
    | InterimLook _ => " look=interim disclosed=yes"
    | _ => " look=full verdict=recorded"

let optional_column (cells : table_cells) (~name : string) : i32 = if name = "" then (-1i32) else column_of cells name

let terms_of (cells : table_cells) (chosen : scope) (metric : i32) (study : plan) (left : tally) (right : tally) : string =
    match band_of study.test with
    | Band (low, high) => median_terms_between (values_of cells chosen study.arm metric 1i32 (row_total cells) "") low high
    | NoBand =>
        inl word = test_word study.kind
        inl left_rows, left_count, left_sum, left_squares, left_successes = left.rows, left.count, left.sum, left.squares, left.successes
        inl right_rows, right_count, right_sum, right_squares, right_successes = right.rows, right.count, right.sum, right.squares, right.successes
        inl prediction = prediction_of study.test
        inl confidence = study.confidence
        $'eoie_experiment_stats::eoie_experiment_terms(&*!word, !left_rows, !left_count, !left_sum, !left_squares, !left_successes, !right_rows, !right_count, !right_sum, !right_squares, !right_successes, !prediction, !confidence)' : string

inl measures_numbers (kind : test_kind) : bool =
    match kind with
    | WelchTwoSided => true
    | OneSampleT => true
    | MedianBand => true
    | _ => false

let numeric_note (kind : test_kind) (acc : tally) : string =
    inl count = acc.count
    inl used = $'!count as i32' : i32
    if measures_numbers kind && used < acc.rows then concat5 " (" (i32_text used) " numeric)" "" "" else ""

let arm_counts (study : plan) (left : tally) (right : tally) : string =
    inl planned = i32_text study.runs
    inl first = concat5 study.arm " " (i32_text left.rows) "/" (concat5 planned (numeric_note study.kind left) "" "" "")
    match second_arm_of study.test with
    | AgainstArm arm => concat5 first ", " arm " " (concat5 (i32_text right.rows) "/" planned (numeric_note study.kind right) "")
    | OneArm => first

let analyzed_plan (~ledger : string) (study : plan) (cells : table_cells) : i32 =
    inl wheres = where_clauses ()
    inl table_path = argument 5i32
    inl mask, missing_wheres =
        inl kept, detail = $'eoie_table_query::eoie_table_rows_kept(&*!table_path, &*!wheres)' : bool * string
        match rows_kept_of kept detail with
        | RowsKept mask => mask, ""
        | RowsRefused reason => "", reason
    inl group = optional_column cells study.group
    inl time = optional_column cells study.time
    inl metric = column_of cells study.metric
    if metric < 0i32 || missing_wheres <> "" || (study.group <> "" && group < 0i32) || (study.time <> "" && time < 0i32) then
        failed (concat5 "analyze: unknown columns in " (argument 5i32) " (header: " (header_joined cells ",") ")")
    else
        inl chosen = { kept = mask; group = group; time = time; since = study.since }
        inl empty = { rows = 0i32; count = 0.0f64; sum = 0.0f64; squares = 0.0f64; successes = 0i32 }
        inl first = study.arm
        inl left = tallied cells chosen first metric 1i32 (row_total cells) empty
        inl right, second_early =
            match second_arm_of study.test with
            | AgainstArm arm => tallied cells chosen arm metric 1i32 (row_total cells) empty, early_rows cells chosen arm 1i32 (row_total cells) 0i32
            | OneArm => left, 0i32
        inl early = early_rows cells chosen first 1i32 (row_total cells) 0i32 + second_early
        inl counts = arm_counts study left right
        inl shortfall = left.rows < study.runs || right.rows < study.runs
        inl verdict_at = field_of (file_text (record_path ledger study.id "verdict")) "analyzed"
        match look_of counts shortfall (option_value "--interim") verdict_at with
        | LookRefused reason =>
            stdout_line (concat5 "eoie experiment analyze refused id=" study.id " " reason "")
            1i32
        | look =>
            inl stamped = now_ms ()
            inl at = $'agile_task_notes::eoie_utc_stamp(!stamped)' : string
            inl excluded = if time < 0i32 then "" else concat5 " before_registration=" (i32_text early) "" "" ""
            inl line = concat5 "id=" study.id " test=" (test_word study.kind) (concat5 " n=" counts " " (terms_of cells chosen metric study left right) excluded)
            inl problem =
                match look with
                | InterimLook reason => text_appended (record_path ledger study.id "disclosures") (concat5 (field_line "disclosed" at) (field_line "reason" reason) (field_line "result" line) "" "")
                | _ => text_created (record_path ledger study.id "verdict") (concat5 (field_line "analyzed" at) (field_line "result" line) (field_line "decision" study.decision) "" "")
            if problem <> "" then failed (concat5 "analyze: " problem "" "" "")
            else
                stdout_line (concat5 "eoie experiment analyze ok " line (look_suffix look) "" "")
                0i32

let analyzed () : i32 =
    inl ledger = argument 3i32
    inl id = argument 4i32
    inl text = plan_text ledger id
    if text = "" then failed (concat5 "analyze: no registration for " id " in " ledger "")
    else
        match plan_trusted text with
        | PlanBroken reason => failed (concat5 "analyze: the registration of " id " is unusable: " reason "")
        | PlanRead study =>
            match table_read (argument 5i32) with
            | TableUnreadable problem => failed (concat5 "analyze: " problem "" "" "")
            | TableLoaded cells => analyzed_plan ledger study cells
inl main () : i32 =
    !!!!Export("eoie_experiment_analyze_run", ((fun () => analyzed ()) : () -> i32))
    0i32
