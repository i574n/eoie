let cold_proof_equal_binding (expected : i32) (observed : i32) : i32 =
    if expected = observed then 1i32 else 0i32

let cold_proof_binary_binding (presence : i32) : i32 =
    if presence = 1i32 then 1i32
    elif presence = 2i32 then 2i32
    else 0i32

inl cold_proof_header_binding (schema : i32) (status : i32) : i32 =
    if schema = 4i32 then
        if status = 1i32 then 1i32 else 0i32
    else 0i32

inl cold_proof_shape_binding (gate_mask : i32) (gate_count : i32) : i32 =
    if gate_mask = 31i32 then
        if gate_count = 5i32 then 1i32 else 0i32
    else 0i32

inl cold_proof_evidence_binding (observed_mask : i32) (expected_mask : i32) : i32 =
    if observed_mask = 7i32 then
        if expected_mask = 7i32 then 1i32 else 0i32
    else 0i32

inl cold_proof_count_binding (expected : i32) (observed : i32) : i32 =
    if expected = observed then 1i32 else 0i32

inl cold_proof_replay_binding (observed_flags : i32) (expected_flags : i32) : i32 =
    if observed_flags = 15i32 then
        if expected_flags = 15i32 then 1i32 else 0i32
    else 0i32
