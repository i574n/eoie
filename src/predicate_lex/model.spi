inl token (text : string) (cursor : i32) : i32 * i32 * string * bool = $'predicate_lex_domain::eoie_predicate_token(&*!text,!cursor)' : i32 * i32 * string * bool
inl literal (text : string) (cursor : i32) : string * i32 * bool = $'predicate_literal_domain::eoie_predicate_literal(&*!text,!cursor)' : string * i32 * bool
inl encode (text : string) : string = $'predicate_literal_domain::eoie_predicate_encode(&*!text)' : string
inl skip (text : string) (cursor : i32) : i32 = $'predicate_lex_domain::eoie_predicate_skip(&*!text,!cursor)' : i32
inl word_end (text : string) (cursor : i32) : i32 = $'predicate_lex_domain::eoie_predicate_word_end(&*!text,!cursor)' : i32
inl canonical (text : string) : string * bool = $'predicate_lex_domain::eoie_predicate_canonical(&*!text)' : string * bool
