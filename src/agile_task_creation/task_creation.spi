open agile_mutation_policy.model
open rust_std_fs.model
open agile_task_text.model
open workspace_primitives.outcome
open workspace_primitives.numbers
open workspace_primitives.bytes
open workspace_primitives.clock
open workspace_primitives.console
open workspace_primitives.files

inl argument_len index : i32 = rust_std_env.model.argument_len index
inl argument_byte index offset : i32 = rust_std_env.model.argument_byte index offset
inl argument_owned index : string = rust_std_env.model.argument_owned index
inl i32_positive value : bool = $"0 < !value"
inl i32_digit value : bool = if 48i32 <= value then value <= 57i32 else false
inl i32_upper_letter value : bool = if 65i32 <= value then value <= 90i32 else false
inl task_id_byte_allowed value : bool =
    if i32_upper_letter value then true
    elif i32_digit value then true
    else value = 45i32
let rec task_id_bytes_allowed (offset : i32) (length : i32) : bool =
    if offset = length then true
    elif task_id_byte_allowed (argument_byte 2i32 offset) then task_id_bytes_allowed (offset + 1i32) length
    else false
inl validate_task_id () : validation_result string =
    inl length = argument_len 2i32
    if i32_positive length then
        if task_id_bytes_allowed 0i32 length then Valid (argument_owned 2i32) else Invalid
    else Invalid

inl task_binding (~id : string) : string = ascii_lowercase (rust_std_string.model.replace id "-" "_")
union add_flag =
    | FlagEstimate
    | FlagLoad
    | FlagAssignee
    | FlagDeps
    | FlagNote
    | FlagAs

inl flag_word (flag : add_flag) : string = rust_std_string.model.concat5 "--" (ascii_lowercase (union_reflection.cases.union_case_suffix "Flag" flag)) "" "" ""

inl flag_words () : string = union_reflection.cases.union_cases_joined flag_word ", "

type add_extras =
    {
        estimate : string
        load : string
        assignee : string
        deps : string
        note : string
        author : string
    }

inl no_extras () : add_extras = { estimate = ""; load = ""; assignee = ""; deps = ""; note = ""; author = "" }

inl extras_with (flag : add_flag) (~value : string) (extras : add_extras) : add_extras =
    match flag with
    | FlagEstimate => { extras with estimate = value }
    | FlagLoad => { extras with load = value }
    | FlagAssignee => { extras with assignee = value }
    | FlagDeps => { extras with deps = value }
    | FlagNote => { extras with note = rust_std_string.model.trim value }
    | FlagAs => { extras with author = rust_std_string.model.trim value }

union flag_parse =
    | FlagKnown : add_flag
    | FlagUnknown

union extras_read =
    | ExtrasRead : add_extras
    | ExtrasRefused : string

let flag_of_word (~word : string) : flag_parse =
    union_reflection.cases.union_case_where (fun (flag : add_flag) => word = flag_word flag) (fun flag => FlagKnown flag) FlagUnknown

let rec extras_from (index : i32) (count : i32) (extras : add_extras) : extras_read =
    if count <= index then ExtrasRead extras
    else
        inl word = argument_owned index
        match flag_of_word word with
        | FlagKnown flag =>
            if count <= index + 1i32 then ExtrasRefused (rust_std_string.model.concat5 word " needs a value" "" "" "")
            else extras_from (index + 2i32) count (extras_with flag (argument_owned (index + 1i32)) extras)
        | FlagUnknown => ExtrasRefused (rust_std_string.model.concat5 "unknown option " word " (expected " (flag_words ()) ")")

inl author_settled (extras : add_extras) : add_extras =
    if extras.author = "" then { extras with author = rust_std_string.model.trim (rust_std_env.model.variable_or_empty "EOIE_AUTHOR") } else extras

let extras_checked (read : extras_read) : extras_read =
    match read with
    | ExtrasRefused _ => read
    | ExtrasRead given =>
        inl extras = author_settled given
        if extras.note = "" then
            if given.author = "" then ExtrasRead extras else ExtrasRefused "--as names the author of --note; give --note too"
        elif extras.author = "" then ExtrasRefused "a note needs its author: --as <author> (or set EOIE_AUTHOR)"
        else ExtrasRead extras

inl task_line (~id : string) kind priority difficulty (~title : string) (~tags : string) (~deps : string) : string =
    inl head = rust_std_string.model.concat5 "inl " (task_binding id) " () = Task (" (spi_quoted id) ", "
    inl middle = rust_std_string.model.concat5 (spi_quoted title) ", " (agile_case_text kind) ", " (agile_case_text priority)
    inl tail = rust_std_string.model.concat5 ", " (agile_case_text difficulty) ", 0u32, Planned, " (spi_quoted deps) (rust_std_string.model.concat5 ", " (spi_quoted tags) ", \"current\", \"current\")" "" "")
    rust_std_string.model.concat5 head middle tail "" ""

union added_text =
    | AddedText : string
    | AddedRefused : string

let extras_applied (~text : string) (~id : string) (extras : add_extras) : added_text =
    inl estimate, load, assignee, body, author = extras.estimate, extras.load, extras.assignee, extras.note, extras.author
    inl code, detail = $'agile_task_notes::eoie_agile_groomed(&*!text, &*!id, &*!estimate, &*!load, &*!assignee, &*!body, &*!author)' : i32 * string
    if code = 0i32 then AddedText detail else AddedRefused detail

inl extras_receipt (extras : add_extras) : string =
    inl deps = if extras.deps = "" then "" else rust_std_string.model.concat5 " deps=" extras.deps "" "" ""
    inl planning = rust_std_string.model.concat5 (if extras.estimate = "" then "" else " estimate") (if extras.load = "" then "" else " load") (if extras.assignee = "" then "" else " assignee") "" ""
    rust_std_string.model.concat5 deps (if planning = "" then "" else rust_std_string.model.concat5 " planned=" (rust_std_string.model.replace (rust_std_string.model.trim planning) " " ",") "" "" "") (if extras.note = "" then "" else " notes=1") "" ""

inl agile_add_failure (~reason : string) (~id : string) : i32 = stderr_failure (rust_std_string.model.concat5 "agile add " id " rejected: " reason "")
inl agile_add_success (~id : string) (~binding : string) (extras : add_extras) (before : u64) (after : u64) (elapsed : u64) : i32 =
    inl head = rust_std_string.model.concat5 "eoie agile add ok id=" id " binding=" binding (rust_std_string.model.concat5 " status=Planned progress=0" (extras_receipt extras) "" "" "")
    stdout_line (rust_std_string.model.concat5 head (measured_sizes before after elapsed) "" "" "")
inl task_exists (~id : string) (~state : string) : bool = text_contains (rust_std_string.model.concat5 "Task (\"" id "\"," "" "") state
inl agile_add (~root : string) (~id : string) kind priority difficulty (~title : string) (~tags : string) (extras : add_extras) : i32 =
    inl started = unix_ms ()
    inl state = backlog_state_path root
    match probe (unchecked state) with
    | FileMissing _ => agile_add_failure "state/agile.spi is missing" id
    | FileReadable file =>
        if task_exists id state then agile_add_failure "a task with this id already exists" id
        else
            inl original = loaded_string (read_text file)
            inl appended = rust_std_string.model.concat5 (rust_std_string.model.trim_end_matches original "\n") "\n" (task_line id kind priority difficulty title tags extras.deps) "\n" ""
            match extras_applied appended id extras with
            | AddedRefused reason => agile_add_failure reason id
            | AddedText updated =>
                match replace_file_checked state updated with
                | Replaced => agile_add_success id (task_binding id) extras (text_bytes original) (text_bytes updated) (ms_since started)
                | problem => agile_add_failure (file_replacement_problem problem) id
let agile_add_entry () : i32 =
    if i32_digit (argument_byte 2i32 0i32) then agile_add_failure "the id must start with a letter, so its inl name is a valid identifier" (argument_owned 2i32)
    else
        match validate_task_id (), parse_task_kind (argument_owned 3i32), parse_priority (argument_owned 4i32), parse_difficulty (argument_owned 5i32) with
        | Valid id, Valid kind, Valid priority, Valid difficulty =>
            match extras_checked (extras_from 8i32 ($'std::env::args().skip(2).count() as i32' : i32) (no_extras ())) with
            | ExtrasRead extras => agile_add (argument_owned 1i32) id kind priority difficulty (argument_owned 6i32) (argument_owned 7i32) extras
            | ExtrasRefused reason => agile_add_failure reason id
        | Invalid, _, _, _ => agile_add_failure "the id must be uppercase letters, digits and dashes" (argument_owned 2i32)
        | _, Invalid, _, _ => agile_add_failure "kind must be Epic, Feature, Story or TaskKind" (argument_owned 2i32)
        | _, _, Invalid, _ => agile_add_failure "priority must be P0..P5" (argument_owned 2i32)
        | _, _, _, Invalid => agile_add_failure "difficulty must be D0..D8" (argument_owned 2i32)

inl main () : i32 =
    !!!!Export("eoie_agile_add_run", ((fun () => agile_add_entry ()) : () -> i32))
    inl _ = agile_add_entry ()
    0i32
