nominal process_idle = ()
nominal process_running = ()
nominal sessions_closed = ()
nominal process_mutator = ()

union process_authority scope =
    | ProcessMutator :: process_authority process_mutator

union process_budget =
    | Milliseconds :: u32 -> process_budget

let process_timeout_valid_export (positive_flag : i32) (reserved : i32) : i32 =
    if positive_flag = 1i32 then
        if reserved = 0i32 then 1i32 else 0i32
    else 0i32

let process_compiler_budget_valid_export (segmented_positive : i32) (timeout_positive : i32) : i32 =
    if segmented_positive = 1i32 then
        if timeout_positive = 1i32 then 1i32 else 0i32
    else 0i32

let process_session_match_export (field_count : i32) (packed_flags : i32) : i32 =
    if field_count < 3i32 then 0i32
    elif packed_flags = 7i32 then 1i32
    else 0i32

union process_op from to result =
    | RunBounded :: process_authority process_mutator * process_budget -> process_op process_idle process_running string
    | CompileSpiral :: process_authority process_mutator * process_budget * process_budget -> process_op process_idle process_running string
    | CheckSpiral :: process_authority process_mutator * process_budget -> process_op process_idle process_running string
    | ShutdownSessions :: process_authority process_mutator * process_budget -> process_op process_running sessions_closed string

nominal process_audit from to result = process_op from to result
nominal process_receipt from to result = process_op from to result
prototype interpret interpreter from to result : interpreter from to result -> string

instance interpret process_audit = fun (process_audit op) =>
    match op with
    | RunBounded _ => "audit-run-bounded"
    | CompileSpiral _ => "audit-compile-spiral"
    | CheckSpiral _ => "audit-check-spiral"
    | ShutdownSessions _ => "audit-shutdown-sessions"

instance interpret process_receipt = fun (process_receipt op) =>
    match op with
    | RunBounded _ => "receipt-run-bounded"
    | CompileSpiral _ => "receipt-compile-spiral"
    | CheckSpiral _ => "receipt-check-spiral"
    | ShutdownSessions _ => "receipt-shutdown-sessions"

union rec process_plan from to =
    | ProcessStep :: forall from to. (exists result. process_op from to result * result) -> process_plan from to
    | ProcessThen :: forall from to. (exists middle. process_plan from middle * process_plan middle to) -> process_plan from to

inl compile_plan () : process_plan process_idle process_running = ProcessStep (exists (CompileSpiral (ProcessMutator, Milliseconds 5000u32, Milliseconds 30000u32), "compiled"))
inl shutdown_plan () : process_plan process_idle sessions_closed = ProcessThen (exists (ProcessStep (exists (RunBounded (ProcessMutator, Milliseconds 30000u32), "bounded")), ProcessStep (exists (ShutdownSessions (ProcessMutator, Milliseconds 30000u32), "closed"))))

inl rust_global (x : string) : () = !!!!Global(x)

inl emit_run_bounded () =
    rust_global """
        #[rustfmt::skip]
        #[cfg(windows)] pub use eoie_process_streaming::WindowsJob;
        pub fn run_bounded(command: &mut std::process::Command, timeout_ms: u64) -> Result<std::process::ExitStatus, String> {
            let stdout_handle = std::io::stdout(); let stderr_handle = std::io::stderr(); let mut stdout = stdout_handle.lock(); let mut stderr = stderr_handle.lock();
            let capture = eoie_process_streaming::run_bounded_streaming(command, timeout_ms, None, |kind, bytes| { match kind { eoie_process_streaming::ProcessStreamKind::Stdout => { std::io::Write::write_all(&mut stdout, bytes).map_err(|error| format!("stream stdout: {error}"))?; std::io::Write::flush(&mut stdout).map_err(|error| format!("flush stdout: {error}"))?; }, eoie_process_streaming::ProcessStreamKind::Stderr => { std::io::Write::write_all(&mut stderr, bytes).map_err(|error| format!("stream stderr: {error}"))?; std::io::Write::flush(&mut stderr).map_err(|error| format!("flush stderr: {error}"))?; } } Ok(()) })?;
            if matches!(capture.termination, eoie_process_streaming::ProcessTermination::TimedOut) { return Err(format!("command timed out after {timeout_ms} ms")); } Ok(capture.status)
        }
        #[cfg(all(test, unix))]
        #[rustfmt::skip]
        mod run_bounded_tree_tests {
            use super::*;
            #[test] fn public_timeout_kills_grandchild_tree() { let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos(); let root = std::env::temp_dir().join(format!("eoie-run-bounded-tree-{}-{nonce}", std::process::id())); std::fs::create_dir_all(&root).unwrap(); let marker = root.join("escaped.txt"); let mut command = std::process::Command::new("/bin/sh"); command.arg("-c").arg("(sleep 0.35; printf escaped > \"$1\") & wait").arg("eoie-grandchild").arg(&marker); let error = run_bounded(&mut command, 50).unwrap_err(); assert!(error.contains("timed out")); std::thread::sleep(std::time::Duration::from_millis(500)); assert!(!marker.exists(), "grandchild escaped process-group termination"); std::fs::remove_dir_all(&root).unwrap(); }
        }
        """

inl emit_process_capture_types () =
    rust_global """
        #[derive(Clone, Debug, Eq, PartialEq)]
        pub enum ProcessTermination {
            Exited(i32),
            Signaled(i32),
            TimedOut,
            Unknown,
        }

        #[derive(Debug)]
        pub struct ProcessCapture {
            pub status: std::process::ExitStatus,
            pub termination: ProcessTermination,
            pub stdout: Vec<u8>,
            pub stderr: Vec<u8>,
        }

        fn classify_process_termination(status: &std::process::ExitStatus) -> ProcessTermination {
            if let Some(code) = status.code() {
                return ProcessTermination::Exited(code);
            }
            #[cfg(unix)]
            {
                use std::os::unix::process::ExitStatusExt as _;
                if let Some(signal) = status.signal() {
                    return ProcessTermination::Signaled(signal);
                }
            }
            ProcessTermination::Unknown
        }

        """

inl emit_run_bounded_capture () =
    rust_global """
        #[derive(Clone, Debug, Eq, PartialEq)]
        pub enum ProcessTermination {
            Exited(i32),
            Signaled(i32),
            TimedOut,
            Unknown,
        }

        #[derive(Debug)]
        pub struct ProcessCapture {
            pub status: std::process::ExitStatus,
            pub termination: ProcessTermination,
            pub stdout: Vec<u8>,
            pub stderr: Vec<u8>,
        }

        fn classify_process_termination(status: &std::process::ExitStatus) -> ProcessTermination {
            if let Some(code) = status.code() {
                return ProcessTermination::Exited(code);
            }
            #[cfg(unix)]
            {
                use std::os::unix::process::ExitStatusExt as _;
                if let Some(signal) = status.signal() {
                    return ProcessTermination::Signaled(signal);
                }
            }
            ProcessTermination::Unknown
        }

        fn spawn_process_reader<T>(mut stream: T) -> std::thread::JoinHandle<Result<Vec<u8>, String>>
        where
            T: std::io::Read + Send + 'static,
        {
            std::thread::spawn(move || {
                let mut bytes = Vec::new();
                stream
                    .read_to_end(&mut bytes)
                    .map_err(|error| format!("read process stream: {error}"))?;
                Ok(bytes)
            })
        }

        fn join_process_reader(
            reader: std::thread::JoinHandle<Result<Vec<u8>, String>>,
            stream: &str,
        ) -> Result<Vec<u8>, String> {
            reader
                .join()
                .map_err(|_| format!("{stream} reader panicked"))?
        }

        pub fn run_bounded_capture(
            command: &mut std::process::Command,
            timeout_ms: u64,
        ) -> Result<ProcessCapture, String> {
            if timeout_ms == 0 {
                return Err("timeout must be positive".to_owned());
            }
            command
                .stdout(std::process::Stdio::piped())
                .stderr(std::process::Stdio::piped());
            let mut child = command
                .spawn()
                .map_err(|error| format!("spawn process: {error}"))?;
            let stdout = child
                .stdout
                .take()
                .ok_or_else(|| "process stdout was not piped".to_owned())?;
            let stderr = child
                .stderr
                .take()
                .ok_or_else(|| "process stderr was not piped".to_owned())?;
            let stdout_reader = spawn_process_reader(stdout);
            let stderr_reader = spawn_process_reader(stderr);
            let deadline = std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms);
            let (status, timed_out) = loop {
                if let Some(status) = child
                    .try_wait()
                    .map_err(|error| format!("wait process: {error}"))?
                {
                    break (status, false);
                }
                if std::time::Instant::now() >= deadline {
                    child
                        .kill()
                        .map_err(|error| format!("kill timed out process: {error}"))?;
                    let status = child
                        .wait()
                        .map_err(|error| format!("reap timed out process: {error}"))?;
                    break (status, true);
                }
                std::thread::sleep(std::time::Duration::from_millis(10));
            };
            let stdout = join_process_reader(stdout_reader, "stdout")?;
            let stderr = join_process_reader(stderr_reader, "stderr")?;
            let termination = if timed_out {
                ProcessTermination::TimedOut
            } else {
                classify_process_termination(&status)
            };
            Ok(ProcessCapture { status, termination, stdout, stderr })
        }

        """

inl emit_compiler_discovery () = ()

inl emit_compile_spiral () =
    rust_global """
        pub fn compile_spiral(
            compiler: &str,
            input: &std::path::Path,
            output: &std::path::Path,
            backend: &str,
            segmented_timeout_ms: u64,
            timeout_ms: u64,
        ) -> Result<std::process::ExitStatus, String> {
            if eoie_process_compiler_budget_valid_binding(i32::from(segmented_timeout_ms > 0), i32::from(timeout_ms > 0)) != 1 {
                return Err("compiler timeouts must be positive".to_owned());
            }
            let mut command = spiral_compiler_command(std::path::Path::new(compiler));
            command
                .arg("--backend")
                .arg(backend);
            if !native_spiral_host(std::path::Path::new(compiler)) { command.arg("--timeout-ms").arg(timeout_ms.to_string()); }
            command.arg(input).arg(output);
            let total = segmented_timeout_ms
                .saturating_add(timeout_ms)
                .saturating_add(10_000);
            let _lease = spiral_session_lock(compiler, false, total)?;
            run_bounded(&mut command, total)
        """
    rust_global """
        }

        pub fn compile_spiral_plan_ir(compiler: &str, input: &std::path::Path, output: &std::path::Path, timeout_ms: u64) -> Result<std::process::ExitStatus, String> {
            if eoie_process_compiler_budget_valid_binding(i32::from(timeout_ms > 0), i32::from(timeout_ms > 0)) != 1 { return Err("plan IR compiler timeout must be positive".to_owned()); }
            let plan_ir_compiler = if std::path::Path::new(compiler).file_name().and_then(|value| value.to_str()) == Some("spiral-compile-session") { let candidate = std::path::Path::new(compiler).with_file_name("spiral-compile"); if candidate.is_file() { candidate } else { std::path::PathBuf::from(compiler) } } else { std::path::PathBuf::from(compiler) };
            let mut command = spiral_compiler_command(&plan_ir_compiler);
            command.arg("--plan-ir").arg("--timeout-ms").arg(timeout_ms.to_string()).arg(input).arg(output);
            let total = timeout_ms.saturating_add(10_000);
            let plan_ir_compiler_text = plan_ir_compiler.to_string_lossy();
            let _lease = spiral_session_lock(plan_ir_compiler_text.as_ref(), false, total)?;
            run_bounded(&mut command, total)
        }
        """

inl emit_typecheck_spiral_file () =
    rust_global """
        pub fn typecheck_spiral_file(compiler: &SpiralCompilerDiscovery, path: &std::path::Path) -> Result<(), String> {
            let timeout_ms = std::env::var("EOIE_SPIRAL_TIMEOUT_MS").ok().and_then(|value| value.parse::<u64>().ok()).unwrap_or(30000);
            let check_compiler = if compiler.path.file_name().and_then(|value| value.to_str()) == Some("spiral-compile-session") {
                let candidate = compiler.path.with_file_name("spiral-compile");
                if candidate.is_file() { candidate } else { compiler.path.clone() }
            } else { compiler.path.clone() };
            let mut command = spiral_compiler_command(&check_compiler);
            command.arg("--check").arg(path);
            let status = run_bounded(&mut command, timeout_ms)?;
            if !status.success() { return Err(format!("Spiral typecheck attestation failed for {} via {}", path.display(), check_compiler.display())); }
            Ok(())
        }

        """

inl emit_shutdown_sessions () =
    rust_global """
        struct SpiralSessionProcess {
            pid: i32,
            socket: std::path::PathBuf,
        }

        fn spiral_compiler_scope(compiler: &str) -> Result<std::path::PathBuf, String> {
            let compiler = std::fs::canonicalize(compiler).unwrap_or_else(|_| std::path::PathBuf::from(compiler));
            let parent = compiler.parent().ok_or_else(|| format!("compiler has no parent: {}", compiler.display()))?;
            Ok(parent.parent().unwrap_or(parent).to_path_buf())
        }

        fn spiral_session_matches(scope: &std::path::Path, fields: &[&[u8]]) -> bool {
            if fields.len() < 3 { return false; }
            let executable = std::path::PathBuf::from(String::from_utf8_lossy(fields[0]).into_owned());
            let field_count = i32::try_from(fields.len()).unwrap_or(i32::MAX);
            let server_flag = i32::from(fields[1] == b"--server");
            let runner_flag = i32::from(executable.file_name().and_then(|value| value.to_str()) == Some("SpiralHelloRunner"));
            let scope_flag = i32::from(executable.starts_with(scope));
            let packed_flags = server_flag | (runner_flag << 1) | (scope_flag << 2);
            eoie_process_session_match_binding(field_count, packed_flags) == 1
        }

        fn spiral_session_processes(compiler: &str) -> Result<Vec<SpiralSessionProcess>, String> {
            let scope = spiral_compiler_scope(compiler)?;
            let mut processes = Vec::new();
            for entry in std::fs::read_dir("/proc").map_err(|error| format!("read /proc: {error}"))? {
                let entry = match entry { Ok(entry) => entry, Err(_) => continue };
                let pid = match entry.file_name().to_string_lossy().parse::<i32>() { Ok(pid) if pid > 1 => pid, _ => continue };
                if pid == std::process::id() as i32 { continue; }
                let bytes = match std::fs::read(entry.path().join("cmdline")) { Ok(bytes) => bytes, Err(_) => continue };
                let fields = bytes.split(|byte| *byte == 0).filter(|field| !field.is_empty()).collect::<Vec<_>>();
                if spiral_session_matches(&scope, &fields) {
                    processes.push(SpiralSessionProcess { pid, socket: std::path::PathBuf::from(String::from_utf8_lossy(fields[2]).into_owned()) });
                }
            }
            processes.sort_by_key(|process| process.pid);
            Ok(processes)
        }

        """
    rust_global """
        #[cfg(unix)]
        fn spiral_session_lock_path(compiler: &str) -> Result<std::path::PathBuf, String> {
        """
    rust_global """
            let scope = spiral_compiler_scope(compiler)?;
            let mut hash = 14695981039346656037u64;
            for byte in scope.to_string_lossy().bytes() { hash ^= u64::from(byte); hash = hash.wrapping_mul(1099511628211); }
            Ok(std::env::temp_dir().join(format!("eoie-spiral-session-{hash:016x}.lock")))
        }

        #[cfg(unix)]
        fn spiral_session_lock(compiler: &str, exclusive: bool, timeout_ms: u64) -> Result<Option<std::fs::File>, String> {
            let compiler_name = std::path::Path::new(compiler).file_name().and_then(|value| value.to_str()).unwrap_or_default();
            if compiler_name != "spiral-compile-session" { return Ok(None); }
            let path = spiral_session_lock_path(compiler)?;
            let file = std::fs::OpenOptions::new().read(true).write(true).create(true).truncate(false).open(&path).map_err(|error| format!("open session lock {}: {error}", path.display()))?;
            let operation = if exclusive { 2 } else { 1 };
            let deadline = std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms);
            loop {
                let result = unsafe { flock(std::os::fd::AsRawFd::as_raw_fd(&file), operation | 4) };
                if result == 0 { return Ok(Some(file)); }
                let error = std::io::Error::last_os_error();
                if error.raw_os_error() != Some(11) { return Err(format!("lock session compiler {}: {error}", path.display())); }
                if std::time::Instant::now() >= deadline { return Err(format!("session compiler lock timed out after {timeout_ms} ms")); }
                std::thread::sleep(std::time::Duration::from_millis(10));
            }
        }

        #[cfg(not(unix))]
        fn spiral_session_lock(_compiler: &str, _exclusive: bool, _timeout_ms: u64) -> Result<Option<std::fs::File>, String> { Ok(None) }

        #[cfg(unix)]
        unsafe extern "C" {
            fn kill(pid: i32, signal: i32) -> i32;
            fn flock(fd: i32, operation: i32) -> i32;
        }

        #[cfg(unix)]
        fn signal_spiral_session(pid: i32, signal: i32) -> Result<(), String> {
            let group = unsafe { kill(-pid, signal) };
            let direct = unsafe { kill(pid, signal) };
            if group != 0 && direct != 0 {
                let error = std::io::Error::last_os_error();
                if error.raw_os_error() != Some(3) { return Err(format!("signal Spiral session {pid}: {error}")); }
            }
            Ok(())
        }

        #[cfg(not(unix))]
        fn signal_spiral_session(_pid: i32, _signal: i32) -> Result<(), String> {
            Err("process-tree signaling requires a Unix process model".to_owned())
        }

        fn remove_spiral_session_files(process: &SpiralSessionProcess) {
            for path in [process.socket.clone(), std::path::PathBuf::from(format!("{}.pid", process.socket.display())), std::path::PathBuf::from(format!("{}.start-lock", process.socket.display())), std::path::PathBuf::from(format!("{}.request-lock", process.socket.display()))] {
                let _ = if path.is_dir() { std::fs::remove_dir_all(path) } else { std::fs::remove_file(path) };
            }
        }

        fn wait_for_spiral_sessions(compiler: &str, deadline: std::time::Instant) -> Result<Vec<SpiralSessionProcess>, String> {
            loop {
                let remaining = spiral_session_processes(compiler)?;
                if remaining.is_empty() || std::time::Instant::now() >= deadline { return Ok(remaining); }
                std::thread::sleep(std::time::Duration::from_millis(20));
            }
        }

        pub fn shutdown_spiral_sessions(
            compiler: &str,
            timeout_ms: u64,
        ) -> Result<std::process::ExitStatus, String> {
            if timeout_ms == 0 { return Err("shutdown timeout must be positive".to_owned()); }
            let compiler_name = std::path::Path::new(compiler).file_name().and_then(|value| value.to_str()).unwrap_or_default();
            let mut status_command = std::process::Command::new(compiler);
            status_command.arg("--version");
            let status = run_bounded(&mut status_command, timeout_ms.saturating_add(5000))?;
            if !status.success() || compiler_name != "spiral-compile-session" { return Ok(status); }
            let _lease = spiral_session_lock(compiler, true, timeout_ms)?;
            let discovered = spiral_session_processes(compiler)?;
            for process in &discovered { signal_spiral_session(process.pid, 15)?; }
            let deadline = std::time::Instant::now() + std::time::Duration::from_millis(timeout_ms);
            let mut remaining = wait_for_spiral_sessions(compiler, deadline)?;
            if !remaining.is_empty() {
                for process in &remaining { signal_spiral_session(process.pid, 9)?; }
                remaining = wait_for_spiral_sessions(compiler, std::time::Instant::now() + std::time::Duration::from_millis(1000))?;
            }
            for process in &discovered { remove_spiral_session_files(process); }
            if !remaining.is_empty() {
                return Err(format!("Spiral session shutdown left {} server(s): {:?}", remaining.len(), remaining.iter().map(|process| process.pid).collect::<Vec<_>>()));
            }
            Ok(status)
        }
        """

inl emit_run_bounded_program_in_dir () =
    rust_global """
        pub fn run_bounded_program_in_dir(program: &str, cwd: &std::path::Path, timeout_ms: u64) -> Result<std::process::ExitStatus, String> {
            if program.is_empty() { return Err("gate program must not be empty".to_owned()); }
            let mut command = std::process::Command::new(program);
            command.current_dir(cwd);
            run_bounded(&mut command, timeout_ms)
        }
        """

inl main () : i32 =
    rust_global """include!(concat!(env!("CARGO_MANIFEST_DIR"), "/native_compiler.rs"));"""
    emit_run_bounded ()
    emit_run_bounded_program_in_dir ()
    rust_global "pub use eoie_process_streaming::{bounded_process_tree_capability, run_bounded_capture_with_input, run_bounded_streaming, ProcessCapture, ProcessStreamKind, ProcessTermination};"
    rust_global "pub use eoie_compiler_discovery::{resolve_spiral_compiler, SpiralCompilerDiscovery};"
    emit_compile_spiral ()
    emit_typecheck_spiral_file ()
    emit_shutdown_sessions ()
    inl _ = process_timeout_valid_export 1i32 0i32
    inl _ = process_compiler_budget_valid_export 1i32 1i32
    inl _ = process_session_match_export 3i32 7i32
    !!!!Export("eoie_process_timeout_valid_binding", ((fun (first, second) => process_timeout_valid_export first second) : i32 * i32 -> i32))
    !!!!Export("eoie_process_compiler_budget_valid_binding", ((fun (first, second) => process_compiler_budget_valid_export first second) : i32 * i32 -> i32))
    !!!!Export("eoie_process_session_match_binding", ((fun (first, second) => process_session_match_export first second) : i32 * i32 -> i32))
    0i32
