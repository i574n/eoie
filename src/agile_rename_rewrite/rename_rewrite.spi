open agile_task_text.model
open agile_note_model.model
open workspace_primitives.outcome
open workspace_primitives.numbers
open workspace_primitives.bytes
open sm'_operators

inl negated (value : bool) : bool = if value then false else true

type rename_tally =
    {
        items : i32
        deps_tasks : string
        deps_count : i32
        title_tasks : string
        title_count : i32
    }

inl listed (~list : string) (~id : string) : string = if list = "" then id else list ++# "," ++# id

let rec deps_renamed (~deps : string) (~offset : i32) (~length : i32) (~old : string) (~new : string) (~kept : string) (~changed : bool) : string * bool =
    if length <= offset then kept, changed
    else
        inl found = byte_find_from deps "," offset
        inl stop = if found < 0i32 then length else found
        inl next = if found < 0i32 then length else found + 1i32
        inl entry = sm'.trim (byte_slice deps offset stop)
        inl hit = entry = old
        inl written = if hit then new else entry
        deps_renamed deps next length old new (listed kept written) (if hit then true else changed)

inl task_field_bounds (~line : string) (found : i32) (position : i32) : i32 * i32 =
    inl length = byte_len line
    inl start = field_start line (found + item_arguments_offset TaskItem) length position
    start, field_end line start length ScanPlain

let dependent_line (~line : string) (found : i32) (~old : string) (~new : string) (~tally : rename_tally) : string * rename_tally =
    inl id_start, id_stop = task_field_bounds line found 0i32
    inl owner = unquoted (byte_slice line id_start id_stop)
    inl title_start, title_stop = task_field_bounds line found 1i32
    inl mentions = if byte_find (byte_slice line title_start title_stop) old < 0i32 then false else true
    inl tally = if mentions then { tally with title_tasks = listed tally.title_tasks owner; title_count = (tally.title_count + 1i32) } else tally
    inl deps_start, deps_stop = task_field_bounds line found 7i32
    inl deps = unquoted (byte_slice line deps_start deps_stop)
    inl renamed, changed = deps_renamed deps 0i32 (byte_len deps) old new "" false
    if changed then
        spliced line deps_start deps_stop (spi_quoted renamed), { tally with deps_tasks = listed tally.deps_tasks owner; deps_count = (tally.deps_count + 1i32) }
    else line, tally

inl rebound (~line : string) (found : i32) (kind : item_kind) (~binding : string) (~old : string) (~new : string) : string =
    inl rest = byte_slice line (found + byte_len (item_anchor kind old)) (byte_len line)
    "inl " ++# binding ++# " () = " ++# item_anchor kind new ++# rest

inl note_sequence (~line : string) (found : i32) : string = sm'.replace "u32" "" (item_field line NoteItem found 1i32)

let renamed_line (~line : string) (~old : string) (~new : string) (~tally : rename_tally) : string * rename_tally =
    if sm'.starts_with "inl " line then
        inl task = byte_find line (item_anchor TaskItem old)
        inl planning = byte_find line (item_anchor PlanningItem old)
        inl note = byte_find line (item_anchor NoteItem old)
        inl counted = { tally with items = (tally.items + 1i32) }
        if negated (task < 0i32) then rebound line task TaskItem (item_binding new) old new, counted
        elif negated (planning < 0i32) then rebound line planning PlanningItem (planning_binding new) old new, counted
        elif negated (note < 0i32) then
            inl binding = "note_of_" ++# item_binding new ++# "_" ++# note_sequence line note
            rebound line note NoteItem binding old new, counted
        else
            inl other = byte_find line (task_marker ())
            if other < 0i32 then line, tally else dependent_line line other old new tally
    else line, tally

let rec renamed_from (~text : string) (~offset : i32) (~length : i32) (~old : string) (~new : string) (~written : string) (~tally : rename_tally) : string * rename_tally =
    if length <= offset then written, tally
    else
        inl found = byte_find_from text "\n" offset
        inl stop = if found < 0i32 then length else found
        inl line, tally = renamed_line (byte_slice text offset stop) old new tally
        inl ending = if found < 0i32 then "" else "\n"
        renamed_from text (stop + 1i32) length old new (written ++# line ++# ending) tally

inl empty_tally () : rename_tally = { items = 0i32; deps_tasks = ""; deps_count = 0i32; title_tasks = ""; title_count = 0i32 }

let renamed_text (~text : string) (~old : string) (~new : string) : string * i32 * i32 * string * i32 * string =
    inl updated, tally = renamed_from text 0i32 (byte_len text) old new "" (empty_tally ())
    updated, tally.items, tally.deps_count, tally.deps_tasks, tally.title_count, tally.title_tasks

inl main () : i32 =
    !!!!Export("eoie_agile_renamed_text", ((fun (text, old, new) => renamed_text text old new) : string * string * string -> string * i32 * i32 * string * i32 * string))
    inl _ = renamed_text "" "A" "B"
    0i32