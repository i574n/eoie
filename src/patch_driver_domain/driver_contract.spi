let patch_driver_witness_binding (authorized : i32) (parsed : i32) : i32 =
    if authorized < 1i32 then -1i32
    elif 1i32 < authorized then -1i32
    elif parsed < 1i32 then -1i32
    else parsed

let patch_driver_operation_binding (cursor : i32) (observed : i32) : i32 =
    if cursor < 0i32 then -1i32
    elif observed < 0i32 then -1i32
    elif cursor < observed then -1i32
    elif observed < cursor then -1i32
    else cursor + 1i32

let patch_driver_stage_count_binding (expected : i32) (observed : i32) : i32 =
    if expected < 0i32 then -1i32
    elif observed < 0i32 then -1i32
    elif expected < observed then -1i32
    elif observed < expected then -1i32
    else expected

let patch_driver_promotion_binding (cursor : i32) (observed : i32) : i32 =
    patch_driver_operation_binding cursor observed

let patch_driver_complete_binding (expected : i32) (observed : i32) : i32 =
    if expected < 0i32 then 0i32
    elif observed < 0i32 then 0i32
    elif expected < observed then 0i32
    elif observed < expected then 0i32
    else 1i32