open sm'_operators

let argument (~index : i32) : string = optionm'.default_value "" (env.try_command_line_argument (index - 1i32))
inl option_value (~name : string) : string = $'std::rc::Rc::<str>::from({ let args = std::env::args().collect::<Vec<_>>(); args.iter().position(|argument| argument == &*!name).and_then(|at| args.get(at + 1)).cloned().unwrap_or_default() }.as_str())' : string
inl stdout_text (~text : string) : () = $'{ use std::io::Write; let _ = std::io::stdout().lock().write_all((!text).as_bytes()); }' : ()
inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()
inl stderr_line (~text : string) : () = $'eprintln\!("{}", &*!text)' : ()
inl text_of (~path : string) : string = $'std::rc::Rc::<str>::from(std::fs::read_to_string(&*!path).unwrap_or_default().replace(char::from(13u8), "").as_str())' : string
union write_outcome =
    | Written
    | WriteFailed : string

inl write_problem (~path : string) (~text : string) : string = $'std::rc::Rc::<str>::from({ let target = std::path::Path::new(&*!path); target.parent().filter(|parent| \!parent.as_os_str().is_empty()).map(std::fs::create_dir_all).transpose().and_then(|_| std::fs::write(target, (!text).as_bytes())).err().map(|error| error.to_string()).unwrap_or_default() }.as_str())' : string
inl text_written (~path : string) (~text : string) : write_outcome =
    inl problem = write_problem path text
    if problem = "" then Written else WriteFailed problem
inl line_end_from (~text : string) (offset : i32) : i32 = $'(!text).get(!offset as usize..).and_then(|rest| rest.find(char::from(10u8))).map(|at| at as i32 + !offset).unwrap_or((!text).len() as i32)' : i32
inl text_between (~text : string) (start : i32) (stop : i32) : string = $'std::rc::Rc::<str>::from((!text).get(!start as usize..!stop as usize).unwrap_or(""))' : string
inl text_length (~text : string) : i32 = sm'.length text
inl count_text (value : i32) : string = $'std::rc::Rc::<str>::from((!value).to_string().as_str())' : string

union guide_place =
    | BetweenBlocks
    | InHabit
    | InCommand

type guide_tally =
    {
        intents : i32
        text : string
    }

inl line_guided (place : guide_place) (~line : string) (tally : guide_tally) : guide_place * guide_tally =
    match place with
    | InHabit =>
        if line = "" then BetweenBlocks, { tally with text = tally.text ++# "\n" }
        else InHabit, { tally with text = tally.text ++# " " ++# line }
    | InCommand =>
        if line = "```" then BetweenBlocks, { tally with text = tally.text ++# "```\n" }
        else InCommand, { tally with text = tally.text ++# line ++# "\n" }
    | BetweenBlocks =>
        if sm'.starts_with "## " line then BetweenBlocks, { intents = tally.intents + 1i32; text = tally.text ++# "\n" ++# line ++# "\n" }
        elif sm'.starts_with "Habit" line then InHabit, { tally with text = tally.text ++# "\nInstead of: " ++# line }
        elif line = "```command" then InCommand, { tally with text = tally.text ++# "\nOne call:\n\n```sh\n" }
        else BetweenBlocks, tally

let rec guided (~spec : string) (offset : i32) (place : guide_place) (tally : guide_tally) : guide_tally =
    if offset >= text_length spec then tally
    else
        inl stop = line_end_from spec offset
        inl next_place, next_tally = line_guided place (text_between spec offset stop) tally
        guided spec (stop + 1i32) next_place next_tally

inl guide_heading () : string = "# eoie one-call guide\n\nGenerated by eoie guide from spec/one-call.md: per intent, the habit it replaces and the one eoie call. Do not edit by hand; regenerate.\n"

let guide_run () : i32 =
    inl spec_path = argument 2i32
    inl spec = text_of spec_path
    if spec = "" then
        stderr_line "eoie error: guide needs a readable spec file; usage: guide <spec/one-call.md> [--out <file.md>]"
        2i32
    else
        inl tally = guided spec 0i32 BetweenBlocks { intents = 0i32; text = guide_heading () }
        inl out = option_value "--out"
        if out = "" then
            stdout_text tally.text
            0i32
        else
            match text_written out tally.text with
            | Written =>
                stdout_line ("eoie guide ok intents=" ++# (count_text tally.intents) ++# " out=" ++# out)
                0i32
            | WriteFailed problem =>
                stderr_line ("eoie error: guide could not write " ++# out ++# ": " ++# problem)
                2i32

inl main () : i32 =
    !!!!Export("eoie_guide_run", ((fun () => guide_run ()) : () -> i32))
    0i32