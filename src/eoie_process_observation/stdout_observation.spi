nominal stdout_process_idle = ()
nominal stdout_process_running = ()
nominal stdout_process_done = ()

union stdout_process_plan from to =
    | StdoutProcessLaunch :: string * u64 -> stdout_process_plan stdout_process_idle stdout_process_running
    | StdoutProcessConsume :: stdout_process_plan stdout_process_running stdout_process_done

inl smoke_stdout_plan () : stdout_process_plan stdout_process_idle stdout_process_running =
    StdoutProcessLaunch ("stdout-observation-smoke", 5000u64)

inl rust_global (x : string) : () = !!!!Global(x)

inl emit_runtime () : () =
    rust_global """
        #[derive(Debug)]
        pub struct ProcessStdoutObservation {
            pub status: std::process::ExitStatus,
            pub termination: ProcessTermination,
            pub elapsed_ms: u64,
            pub stdout_bytes: u64,
            pub stdout_digest: String,
            pub timed_out: bool,
            pub stderr: Vec<u8>,
        }

        pub struct ProcessDigestReader<R> {
            inner: R,
            bytes: u64,
            hash: u64,
        }

        impl<R: std::io::Read> ProcessDigestReader<R> {
            fn new(inner: R) -> Self { Self { inner, bytes: 0, hash: 0xcbf29ce484222325 } }
            fn digest(&self) -> String { format!("fnv1a64:{:016x}", self.hash) }
        }

        impl<R: std::io::Read> std::io::Read for ProcessDigestReader<R> {
            fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
                let count = self.inner.read(buffer)?;
                self.bytes = self.bytes.saturating_add(count as u64);
                for byte in &buffer[..count] {
                    self.hash = (self.hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3);
                }
                Ok(count)
            }
        }

        fn process_stdout_termination(status: &std::process::ExitStatus, timed_out: bool) -> ProcessTermination {
            if timed_out { return ProcessTermination::TimedOut; }
            #[cfg(unix)] {
                use std::os::unix::process::ExitStatusExt;
                if let Some(signal) = status.signal() { return ProcessTermination::Signaled(signal); }
            }
            ProcessTermination::Exited(status.code().unwrap_or(-1))
        }

        #[cfg(unix)]
        unsafe extern "C" { fn kill(pid: i32, signal: i32) -> i32; }

        #[cfg(unix)]
        fn process_stdout_kill_tree(pid: u32) {
            #[cfg(unix)] {
                if let Ok(pid) = i32::try_from(pid) {
                    let _ = unsafe { kill(-pid, 9) };
                    let _ = unsafe { kill(pid, 9) };
                }
            }
        }

        fn process_stdout_stderr_reader(mut stderr: std::process::ChildStderr) -> std::thread::JoinHandle<Result<Vec<u8>, String>> {
            std::thread::spawn(move || {
                let mut captured = Vec::new();
                let mut buffer = [0u8; 8192];
                loop {
                    let count = std::io::Read::read(&mut stderr, &mut buffer).map_err(|error| format!("read process stderr: {error}"))?;
                    if count == 0 { break; }
                    if captured.len() < 262144 {
                        let keep = (262144usize - captured.len()).min(count);
                        captured.extend_from_slice(&buffer[..keep]);
                    }
                }
                Ok(captured)
            })
        }

        fn emit_process_stdout_exit_receipt(command: &std::process::Command, label: &str, observation: &ProcessStdoutObservation) {
            let outcome = if observation.termination == ProcessTermination::TimedOut { 3 }
                else { match observation.termination { ProcessTermination::Signaled(_) => 2, _ if observation.status.success() => 0, _ => 1 } };
            let wrapper_status = eoie_process_receipt_policy_binding(outcome, 0);
            let retryability = eoie_process_receipt_policy_binding(outcome, 1);
            let child_exit = observation.status.code().map_or_else(|| "none".to_owned(), |code| code.to_string());
            let signal = match observation.termination { ProcessTermination::Signaled(signal) => signal.to_string(), _ => "none".to_owned() };
            let timeout = i32::from(observation.termination == ProcessTermination::TimedOut);
            let (cwd, program, env_names) = process_receipt_command_fields(command);
            println!("eoie process-exit receipt label={label} wrapper_status={} child_exit={} signal={} timeout={} stderr_digest={} retryability={} cwd={:?} program={:?} env_names={} elapsed_ms={} stdout_bytes={} stderr_bytes={} stdout_digest={} stdout_mode=consumed", process_receipt_status_name(wrapper_status), child_exit, signal, timeout, process_receipt_digest(&observation.stderr), process_receipt_retry_name(retryability), cwd, program, env_names, observation.elapsed_ms, observation.stdout_bytes, observation.stderr.len(), observation.stdout_digest);
        }

        pub fn run_bounded_stdout_receipted<T, F>(
            command: &mut std::process::Command,
            timeout_ms: u64,
            label: &str,
            consume: F,
        ) -> Result<(T, ProcessStdoutObservation), String>
        where
            F: FnOnce(&mut ProcessDigestReader<std::process::ChildStdout>) -> Result<T, String>,
        {
            if timeout_ms == 0 { return Err("stdout consumer timeout must be positive".to_owned()); }
            #[cfg(unix)] {
                use std::os::unix::process::CommandExt;
                command.process_group(0);
            }
            command.stdin(std::process::Stdio::null()).stdout(std::process::Stdio::piped()).stderr(std::process::Stdio::piped());
            let started = std::time::Instant::now();
            #[cfg(windows)] let (mut child, windows_job) = eoie_process::WindowsJob::spawn(command)?;
            #[cfg(windows)] let windows_job = std::sync::Arc::new(windows_job);
            #[cfg(not(windows))] let mut child = match command.spawn() {
                Ok(child) => child,
                Err(error) => {
                    let text = format!("spawn process: {error}");
                    emit_process_error_receipt(command, label, 0, &text);
                    return Err(text);
                }
            };
            #[cfg(unix)] let pid = child.id();
            let stdout = child.stdout.take().ok_or_else(|| "process stdout was not piped".to_owned())?;
            let stderr = child.stderr.take().ok_or_else(|| "process stderr was not piped".to_owned())?;
            let stderr_reader = process_stdout_stderr_reader(stderr);
            let timed_out = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
            let timed_out_watch = timed_out.clone();
            let (done_tx, done_rx) = std::sync::mpsc::channel::<()>();
            #[cfg(windows)] let watchdog_job = windows_job.clone();
            let watchdog = std::thread::spawn(move || {
                if done_rx.recv_timeout(std::time::Duration::from_millis(timeout_ms)).is_err() {
                    timed_out_watch.store(true, std::sync::atomic::Ordering::SeqCst);
                    #[cfg(unix)] process_stdout_kill_tree(pid);
                    #[cfg(windows)] watchdog_job.terminate();
                }
            });
            let mut reader = ProcessDigestReader::new(stdout);
            let consumed = consume(&mut reader);
            let stdout_bytes = reader.bytes;
            let stdout_digest = reader.digest();
            drop(reader);
            if consumed.is_err() {
                #[cfg(unix)] process_stdout_kill_tree(pid);
                #[cfg(windows)] windows_job.terminate();
            }
            let status = child.wait().map_err(|error| format!("wait process: {error}"))?;
            #[cfg(windows)] windows_job.terminate();
            let _ = done_tx.send(());
            let _ = watchdog.join();
            let stderr = stderr_reader.join().map_err(|_| "stderr reader panicked".to_owned())??;
            let elapsed_ms = u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX);
            let observation = ProcessStdoutObservation {
                termination: process_stdout_termination(&status, timed_out.load(std::sync::atomic::Ordering::SeqCst)),
                status,
                elapsed_ms,
                stdout_bytes,
                stdout_digest,
                timed_out: timed_out.load(std::sync::atomic::Ordering::SeqCst),
                stderr,
            };
            emit_process_stdout_exit_receipt(command, label, &observation);
            match consumed { Ok(value) => Ok((value, observation)), Err(error) => Err(error) }
        }

        """

inl main () : i32 =
    inl _ = smoke_stdout_plan ()
    0i32