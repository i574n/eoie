let toolchain_argument_token_high_binding (action_code : i32) (position : i32) : i32 =
    if action_code < 4i32 then -1i32
    elif 7i32 < action_code then -1i32
    elif position < 0i32 then -1i32
    elif action_code = 4i32 then
        if position = 0i32 then 6i32 elif position = 1i32 then 1i32 elif position = 2i32 then 7i32 elif position = 3i32 then 3i32 elif position = 4i32 then 9i32 elif position = 5i32 then 10i32 else -1i32
    elif action_code = 5i32 then
        if position = 0i32 then 11i32 elif position = 1i32 then 13i32 elif position = 2i32 then 1i32 elif position = 3i32 then 7i32 else -1i32
    elif position = 0i32 then 12i32
    else -1i32
