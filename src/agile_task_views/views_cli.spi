///- --package ../eoie_cli_harness --timeout 900000
open cli

inl agile_call (root : fixture_root) (args : cli_args) : cli_run = eoie_run (fixture_text_of root) NoArgs NoArgs (Arg ("agile", args))

inl backlog () : string =
    "inl task_eoie_a () = Task (\"EOIE-A\", \"view item\", Story, P1, D2, 0u32, Planned, \"\", \"eoie\", \"current\", \"current\")\ninl task_eoie_b () = Task (\"EOIE-B\", \"done item\", Story, P1, D2, 100u32, Done, \"\", \"eoie\", \"current\", \"current\")\ninl task_main_c () = Task (\"MAIN-C\", \"other team\", Story, P0, D1, 0u32, Planned, \"\", \"\", \"current\", \"current\")\ninl main () : i32 = 0i32\n"

///> rust
test a_saved_view_runs_its_stored_flags_in_one_call =
    inl root = fixture_root_create "agile views"
    fixture_write root "state/agile.spi" (backlog ())
    inl here = fixture_text_of root
    shows (succeeded (agile_call root (Arg ("views", Arg (here, NoArgs))))) "eoie agile views ok views=0"
    shows (succeeded (agile_call root (Arg ("view-add", Arg (here, Arg ("eoie-open", Arg ("list", Arg ("--team", Arg ("eoie", Arg ("--open", NoArgs)))))))))) "eoie agile view-add ok name=eoie-open verb=list flags='--team eoie --open' replaced=no"
    inl listed = succeeded (agile_call root (Arg ("view", Arg (here, Arg ("eoie-open", NoArgs)))))
    shows listed "EOIE-A"
    hides listed "EOIE-B"
    hides listed "MAIN-C"
    shows (succeeded (agile_call root (Arg ("view-add", Arg (here, Arg ("eoie-open", Arg ("list", Arg ("--team", Arg ("eoie", NoArgs))))))))) "replaced=yes"
    inl replaced = succeeded (agile_call root (Arg ("view", Arg (here, Arg ("eoie-open", NoArgs)))))
    shows replaced "EOIE-B"
    hides (succeeded (agile_call root (Arg ("view", Arg (here, Arg ("eoie-open", Arg ("--open", NoArgs))))))) "EOIE-B"
    inl views = succeeded (agile_call root (Arg ("views", Arg (here, NoArgs))))
    shows views "eoie-open  list  --team eoie"
    shows views "eoie agile views ok views=1"
    shows (fixture_read root "state/views.spi") "inl view_eoie_open () = View (\"eoie-open\", \"list\", \"--team eoie\")"
    rejected_with (agile_call root (Arg ("view", Arg (here, Arg ("missing", NoArgs))))) 2i32 "no view named missing"
    rejected_with (agile_call root (Arg ("view-add", Arg (here, Arg ("Bad", Arg ("list", NoArgs)))))) 2i32 "view names are lowercase letters, digits and hyphens"
    rejected_with (agile_call root (Arg ("view-add", Arg (here, Arg ("shown", Arg ("show", NoArgs)))))) 2i32 "view verbs are list|next"
    rejected_with (agile_call root (Arg ("view-add", Arg (here, Arg ("spaced", Arg ("list", Arg ("--tag", Arg ("two words", NoArgs)))))))) 2i32 "each stored flag must be one word"
    fixture_root_remove root
