inl main () : i32 =
    inl run_gate = toolchain_execution_gate_binding 1i32 0i32
    inl hold_gate = toolchain_execution_gate_binding 2i32 0i32
    inl invalid_gate = toolchain_execution_gate_binding 6i32 0i32
    inl timeout = toolchain_observed_outcome_binding 1i32 0i32
    inl passed = toolchain_observed_outcome_binding 0i32 1i32
    inl failed = toolchain_observed_outcome_binding 0i32 0i32
    inl invalid = toolchain_observed_outcome_binding 2i32 0i32
    if run_gate = 1i32 && hold_gate = 0i32 && invalid_gate < 0i32 && timeout = 3i32 && passed = 1i32 && failed = 2i32 && invalid < 0i32 then 0i32 else 70i32
