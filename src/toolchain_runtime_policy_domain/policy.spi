let toolchain_execution_gate_binding (checkpoint : i32) (reserved : i32) : i32 =
    if reserved < 0i32 then -1i32
    elif 0i32 < reserved then -1i32
    elif checkpoint < 0i32 then -1i32
    elif 5i32 < checkpoint then -1i32
    elif checkpoint = 1i32 then 1i32
    else 0i32

let toolchain_observed_outcome_binding (timed_out : i32) (success : i32) : i32 =
    if timed_out < 0i32 then -1i32
    elif 1i32 < timed_out then -1i32
    elif success < 0i32 then -1i32
    elif 1i32 < success then -1i32
    elif timed_out = 1i32 then 3i32
    elif success = 1i32 then 1i32
    else 2i32
