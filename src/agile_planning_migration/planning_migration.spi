open rust_std_fs.model
open agile_task_text.model
open workspace_primitives.outcome
open workspace_primitives.numbers
open workspace_primitives.bytes
open workspace_primitives.clock
open workspace_primitives.console
open workspace_primitives.files

inl argument_owned index : string = rust_std_env.model.argument_owned index
inl argument_count () : i32 = $'std::env::args().skip(2).count() as i32' : i32
inl i32_sum (a : i32) (b : i32) : i32 = $"!a + !b"

union migration_mode =
    | MigrationDryRun
    | MigrationApply

union planning_step =
    | StepText : string
    | StepRejected : string

inl step_from (code, detail) : planning_step = if code = 0i32 then StepText detail else StepRejected detail

let value_token (~field_name : string) (~value : string) : planning_step =
    step_from ($'agile_planning_values::eoie_agile_planning_value_token(&*!field_name, &*!value)' : i32 * string)

let rewritten (~text : string) (~id : string) (~field_name : string) (~token : string) : planning_step =
    step_from ($'agile_planning_rewrite::eoie_agile_planning_rewrite(&*!text, &*!id, &*!field_name, &*!token)' : i32 * string)

inl legacy_agent_value (~value : string) : string = $'agile_planning_values::eoie_agile_planning_legacy_agent_value(&*!value)' : string
inl planning_summary (~text : string) (~id : string) : string = $'agile_planning_fields::eoie_agile_planning_summary(&*!text, &*!id)' : string

union tag_kind =
    | PlainTag
    | PlanningTag : string * string

inl tag_rest (~tag : string) (~prefix : string) : string = byte_slice tag (byte_len prefix) (byte_len tag)

let tag_kind_of (~tag : string) : tag_kind =
    if rust_std_string.model.starts_with tag "est:" then PlanningTag ("estimate", tag_rest tag "est:")
    elif rust_std_string.model.starts_with tag "load:" then PlanningTag ("load", tag_rest tag "load:")
    elif rust_std_string.model.starts_with tag "agent:" then PlanningTag ("assignee", legacy_agent_value (tag_rest tag "agent:"))
    else PlainTag

type tag_pass =
    {
        text : string
        kept : string
        moved : i32
        rejected : string
        rejections : i32
    }

inl joined (~list : string) (~item : string) : string =
    if rust_std_string.model.equals list "" then item else rust_std_string.model.concat5 list "," item "" ""

let fresh_tag_pass (~text : string) : tag_pass = { text = text; kept = ""; moved = 0i32; rejected = ""; rejections = 0i32 }

inl tag_kept (pass : tag_pass) (~tag : string) : tag_pass = { pass with kept = joined pass.kept tag }
inl tag_rejected (pass : tag_pass) (~tag : string) : tag_pass =
    { pass with kept = joined pass.kept tag; rejected = joined pass.rejected tag; rejections = (pass.rejections + 1i32) }

let tag_moved (pass : tag_pass) (~id : string) (~tag : string) (~field_name : string) (~token : string) : tag_pass =
    match rewritten pass.text id field_name token with
    | StepText updated => { pass with text = updated; moved = (pass.moved + 1i32) }
    | StepRejected _ => tag_rejected pass tag

let tag_applied (pass : tag_pass) (~id : string) (~tag : string) : tag_pass =
    match tag_kind_of tag with
    | PlainTag => tag_kept pass tag
    | PlanningTag (field_name, value) =>
        match value_token field_name value with
        | StepText token => tag_moved pass id tag field_name token
        | StepRejected _ => tag_rejected pass tag

let rec tags_applied (pass : tag_pass) (~id : string) (~tags : string) (offset : i32) : tag_pass =
    if byte_len tags <= offset then pass
    else
        inl comma = byte_find_from tags "," offset
        inl stop = if comma < 0i32 then byte_len tags else comma
        inl tag = byte_slice tags offset stop
        inl continued = if byte_len tag = 0i32 then pass else tag_applied pass id tag
        tags_applied continued id tags (stop + 1i32)

inl unquoted (~token : string) : string = byte_slice token 1i32 (byte_len token - 1i32)
inl tags_position () : i32 = 8i32
inl task_anchor (~id : string) : string = rust_std_string.model.concat5 "Task (\"" id "\"," "" ""

let tags_replaced (~text : string) (~id : string) (~tags : string) : string =
    inl length = byte_len text
    inl found = byte_find text (task_anchor id)
    inl start = field_start text ($"!found + !(task_arguments_offset ())" : i32) length (tags_position ())
    inl stop = field_end text start length ScanPlain
    rust_std_string.model.concat5 (byte_slice text 0i32 start) (spi_quoted tags) (byte_slice text stop length) "" ""

inl task_line_end (~text : string) (~id : string) : i32 =
    inl found = byte_find_from text "\n" (byte_find text (task_anchor id))
    if found < 0i32 then byte_len text else found

type migration_pass =
    {
        state : string
        tasks : i32
        moved : i32
        rejections : i32
    }

let fresh_migration (~text : string) : migration_pass = { state = text; tasks = 0i32; moved = 0i32; rejections = 0i32 }

inl rejection_note (pass : tag_pass) : string =
    if pass.rejections = 0i32 then "" else rust_std_string.model.concat5 " rejected=" pass.rejected "" "" ""

let task_report (~id : string) (pass : tag_pass) : i32 =
    inl head = rust_std_string.model.concat5 id " moved=" (i32_text pass.moved) " " (planning_summary pass.text id)
    stdout_line (rust_std_string.model.concat5 head " tags=" pass.kept (rejection_note pass) "")

let task_migrated (migration : migration_pass) (~id : string) (pass : tag_pass) : migration_pass =
    inl updated = tags_replaced pass.text id pass.kept
    inl _ = task_report id { pass with text = updated }
    { state = updated; tasks = (migration.tasks + 1i32); moved = (migration.moved + pass.moved); rejections = (migration.rejections + pass.rejections) }

let task_with_rejections (migration : migration_pass) (~id : string) (pass : tag_pass) : migration_pass =
    inl _ = task_report id pass
    { migration with rejections = (migration.rejections + pass.rejections) }

let rec migrated_from (migration : migration_pass) (offset : i32) : migration_pass =
    inl text = migration.state
    inl length = byte_len text
    inl found = byte_find_from text (task_marker ()) offset
    if found < 0i32 then migration
    else
        inl arguments = $"!found + !(task_arguments_offset ())" : i32
        if declared_task text found then
            inl field = tuple_field text arguments length
            inl id = unquoted (field 0i32)
            inl pass = tags_applied (fresh_tag_pass text) id (unquoted (field 8i32)) 0i32
            if 1i32 <= pass.moved then
                inl next = task_migrated migration id pass
                migrated_from next (task_line_end next.state id)
            elif 1i32 <= pass.rejections then migrated_from (task_with_rejections migration id pass) arguments
            else migrated_from migration arguments
        else migrated_from migration arguments

inl migration_counts (migration : migration_pass) : string =
    inl counts = rust_std_string.model.concat5 " tasks=" (i32_text migration.tasks) " tags_moved=" (i32_text migration.moved) " rejected="
    rust_std_string.model.concat5 counts (i32_text migration.rejections) "" "" ""

let migration_receipt (~verdict : string) (migration : migration_pass) (~original : string) (started : u64) : i32 =
    inl head = rust_std_string.model.concat5 "eoie agile migrate-tags " verdict (migration_counts migration) "" ""
    stdout_line (rust_std_string.model.concat5 head (measured_sizes (text_bytes original) (text_bytes migration.state) (ms_since started)) "" "" "")

inl migration_failure (~reason : string) : i32 = stderr_failure (rust_std_string.model.concat5 "agile migrate-tags rejected: " reason "" "" "")

let migration_written (~path : string) (migration : migration_pass) (~original : string) (started : u64) : i32 =
    if migration.tasks = 0i32 then migration_receipt "ok unchanged" migration original started
    else
        match replace_file_checked path migration.state with
        | Replaced => migration_receipt "ok" migration original started
        | problem => migration_failure (file_replacement_problem problem)

let tags_migration (~root : string) (mode : migration_mode) : i32 =
    inl started = unix_ms ()
    inl path = backlog_state_path root
    match probe (unchecked path) with
    | FileMissing _ => migration_failure "state/agile.spi is missing"
    | FileReadable file =>
        inl original = loaded_string (read_text file)
        if first_malformed_task original 0i32 (byte_len original) < 0i32 then
            inl migration = migrated_from (fresh_migration original) 0i32
            match mode with
            | MigrationDryRun => migration_receipt "preview" migration original started
            | MigrationApply => migration_written path migration original started
        else migration_failure "malformed Task fields"

inl migration_mode_of (~mode : string) : validation_result migration_mode =
    if rust_std_string.model.equals mode "apply" then Valid MigrationApply
    elif rust_std_string.model.equals mode "preview" then Valid MigrationDryRun
    else Invalid

let tags_migration_entry () : i32 =
    if argument_count () = 3i32 then
        match migration_mode_of (argument_owned 1i32) with
        | Valid mode => tags_migration (argument_owned 2i32) mode
        | Invalid => migration_failure "migrate-tags expects preview <root> or apply <root>"
    else migration_failure "migrate-tags expects preview <root> or apply <root>"

inl main () : i32 =
    !!!!Export("eoie_agile_migrate_tags_run", ((fun () => tags_migration_entry ()) : () -> i32))
    inl _ = tags_migration_entry ()
    0i32
