open eoie_do_records.records

nominal run_state = $'std::rc::Rc<std::cell::RefCell<(String, Vec<(String, std::process::Child, u64)>)>>'

nominal run_raw = $'(u8, i64, u64, u64)'

nominal step_outcome = $'std::rc::Rc<(std::rc::Rc<str>, u64, bool)>'

inl stdout_line (~text : string) : () = $'println\!("{}", &*!text)' : ()

let first_of_kind (~records : record_list) (~record : i32) (~kind : u8) : string =
    $'!records.get(!record as usize).and_then(|fields| fields.iter().skip(2).find(|field| field.as_bytes().first() == Some(&!kind)).map(|field| std::rc::Rc::<str>::from(&field[1..]))).unwrap_or_default()' : string

let command_words (~records : record_list) (~record : i32) : string =
    $'std::rc::Rc::<str>::from(!records.get(!record as usize).map(|fields| fields.iter().skip(2).take_while(|field| \![("w", "timeout"), ("w", "until"), ("w", "background"), ("w", "then")].iter().any(|(kind, word)| field.starts_with(kind) && &field[1..] == *word)).filter(|field| \!field.is_empty()).map(|field| if field.starts_with(char::from(113u8)) { format\!("{}{}{}", char::from(34u8), &field[1..], char::from(34u8)) } else { field[1..].to_owned() }).collect::<Vec<_>>().join(" ")).unwrap_or_default())' : string

let later_reads_output (~records : record_list) (~record : i32) : bool =
    $'!records.iter().skip(!record as usize + 1).any(|fields| fields.get(1).map(|verb| [ "tail", "search", "errors" ].contains(&&**verb)).unwrap_or(false))' : bool

let duration_ms (~text : string) : u64 =
    $'{ let text = (&*!text).trim(); let (digits, scale) = if let Some(value) = text.strip_suffix("ms") { (value, 1) } else if let Some(value) = text.strip_suffix(char::from(115u8)) { (value, 1000) } else if let Some(value) = text.strip_suffix(char::from(109u8)) { (value, 60000) } else { (text, 1000) }; digits.trim().parse::<u64>().map(|value| value * scale).unwrap_or(0) }' : u64

let duration_text (~millis : u64) : string =
    $'std::rc::Rc::<str>::from(if !millis < 10000 { format\!("{}ms", !millis) } else { format\!("{:.1}s", !millis as f64 / 1000.0) })' : string

let timeout_text (~millis : u64) : string =
    $'std::rc::Rc::<str>::from(if !millis % 1000 == 0 { format\!("{}s", !millis / 1000) } else { format\!("{}ms", !millis) })' : string

let decimal_of (~text : string) : u64 = optionm'.default_value 0u64 (convert.try_convert text)
inl signed_text (~value : i64) : string = $'std::rc::Rc::<str>::from((!value).to_string())' : string

let state_new () : run_state = $'std::rc::Rc::new(std::cell::RefCell::new((String::new(), Vec::new())))' : run_state

let launch_argv_via (~cwd : string) (~command : string) : string = $'eoie_command_line::eoie_launch_argv(&*!cwd, &*!command)' : string
let launch_line_via (~cwd : string) (~command : string) : string = $'eoie_command_line::eoie_launch_line(&*!cwd, &*!command)' : string

let run_spawned (~state : run_state) (~root : string) (~argv : string) (~line : string) (~name : string) : string =
    $'std::rc::Rc::<str>::from((|| -> std::io::Result<()> { let path = std::env::temp_dir().join(format\!("eoie-do-run-{}-{}.log", std::process::id(), std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|elapsed| elapsed.as_nanos()).unwrap_or(0))); let log = std::fs::File::create(&path)?; let log_errors = log.try_clone()?; let mut process = if (&*!line).is_empty() { let mut words = (&*!argv).split(char::from(10u8)); let mut process = std::process::Command::new(words.next().unwrap_or_default()); process.args(words); process } else { \#[cfg(windows)] let process = { use std::os::windows::process::CommandExt; let mut process = std::process::Command::new("cmd.exe"); process.arg("/c").raw_arg(&*!line).env_remove("NoDefaultCurrentDirectoryInExePath"); process }; \#[cfg(not(windows))] let process = { let mut process = std::process::Command::new("sh"); process.arg("-c").arg(&*!line); process }; process }; process.current_dir(&*!root).stdin(std::process::Stdio::null()).stdout(log).stderr(log_errors); \#[cfg(unix)] { use std::os::unix::process::CommandExt; process.process_group(0); } let child = process.spawn()?; \#[cfg(windows)] let job = { unsafe extern "system" { fn CreateJobObjectW(attributes: *mut std::ffi::c_void, name: *const u16) -> *mut std::ffi::c_void; fn SetInformationJobObject(job: *mut std::ffi::c_void, class: i32, information: *mut std::ffi::c_void, length: u32) -> i32; fn AssignProcessToJobObject(job: *mut std::ffi::c_void, process: *mut std::ffi::c_void) -> i32; } use std::os::windows::io::AsRawHandle; unsafe { let job = CreateJobObjectW(std::ptr::null_mut(), std::ptr::null()); if \!job.is_null() { let mut limits = [0u64; 18]; limits[2] = 0x800; SetInformationJobObject(job, 9, limits.as_mut_ptr().cast(), 144); AssignProcessToJobObject(job, child.as_raw_handle()); } job as u64 } }; \#[cfg(not(windows))] let job = 0u64; let mut state = !state.borrow_mut(); state.0 = path.to_string_lossy().into_owned(); state.1.push(((&*!name).to_owned(), child, job)); Ok(()) })().err().map(|error| format\!("spawn failed: {error}")).unwrap_or_default())' : string

let run_ended (~state : run_state) (~needle : string) (~timeout_ms : u64) : run_raw =
    $'{ let mut state = !state.borrow_mut(); let path = state.0.clone(); let Some((_, mut child, job)) = state.1.pop() else { return (6, 0, 0, 0) }; let stop = |child: &mut std::process::Child| { \#[cfg(windows)] { unsafe extern "system" { fn TerminateJobObject(job: *mut std::ffi::c_void, code: u32) -> i32; } if job \!= 0 { unsafe { TerminateJobObject(job as *mut std::ffi::c_void, 1); } } } \#[cfg(unix)] { let _ = job; let _ = std::process::Command::new("kill").arg("-KILL").arg("--").arg(format\!("-{}", child.id())).status(); } let _ = child.kill(); let _ = child.wait(); }; let pattern = if (&*!needle).is_empty() { None } else { match regex::Regex::new(&*!needle) { Ok(pattern) => Some(pattern), Err(_) => { stop(&mut child); return (6, 0, 0, 0); } } }; let started = std::time::Instant::now(); let limit = std::time::Duration::from_millis(!timeout_ms); let lines = || std::fs::read(&path).map(|bytes| String::from_utf8_lossy(&bytes).lines().count() as u64).unwrap_or(0); loop { if let Some(pattern) = &pattern { let text = std::fs::read(&path).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); if text.lines().any(|line| pattern.is_match(line)) { stop(&mut child); return (3, 0, started.elapsed().as_millis() as u64, lines()); } } if let Ok(Some(status)) = child.try_wait() { let code = status.code().map(|code| code as i64).unwrap_or(-1); return (if pattern.is_some() { 5 } else { 1 }, code, started.elapsed().as_millis() as u64, lines()); } if started.elapsed() >= limit { stop(&mut child); return (if pattern.is_some() { 4 } else { 2 }, 0, started.elapsed().as_millis() as u64, lines()); } std::thread::sleep(std::time::Duration::from_millis(50)); } }' : run_raw

inl raw_kind (~raw : run_raw) : u8 = $'!raw.0' : u8
inl raw_value (~raw : run_raw) : i64 = $'!raw.1' : i64
inl raw_elapsed (~raw : run_raw) : u64 = $'!raw.2' : u64
inl raw_lines (~raw : run_raw) : u64 = $'!raw.3' : u64

let background_pid (~state : run_state) : u64 = $'!state.borrow().1.last().map(|entry| entry.1.id() as u64).unwrap_or(0)' : u64

let run_stopped (~state : run_state) (~name : string) : bool =
    $'{ let mut state = !state.borrow_mut(); match state.1.iter().position(|entry| entry.0 == &*!name) { None => false, Some(index) => { let (_, mut child, job) = state.1.remove(index); \#[cfg(windows)] { unsafe extern "system" { fn TerminateJobObject(job: *mut std::ffi::c_void, code: u32) -> i32; } if job \!= 0 { unsafe { TerminateJobObject(job as *mut std::ffi::c_void, 1); } } } \#[cfg(unix)] { let _ = job; let _ = std::process::Command::new("kill").arg("-KILL").arg("--").arg(format\!("-{}", child.id())).status(); } let _ = child.kill(); let _ = child.wait(); true } } }' : bool

let output_lines (~state : run_state) (~count : u64) (~titled : bool) : string =
    $'{ let text = std::fs::read(&!state.borrow().0).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); let lines = text.lines().collect::<Vec<_>>(); let from = lines.len().saturating_sub(!count as usize); let mut shown = Vec::new(); if !titled { shown.push(format\!("output (last {} lines)", !count)); } else if from > 0 { shown.push(format\!("... {} earlier lines", from)); } shown.extend(lines[from..].iter().map(|line| line.to_string())); std::rc::Rc::<str>::from(shown.join("\n")) }' : string

let output_searched (~state : run_state) (~needle : string) : step_outcome =
    $'{ let text = std::fs::read(&!state.borrow().0).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); match regex::Regex::new(&*!needle) { Err(error) => std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("search: invalid pattern: {error}")), 0, true)), Ok(pattern) => { let hits = text.lines().enumerate().filter(|(_, line)| pattern.is_match(line)).map(|(index, line)| format\!("output:{}  {}", index + 1, line)).collect::<Vec<_>>(); std::rc::Rc::new((std::rc::Rc::<str>::from(hits.join("\n")), hits.len() as u64, false)) } } }' : step_outcome

let errors_grouped (~state : run_state) (~needle : string) : step_outcome =
    $'{ let text = std::fs::read(&!state.borrow().0).map(|bytes| String::from_utf8_lossy(&bytes).into_owned()).unwrap_or_default(); match regex::Regex::new(&*!needle) { Err(error) => std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("errors: invalid pattern: {error}")), 0, true)), Ok(pattern) => { let mut groups: Vec<(String, u64, String)> = Vec::new(); let mut total = 0u64; for line in text.lines() { if let Some(captures) = pattern.captures(line) { total += 1; let key = captures.get(1).or_else(|| captures.get(0)).map(|found| found.as_str().to_owned()).unwrap_or_default(); match groups.iter_mut().find(|group| group.0 == key) { Some(group) => group.1 += 1, None => groups.push((key, 1, line.trim().to_owned())) } } } groups.sort_by(|left, right| right.1.cmp(&left.1)); let width = groups.iter().map(|group| group.0.len()).max().unwrap_or(0).max(4); let count_width = groups.iter().map(|group| group.1.to_string().len()).max().unwrap_or(0).max(5); let mut shown = vec\![format\!("{:<width$}  {:<count_width$}  {}", "code", "count", "first")]; for group in &groups { shown.push(format\!("{:<width$}  {:<count_width$}  {}", group.0, group.1, group.2)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), total, false)) } } }' : step_outcome

let processes_listed (~needle : string) (~offset_minutes : i64) : step_outcome =
    $'{ match regex::RegexBuilder::new(&*!needle).case_insensitive(true).build() { Err(error) => std::rc::Rc::new((std::rc::Rc::<str>::from(format\!("processes: invalid pattern: {error}")), 0, true)), Ok(pattern) => { let system = sysinfo::System::new_with_specifics(sysinfo::RefreshKind::nothing().with_processes(sysinfo::ProcessRefreshKind::nothing().with_cmd(sysinfo::UpdateKind::Always))); let own = std::process::id(); let offset = !offset_minutes * 60; let mut rows = system.processes().iter().filter(|(pid, _)| pid.as_u32() \!= own).filter_map(|(pid, process)| { let command = process.cmd().iter().map(|part| part.to_string_lossy().into_owned()).collect::<Vec<_>>().join(" "); if pattern.is_match(&command) { Some((process.start_time(), pid.as_u32(), command)) } else { None } }).collect::<Vec<_>>(); rows.sort(); let pid_width = rows.iter().map(|row| row.1.to_string().len()).max().unwrap_or(0).max(7); let mut shown = vec\![format\!("{:<pid_width$}  {:<7}  {}", "pid", "started", "command")]; for (started, pid, command) in &rows { let local = (*started as i64 + offset).rem_euclid(86400); shown.push(format\!("{:<pid_width$}  {:<7}  {}", pid, format\!("{:02}:{:02}", local / 3600, local / 60 % 60), command)); } std::rc::Rc::new((std::rc::Rc::<str>::from(shown.join("\n")), rows.len() as u64, false)) } } }' : step_outcome

inl outcome_report (~outcome : step_outcome) : string = $'!outcome.0.clone()' : string
inl outcome_count (~outcome : step_outcome) : u64 = $'!outcome.1' : u64
inl outcome_failed (~outcome : step_outcome) : bool = $'!outcome.2' : bool
