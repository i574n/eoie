open eoie_do_model.model
open eoie_do_records.records

let runs_in (~encoded : string) : bool = ($'eoie_do_verbs::eoie_do_program_family(&*!encoded)' : string) = "runs"

inl decimal_of (~text : string) : u64 = $'!text.trim().parse::<u64>().unwrap_or(0)' : u64

let count_of (~kind : string) (~wanted : string) : replace_count =
    if kind = "once" then Once elif kind = "all" then Every else Exactly (decimal_of wanted)

let rec rules_decoded (~records : record_list) (~index : i32) : rule_list * i32 =
    if index < record_count records && (field_at records index 0i32 = "replace" || field_at records index 0i32 = "pattern") then
        inl rule = { anchor = field_at records index 3i32; replacement = field_at records index 4i32; count = count_of (field_at records index 1i32) (field_at records index 2i32); matcher = if field_at records index 0i32 = "pattern" then Pattern else Literal }
        inl rest, next = rules_decoded records (index + 1i32)
        (Rule (rule, rest), next)
    else (NoRules, index)

let rec steps_decoded (~records : record_list) (~index : i32) : steps =
    if index < record_count records then
        inl kind = field_at records index 0i32
        if kind = "edit" then
            inl files = field_at records index 3i32
            inl expectation = if files = "-" then Unchecked else Expected (decimal_of files, decimal_of (field_at records index 4i32))
            inl mode = if field_at records index 2i32 = "preview" then Preview else Apply
            inl excepted = field_at records (index + 1i32) 0i32 = "except"
            inl excluded = if excepted then field_at records (index + 1i32) 1i32 else ""
            inl rules, next = rules_decoded records (if excepted then index + 2i32 else index + 1i32)
            Step (EditStep { target = field_at records index 1i32; mode = mode; expectation = expectation; excluded = excluded; rules = rules }, steps_decoded records next)
        elif kind = "show" then Step (ShowStep (field_at records index 1i32), steps_decoded records (index + 1i32))
        else steps_decoded records (index + 1i32)
    else Done
