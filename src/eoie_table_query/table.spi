open rust_std_string.model
open query
open cells
open stats

let argument (~index : i32) : string = optionm'.default_value "" (env.try_command_line_argument (index - 1i32))
let argument_count () : i32 = env.command_line_argument_count () + 1i32

let rec options_from (index : i32) (count : i32) (request : table_request) : option_step =
    if index < count then
        if argument index = "--quiet" then options_from (index + 1i32) count { request with quiet = true }
        elif index + 1i32 < count then
            match option_applied request (argument index) (argument (index + 1i32)) with
            | StepTaken next => options_from (index + 2i32) count next
            | StepRejected reason => StepRejected reason
        else StepRejected (concat5 "option " (argument index) " has no value" "" "")
    else StepTaken request

let query_rows (~file : string) (~wheres : string) (~cols : string) (~group : string) (limit : u64) (quiet : bool) : i32 =
    $'(|| -> i32 { let path = &*!file; let text = match std::fs::read_to_string(path) { Ok(text) => text, Err(error) => { eprintln\!("eoie error: table {path}: {error}"); return 2; } }; let separator = if path.ends_with(".csv") { char::from(44u8) } else { char::from(9u8) }; let mut lines = text.lines(); let header = lines.next().unwrap_or("").split(separator).map(str::to_owned).collect::<Vec<_>>(); let column = |name: &str| header.iter().position(|item| item == name); let mut missing = Vec::new(); let mut filters = Vec::new(); let compare = |cell: &str, op: &str, value: &str| -> bool { if op == "=" { return cell == value; } if op == "\!=" { return cell \!= value; } let pair = cell.trim().parse::<f64>().ok().zip(value.trim().parse::<f64>().ok()); match (op, pair) { (">", Some((a, b))) => a > b, (">=", Some((a, b))) => a >= b, ("<", Some((a, b))) => a < b, ("<=", Some((a, b))) => a <= b, (">", None) => cell > value, (">=", None) => cell >= value, ("<", None) => cell < value, ("<=", None) => cell <= value, _ => false } }; for clause in (&*!wheres).lines() { if let Some(at) = clause.find(|c: char| c == char::from(60u8) || c == char::from(62u8) || c == char::from(61u8) || c == char::from(33u8)) { let bytes = clause.as_bytes(); let width = if at + 1 < bytes.len() && bytes[at + 1] == 61u8 && bytes[at] \!= 61u8 { 2 } else { 1 }; let name = &clause[..at]; match column(name) { Some(index) => filters.push((index, clause[at..at + width].to_owned(), clause[at + width..].to_owned())), None => missing.push(name.to_owned()) } } } let projection = if (&*!cols).is_empty() { (0..header.len()).collect::<Vec<_>>() } else { (&*!cols).split(char::from(44u8)).filter_map(|name| match column(name) { Some(index) => Some(index), None => { missing.push(name.to_owned()); None } }).collect::<Vec<_>>() }; let grouping = if (&*!group).is_empty() { None } else { match column(&*!group) { Some(index) => Some(index), None => { missing.push((&*!group).to_owned()); None } } }; if \!missing.is_empty() { eprintln\!("eoie error: table unknown columns: {} (header: {})", missing.join(","), header.join(",")); return 2; } let mut total = 0usize; let mut matched = 0usize; let mut shown = 0usize; let mut groups: std::collections::BTreeMap<String, usize> = std::collections::BTreeMap::new(); if grouping.is_none() { println\!("{}", projection.iter().map(|index| header[*index].as_str()).collect::<Vec<_>>().join("\t")); } for line in lines { total += 1; let cells = line.split(separator).collect::<Vec<_>>(); if \!filters.iter().all(|(index, op, value)| cells.get(*index).map(|cell| compare(cell, op, value)).unwrap_or(false)) { continue; } matched += 1; match grouping { Some(index) => { *groups.entry(cells.get(index).unwrap_or(&"").to_string()).or_insert(0) += 1; } None => { if (shown as u64) < !limit { println\!("{}", projection.iter().map(|index| *cells.get(*index).unwrap_or(&"")).collect::<Vec<_>>().join("\t")); shown += 1; } } } } if grouping.is_some() { let mut counted = groups.into_iter().collect::<Vec<_>>(); counted.sort_by(|left, right| right.1.cmp(&left.1).then_with(|| left.0.cmp(&right.0))); println\!("count\t{}", &*!group); for (value, count) in counted.iter().take(!limit as usize) { println\!("{count}\t{value}"); shown += 1; } if \!!quiet { println\!("eoie table query ok total={total} matched={matched} groups={} shown={shown}", counted.len()); } } else if \!!quiet { println\!("eoie table query ok total={total} matched={matched} shown={shown}"); } 0 })()' : i32

union where_op =
    | WhereEqual
    | WhereNotEqual
    | WhereGreater
    | WhereGreaterEqual
    | WhereLess
    | WhereLessEqual

inl where_op_of (~text : string) : where_op =
    if text = "!=" then WhereNotEqual
    elif text = ">" then WhereGreater
    elif text = ">=" then WhereGreaterEqual
    elif text = "<" then WhereLess
    elif text = "<=" then WhereLessEqual
    else WhereEqual

inl operator_at (~clause : string) : i32 = $'(!clause).find(|c: char| c == char::from(60u8) || c == char::from(62u8) || c == char::from(61u8) || c == char::from(33u8)).map(|at| at as i32).unwrap_or(-1)' : i32
inl operator_width (~clause : string) (at : i32) : i32 = $'{ let bytes = (!clause).as_bytes(); let at = !at as usize; if at + 1 < bytes.len() && bytes[at + 1] == 61u8 && bytes[at] \!= 61u8 { 2 } else { 1 } }' : i32
inl text_between (~text : string) (from : i32) (until : i32) : string = $'std::rc::Rc::<str>::from(&(!text)[!from as usize..!until as usize])' : string
inl text_length (~text : string) : i32 = sm'.length text
inl numbers_ordered (~cell : string) (~value : string) : i32 = $'match (!cell).trim().parse::<f64>().ok().zip((!value).trim().parse::<f64>().ok()) { Some((a, b)) => if a < b { -1 } else if a > b { 1 } else { 0 }, None => 2 }' : i32
inl texts_ordered (~cell : string) (~value : string) : i32 = $'match (&*!cell).cmp(&*!value) { std::cmp::Ordering::Less => -1, std::cmp::Ordering::Equal => 0, std::cmp::Ordering::Greater => 1 }' : i32

let cell_passes (op : where_op) (~cell : string) (~value : string) : bool =
    match op with
    | WhereEqual => cell = value
    | WhereNotEqual => cell <> value
    | ordered =>
        inl numeric = numbers_ordered cell value
        inl order = if numeric = 2i32 then texts_ordered cell value else numeric
        match ordered with
        | WhereGreater => order > 0i32
        | WhereGreaterEqual => order >= 0i32
        | WhereLess => order < 0i32
        | _ => order <= 0i32

union rec filters =
    | NoFilters
    | FilterThen : i32 * where_op * string * filters

let rec filters_from (cells : table_cells) (~wheres : string) : filters * string =
    if wheres = "" then NoFilters, ""
    else
        inl clause = head_of wheres "\n"
        inl at = operator_at clause
        inl width = if at < 0i32 then 0i32 else operator_width clause at
        inl name = if at < 0i32 then clause else text_between clause 0i32 at
        inl op = if at < 0i32 then WhereEqual else where_op_of (text_between clause at (at + width))
        inl value = if at < 0i32 then "" else text_between clause (at + width) (text_length clause)
        inl index = column_of cells name
        inl rest, missing = filters_from cells (tail_of wheres "\n")
        if index < 0i32 then rest, listed name missing
        else FilterThen (index, op, value, rest), missing

let rec row_passes (list : filters) (cells : table_cells) (row : i32) : bool =
    match list with
    | NoFilters => true
    | FilterThen (index, op, value, rest) => if cell_passes op (cell_at cells row index) value then row_passes rest cells row else false

inl measured (request : table_request) : bool = request.measured <> ""

let measured_query (~file : string) (request : table_request) : i32 =
    inl wheres, group, measures, limit, quiet = request.wheres, request.group, request.measured, request.limit, request.quiet
    $'eoie_table_measures::eoie_table_measured(&*!file, &*!wheres, &*!group, &*!measures, !limit, !quiet)' : i32

let table_run () : i32 =
    match table_command_of (argument 2i32) with
    | TableQuery =>
        if argument_count () < 4i32 then rejected (table_usage ())
        else
            match options_from 4i32 (argument_count ()) (no_request ()) with
            | StepTaken request =>
                if measured request then measured_query (argument 3i32) request
                else query_rows (argument 3i32) request.wheres request.cols request.group request.limit request.quiet
            | StepRejected reason => rejected reason
    | TableDiff =>
        if argument_count () < 5i32 then rejected (table_usage ())
        else
            match options_from 5i32 (argument_count ()) (no_request ()) with
            | StepTaken request =>
                inl left = argument 3i32
                inl right = argument 4i32
                inl key = request.key
                inl cols = request.cols
                inl latest = request.latest
                inl limit = request.limit
                $'eoie_table_diff::eoie_table_diff_run(&*!left, &*!right, &*!key, &*!cols, &*!latest, !limit)' : i32
            | StepRejected reason => rejected reason
    | TableUnknown => rejected (table_usage ())

let rec kept_mask (list : filters) (cells : table_cells) (row : i32) (total : i32) (~acc : string) : string =
    if row > total then acc
    else kept_mask list cells (row + 1i32) total (rust_std_string.model.concat5 acc (if row_passes list cells row then "1" else "0") "" "" "")

let rows_kept (~path : string) (~wheres : string) : bool * string =
    match table_read path with
    | TableUnreadable problem => false, problem
    | TableLoaded cells =>
        inl list, missing = filters_from cells wheres
        if missing <> "" then false, missing
        else true, kept_mask list cells 1i32 (row_total cells) "-"
inl main () : i32 =
    !!!!Export("eoie_table_run", ((fun () => table_run ()) : () -> i32))
    !!!!Export("eoie_table_rows_kept", ((fun (path, wheres) => rows_kept path wheres) : string * string -> bool * string))
    0i32
