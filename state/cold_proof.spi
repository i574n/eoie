union cold_receipt_schema =
    | ColdReceiptV3 :: cold_receipt_schema
    | ColdReceiptV4 :: cold_receipt_schema

union cold_receipt_status =
    | ColdReceiptClosed :: cold_receipt_status
    | ColdReceiptSuperseded :: cold_receipt_status
    | ColdReceiptPending :: cold_receipt_status

union cold_receipt =
    | ColdReceipt :: cold_receipt_schema * cold_receipt_status * u32 * u32 * u32 * u32 * u32 * u32 * bool * bool * bool * bool * string -> cold_receipt

inl last_historical_cold_receipt () : cold_receipt =
    ColdReceipt (
        ColdReceiptV3,
        ColdReceiptSuperseded,
        183u32,
        1445u32,
        67u32,
        998u32,
        115u32,
        100u32,
        true,
        true,
        true,
        true,
        "historical-v3-receipt-preserved-only-as-evidence;its-owner-crate-and-compiler-counts-are-not-current-authority"
    )

inl current_cold_schema () : cold_receipt_schema = ColdReceiptV4
inl current_cold_proof_status () : cold_receipt_status = ColdReceiptClosed
