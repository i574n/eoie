open core

union rust_tool_role =
    | RustCompiler
    | RustPackageManager
    | RustDocumentationCompiler
    | RustFormatter

union rust_tool_identity =
    | RustToolIdentity :: rust_tool_role * evidence_ref -> rust_tool_identity

inl rustc_identity () : rust_tool_identity =
    RustToolIdentity (RustCompiler, EvidenceRef ("rustc.exe", "89d7dc62f1ee51f527159d2456d7f667da37dfd0e4f35ac44ac34cb9e7e7fecb", 109568u64, BinaryMedia, ExternalRequired))

inl cargo_identity () : rust_tool_identity =
    RustToolIdentity (RustPackageManager, EvidenceRef ("cargo.exe", "39b23e87ead17f636f7762011a59047fcb5bb02582d5a84e5e589f5bf5b808c0", 27679744u64, BinaryMedia, ExternalRequired))

inl rustdoc_identity () : rust_tool_identity =
    RustToolIdentity (RustDocumentationCompiler, EvidenceRef ("rustdoc.exe", "45ad5035752a100ef82c731038bc7f7501e3821382f3daa24ee45f79db5c2221", 11525120u64, BinaryMedia, ExternalRequired))

inl rustfmt_identity () : rust_tool_identity =
    RustToolIdentity (RustFormatter, EvidenceRef ("rustfmt.exe", "e66e154c8dd9d73ea093b8a5634bcd7cf123d2a3f1c59cf54e1aa14575b73684", 5534208u64, BinaryMedia, ExternalRequired))

union spiral_compiler_role =
    | SpiralCompilerEntrypoint
    | SpiralCompilerFacade

union spiral_compiler_identity =
    | SpiralCompilerIdentity :: spiral_compiler_role * evidence_ref -> spiral_compiler_identity

inl spiral_entry_identity () : spiral_compiler_identity =
    SpiralCompilerIdentity (SpiralCompilerEntrypoint, EvidenceRef ("SpiralCompiler.dll", "1acbf6fa4390e6d3c894403f72d8c2b90ffefe95230553b7819cc026a3507675", 282624u64, BinaryMedia, ExternalRequired))

inl spiral_facade_identity () : spiral_compiler_identity =
    SpiralCompilerIdentity (SpiralCompilerFacade, EvidenceRef ("dotnet.exe", "6682d18e2d6dd860f20bc762ad8deed58487e7522a05fa61281b1f3dad8f5c9d", 146216u64, BinaryMedia, ExternalRequired))

inl main () : i32 = 0i32
